# Keep the temporary Cloudflare Pages URL out of the index.
# Same content on two hosts is duplicate content and costs rankings.
# Verify after every deploy:
#   curl -I https://<project>.pages.dev   -> MUST show x-robots-tag
#   curl -I https://<realdomain>.com      -> MUST NOT show it
https://:project.pages.dev/*
  X-Robots-Tag: noindex, nofollow

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# Astro emits hashed filenames into /_astro/, not /assets/ - this rule said
# /assets/*, which matches nothing this site serves, so the CSS, JS and images
# were shipping with no immutable header at all. The hash in the filename is
# what makes a year-long cache safe: change a file and its URL changes.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
