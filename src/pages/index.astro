          {FAQS.map((f) => (
            <details class="group">
              <summary
                class="flex cursor-pointer items-start justify-between gap-4 py-4 font-medium text-text
                       transition-colors duration-150 hover:text-accent select-none"
              >
                <span class="text-sm sm:text-base">{f.q}</span>
                <svg
                  width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                  stroke-width="2" stroke-linecap="round"
                  class="mt-1 shrink-0 text-text-faint transition-transform duration-200
                         group-open:rotate-45"
                  aria-hidden="true"
                >
                  <path d="M12 5v14M5 12h14" />
                </svg>
              </summary>
              <p class="max-w-[68ch] pb-5 pt-1 text-sm text-text-muted leading-relaxed">{f.a}</p>
            </details>
          ))}
        </div>
      </section>

    </div>
  </div>
