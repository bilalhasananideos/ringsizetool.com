---
import Layout from '../layouts/Layout.astro';
import RingSizer from '../components/RingSizer.astro';
import HeroIllustration from '../components/HeroIllustration.astro';
import { NOINDEX_SITE, SITE_NAME, SITE_URL } from '../config';
import { CHART_ROWS, AVERAGE_US_SIZE, diameterFromUs, fromDiameter } from '../data/ringSizes';
import { FAQS, faqPageSchema, howToSchema, webAppSchema, breadcrumbSchema } from '../data/faq';

/* The chart below is generated, never typed. Half-size steps from US 3 to 13 —
   the range actually sold. Quarter steps live on /ring-size-chart when it ships. */
const chart = CHART_ROWS.filter(
  (r) => r.usNumeric !== null && r.usNumeric % 0.5 === 0 && r.usNumeric <= 13,
);

/* Used in prose so the numbers can never drift from the conversion engine. */
const six = fromDiameter(diameterFromUs(6));
const smallest = fromDiameter(diameterFromUs(3));
const largest = fromDiameter(diameterFromUs(13));

const inRange = (r: typeof six) => r.circumferenceIn.toFixed(1);

/* Structured data. Built from the same modules the page renders from, so the
   visible answer and the schema answer can never disagree. */
const jsonLd = [
  webAppSchema(SITE_URL, SITE_NAME),
  howToSchema(SITE_URL),
  faqPageSchema(),
  breadcrumbSchema([{ name: 'Ring Sizer', url: SITE_URL }]),
];
---
<Layout
  title="Ring Sizer — Measure Your Ring Size on Screen | Ring Size Tool"
  description="Free ring sizer. Measure your ring size at home with a bank card and your screen — no printer, no ring sizer needed. US, UK, EU, Japan and India sizes instantly."
  noindex={NOINDEX_SITE}
  jsonLd={jsonLd}
>
  <div class="w-full">
    <!-- ── Top Announcement Banner ──────────────────────────────────────── -->
    <div class="w-full bg-gradient-to-r from-[#241A00] via-[#3A2E05] to-[#241A00] border-b border-[#D4AF37]/30 py-2.5 px-4 text-center">
      <p class="text-xs sm:text-sm font-medium text-[#F7E7A9] flex items-center justify-center gap-2">
        <span class="text-[#D4AF37]">✨</span>
        <span><strong>100% Free & Private:</strong> Measure instantly on screen in MM, CM, and Inches — No download needed.</span>
      </p>
    </div>

    <!-- ── Top Hero Banner Section (Matching Reference) ────────────────── -->
    <section class="relative overflow-hidden bg-gradient-to-b from-[#181613] via-[#141311] to-bg py-16 sm:py-20 border-b border-border/60">
      <div class="mx-auto w-full max-w-6xl px-6">
        <div class="grid items-center gap-10 md:grid-cols-[1.1fr_0.9fr] md:gap-12">
          <div>
            <div class="inline-flex items-center gap-2 rounded-full border border-[#D4AF37]/30 bg-[#241A00]/80 px-3.5 py-1 text-xs font-semibold uppercase tracking-wider text-[#D4AF37] mb-4">
              <span>★</span> Accuracy Guaranteed
            </div>
            <h1 class="text-[clamp(2.25rem,5vw,3.75rem)] font-bold tracking-tight text-white leading-[1.12]">
              FIND YOUR RING SIZE WITH OUR <span class="bg-gradient-to-r from-[#E9C349] via-[#F7E7A9] to-[#D4AF37] bg-clip-text text-transparent">RING SIZE CALCULATOR</span>
            </h1>

            <p class="mt-5 text-base sm:text-lg leading-relaxed text-neutral-300 max-w-[48ch]">
              Experience precision measurement with calibrated accuracy. Convert seamlessly between US, UK, EU, Japan, India, MM, CM, and Inches.
            </p>

            <div class="mt-8 flex flex-wrap items-center gap-4">
              <a
                href="#tool-heading"
                class="inline-flex h-13 items-center gap-2.5 rounded-full bg-gradient-to-r from-[#D4AF37] to-[#B38F24] px-8 text-sm font-bold text-[#1A1608] no-underline transition-all duration-200 hover:brightness-110 hover:shadow-[0_6px_28px_rgba(212,175,55,0.4)]"
              >
                Start Measuring ↓
              </a>
              <a
                href="#chart"
                class="inline-flex h-13 items-center gap-2 rounded-full border border-[#D4AF37]/50 bg-white/5 px-6 text-sm font-semibold text-[#F7E7A9] no-underline transition-all hover:bg-white/10"
              >
                View Size Chart
              </a>
            </div>

            <!-- Proof / Accuracy Note -->
            <p class="mt-8 border-l-2 border-[#D4AF37] py-1 pl-4 text-xs sm:text-sm leading-relaxed text-neutral-400 max-w-[50ch]">
              Computed strictly from ISO 8653:2016, BS EN 28653:1993, and JIS S 4700 standards — not copied from unverified tables. <a href="#disagree" class="text-[#E9C349] font-medium underline underline-offset-2">See arithmetic</a>.
            </p>
          </div>

          <div class="flex justify-center md:justify-end">
            <div class="overflow-hidden rounded-2xl shadow-2xl border border-[#D4AF37]/30 bg-[#1A1815] p-3">
              <HeroIllustration />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Center Intro & Tool Section ───────────────────────────────────── -->
    <section id="tool-heading" class="mx-auto w-full max-w-6xl px-6 py-12 sm:py-16">
      <!-- Centered Section Intro -->
      <div class="text-center max-w-2xl mx-auto mb-10">
        <p class="section-label">Online Measurement</p>
        <h2 class="text-3xl sm:text-4xl font-display font-semibold text-text">
          Measure Your Ring Size with Our <br class="hidden sm:inline" /><span class="text-accent">Ring Size Calculator</span>
        </h2>
        <p class="mt-3 text-sm sm:text-base leading-relaxed text-text-muted">
          Select MM, CM, or Inches. Place a ring on screen or use the fine-tuned slider for instant conversion across all global sizing standards.
        </p>
      </div>

      <!-- Refined Centered Ring Sizer Card -->
      <div class="max-w-3xl mx-auto">
        <RingSizer />
      </div>
    </section>

    <!-- ── Gold Highlight Features Banner (Matching Reference) ──────────── -->
    <section class="mx-auto w-full max-w-4xl px-6 my-10">
      <div class="rounded-2xl border border-[#D4AF37]/40 bg-gradient-to-br from-[#2A2207] via-[#1E1905] to-[#141208] p-6 sm:p-8 shadow-lg text-white">
        <h3 class="text-center font-display text-xl sm:text-2xl font-bold text-[#F7E7A9] mb-6">
          Why Choose Our Ring Sizing Tool?
        </h3>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4 text-center sm:text-left">
          <div class="border-b sm:border-b-0 sm:border-r border-[#D4AF37]/20 pb-4 sm:pb-0 sm:pr-4">
            <div class="text-2xl mb-1">🔒</div>
            <h4 class="font-semibold text-sm text-[#F7E7A9]">100% Private</h4>
            <p class="text-xs text-neutral-300 mt-1">Runs purely in your browser. Nothing is uploaded or tracked.</p>
          </div>
          <div class="border-b sm:border-b-0 sm:border-r border-[#D4AF37]/20 pb-4 sm:pb-0 sm:pr-4">
            <div class="text-2xl mb-1">📏</div>
            <h4 class="font-semibold text-sm text-[#F7E7A9]">Calibrated Accuracy</h4>
            <p class="text-xs text-neutral-300 mt-1">1:1 Physical bank card scaling ensures exact millimeter precision.</p>
          </div>
          <div class="border-b sm:border-b-0 sm:border-r border-[#D4AF37]/20 pb-4 sm:pb-0 sm:pr-4">
            <div class="text-2xl mb-1">🌍</div>
            <h4 class="font-semibold text-sm text-[#F7E7A9]">7 Global Scales</h4>
            <p class="text-xs text-neutral-300 mt-1">US/CA, UK/AU, EU/ISO, Japan, India, FR/IT/ES, and Brazil.</p>
          </div>
          <div>
            <div class="text-2xl mb-1">📜</div>
            <h4 class="font-semibold text-sm text-[#F7E7A9]">Official Standards</h4>
            <p class="text-xs text-neutral-300 mt-1">Derived from ISO 8653, BS EN 28653, and JIS S 4700.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Main Content Container for below sections ─────────────────────── -->
    <div class="mx-auto w-full max-w-4xl px-6 space-y-24 sm:space-y-32 my-16 sm:my-24">

      <!-- ── Detailed Measurement Methods ───────────────────────────────── -->
      <section id="methods" class="scroll-mt-20" aria-labelledby="methods-heading">
        <div class="text-center max-w-2xl mx-auto mb-12 sm:mb-16">
          <p class="section-label">Step-by-Step Guide</p>
          <h2 id="methods-heading" class="text-3xl sm:text-4xl font-display font-semibold text-text">
            Detailed Measurement Methods
          </h2>
          <p class="mt-3 text-text-muted text-sm sm:text-base leading-relaxed">
            Choose the method that works best for you. For the most accurate results, we recommend trying at least two methods.
          </p>
        </div>

        <div class="space-y-8">
          <!-- Method 1: STRING / PAPER -->
          <div class="card-elevated rounded-2xl border border-border bg-surface p-6 sm:p-8 flex flex-col sm:flex-row sm:items-center gap-6 sm:gap-8">
            <!-- Left Badge Box -->
            <div class="w-full sm:w-52 shrink-0 rounded-xl bg-surface-sunk/60 border border-border/80 p-6 flex flex-col items-center justify-center text-center">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#D4AF37" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mb-3">
                <circle cx="6" cy="6" r="3"></circle>
                <circle cx="6" cy="18" r="3"></circle>
                <line x1="20" y1="4" x2="8.12" y2="15.88"></line>
                <line x1="14.47" y1="14.48" x2="20" y2="20"></line>
                <line x1="8.12" y1="8.12" x2="12" y2="12"></line>
              </svg>
              <span class="text-[10px] font-bold tracking-[0.15em] text-text-faint uppercase">Method 1</span>
              <span class="mt-1 font-display font-bold text-sm sm:text-base tracking-wide text-text uppercase">String / Paper</span>
            </div>

            <!-- Right Content -->
            <div class="flex-1">
              <h3 class="text-xs font-bold uppercase tracking-wider text-[#A37B19] dark:text-[#E9C349]">Materials Needed</h3>
              <p class="mt-1 text-sm text-text-muted">A narrow strip of paper or string, a pen, and a ruler with millimeter markings.</p>

              <h3 class="mt-5 text-xs font-bold uppercase tracking-wider text-[#A37B19] dark:text-[#E9C349]">Steps</h3>
              <ol class="mt-2 list-decimal space-y-1.5 pl-4 text-sm text-text-muted leading-relaxed">
                <li>Cut a piece of non-stretchy string or paper about 10cm long and 5mm wide.</li>
                <li>Wrap it snugly around the base of your intended finger.</li>
                <li>Use a pen to mark the exact point where the ends overlap.</li>
                <li>Unroll and measure the length in millimeters using your ruler.</li>
                <li>Enter this circumference into our calculator above to find your size.</li>
              </ol>
            </div>
          </div>

          <!-- Method 2: EXISTING RING -->
          <div class="card-elevated rounded-2xl border border-border bg-surface p-6 sm:p-8 flex flex-col sm:flex-row sm:items-center gap-6 sm:gap-8">
            <!-- Left Badge Box -->
            <div class="w-full sm:w-52 shrink-0 rounded-xl bg-surface-sunk/60 border border-border/80 p-6 flex flex-col items-center justify-center text-center">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#D4AF37" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mb-3">
                <path d="M6 3h12l4 6-10 12L2 9l4-6z"></path>
                <path d="M11 3 8 9l4 12 4-12-3-6"></path>
                <path d="M2 9h20"></path>
              </svg>
              <span class="text-[10px] font-bold tracking-[0.15em] text-text-faint uppercase">Method 2</span>
              <span class="mt-1 font-display font-bold text-sm sm:text-base tracking-wide text-text uppercase">Existing Ring</span>
            </div>

            <!-- Right Content -->
            <div class="flex-1">
              <h3 class="text-xs font-bold uppercase tracking-wider text-[#A37B19] dark:text-[#E9C349]">Materials Needed</h3>
              <p class="mt-1 text-sm text-text-muted">A ring that currently fits well on the intended finger and a ruler with millimeter markings.</p>

              <h3 class="mt-5 text-xs font-bold uppercase tracking-wider text-[#A37B19] dark:text-[#E9C349]">Steps</h3>
              <ol class="mt-2 list-decimal space-y-1.5 pl-4 text-sm text-text-muted leading-relaxed">
                <li>Select a ring that comfortably fits the specific finger you are measuring for.</li>
                <li>Place the ring flat on a surface.</li>
                <li>Use a ruler to measure the straight distance across the <strong class="text-text font-semibold">inside</strong> edge of the ring (the inner diameter).</li>
                <li>Do not include the metal of the ring itself in your measurement.</li>
                <li>Refer to the diameter column in our Size Chart below to find your match.</li>
              </ol>
            </div>
          </div>

          <!-- Method 3: PRINTABLE CHART -->
          <div class="card-elevated rounded-2xl border border-border bg-surface p-6 sm:p-8 flex flex-col sm:flex-row sm:items-center gap-6 sm:gap-8">
            <!-- Left Badge Box -->
            <div class="w-full sm:w-52 shrink-0 rounded-xl bg-surface-sunk/60 border border-border/80 p-6 flex flex-col items-center justify-center text-center">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#D4AF37" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mb-3">
                <polyline points="6 9 6 2 18 2 18 9"></polyline>
                <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
                <rect x="6" y="14" width="12" height="8"></rect>
              </svg>
              <span class="text-[10px] font-bold tracking-[0.15em] text-text-faint uppercase">Method 3</span>
              <span class="mt-1 font-display font-bold text-sm sm:text-base tracking-wide text-text uppercase">Printable Chart</span>
            </div>

            <!-- Right Content -->
            <div class="flex-1">
              <h3 class="text-xs font-bold uppercase tracking-wider text-[#A37B19] dark:text-[#E9C349]">Materials Needed</h3>
              <p class="mt-1 text-sm text-text-muted">A printer, US Letter or A4 paper, scissors, and an existing ring (optional).</p>

              <h3 class="mt-5 text-xs font-bold uppercase tracking-wider text-[#A37B19] dark:text-[#E9C349]">Steps</h3>
              <ol class="mt-2 list-decimal space-y-1.5 pl-4 text-sm text-text-muted leading-relaxed">
                <li>Download our comprehensive printable sizing guide.</li>
                <li>Ensure printer settings are at 100% scale (no scaling or "fit to page").</li>
                <li>Verify the print scale by measuring the printed reference line with a physical ruler.</li>
                <li>Either cut out the provided paper sizer or place an existing ring over the printed circles to find the perfect match.</li>
              </ol>

              <div class="mt-5">
                <a
                  href="/ring-size-chart"
                  class="inline-flex items-center gap-2 rounded-xl border border-[#D4AF37] bg-surface px-5 py-2.5 text-xs font-semibold text-[#8B6E16] dark:text-[#E9C349] transition-all hover:bg-accent-sunk shadow-xs no-underline"
                >
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                    <polyline points="7 10 12 15 17 10"></polyline>
                    <line x1="12" y1="15" x2="12" y2="3"></line>
                  </svg>
                  Download Printable Chart
                </a>
              </div>
            </div>
          </div>
        </div>

        <div class="mt-12 rounded-xl border border-border/80 bg-surface-sunk/40 p-6 sm:p-8">
          <h3 class="text-base font-semibold text-text">Important Tips & What Not to Do</h3>
          <ul class="mt-3 list-disc space-y-2 pl-6 text-sm text-text-muted leading-relaxed">
            <li><strong class="text-text">Avoid stretchy string or thread:</strong> It tightens under tension and produces a size that is too small.</li>
            <li><strong class="text-text">Do not measure when hands are cold:</strong> Cold shrinks fingers; measure at normal room temperature.</li>
            <li><strong class="text-text">Keep browser zoom at 100%:</strong> If you change zoom after calibrating, recalibrate with your card.</li>
          </ul>
        </div>
      </section>

      <!-- ── Ring Size Chart ─────────────────────────────────────────── -->
      <div class="section-divider"></div>
    <section id="chart" class="scroll-mt-20" aria-labelledby="chart-heading">
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
        <div>
          <p class="section-label">Conversion Table</p>
          <h2 id="chart-heading" class="text-[clamp(1.75rem,3.5vw,2.25rem)]">Complete Ring Size Chart</h2>
          <p class="mt-2 text-sm sm:text-base text-text-muted">
            All regional sizes from US {smallest.us} to US {largest.us} with diameter & circumference in MM, CM, and Inches.
          </p>
        </div>

        <a
          href="/ring-size-chart"
          class="inline-flex shrink-0 items-center gap-2 rounded-xl border border-accent/40 bg-accent-sunk/50 px-4 py-2 text-xs font-semibold text-accent-text hover:bg-accent-sunk transition-all no-underline"
        >
          Quarter-Sizes Chart →
        </a>
      </div>

      <div class="table-scroll mt-6 rounded-2xl border border-border bg-surface shadow-xs">
        <table class="w-full min-w-[52rem] text-left text-sm">
          <caption class="sr-only">
            Ring size conversion chart: US, UK, EU, Japan and India with diameter and circumference in mm, cm and inches
          </caption>
          <thead>
            <tr class="bg-surface-sunk/80 border-b border-border">
              <th scope="col" class="px-4 py-3 font-semibold text-text text-xs uppercase tracking-wider">US / CA</th>
              <th scope="col" class="px-4 py-3 font-semibold text-text text-xs uppercase tracking-wider">UK / AU</th>
              <th scope="col" class="px-4 py-3 font-semibold text-text text-xs uppercase tracking-wider">EU / ISO</th>
              <th scope="col" class="px-4 py-3 font-semibold text-text text-xs uppercase tracking-wider">Japan</th>
              <th scope="col" class="px-4 py-3 font-semibold text-text text-xs uppercase tracking-wider">India</th>
              <th scope="col" class="px-4 py-3 font-semibold text-accent text-xs uppercase tracking-wider">Dia (MM)</th>
              <th scope="col" class="px-4 py-3 font-semibold text-text-muted text-xs uppercase tracking-wider">Dia (CM)</th>
              <th scope="col" class="px-4 py-3 font-semibold text-text-muted text-xs uppercase tracking-wider">Dia (In)</th>
              <th scope="col" class="px-4 py-3 font-semibold text-text-muted text-xs uppercase tracking-wider">Circ (MM)</th>
            </tr>
          </thead>
          <tbody class="tabular divide-y divide-border/60">
            {chart.map((r) => (
              <tr class="transition-colors hover:bg-surface-sunk/40">
                <th scope="row" class="px-4 py-3 font-semibold text-text">{r.us}</th>
                <td class="px-4 py-3 text-text-muted font-medium">{r.uk}</td>
                <td class="px-4 py-3 text-text-muted">{r.eu}</td>
                <td class="px-4 py-3 text-text-muted">{r.jp}</td>
                <td class="px-4 py-3 text-text-muted">{r.in === null ? '—' : r.in}</td>
                <td class="px-4 py-3 font-mono font-medium text-accent">{r.diameterMm.toFixed(2)} mm</td>
                <td class="px-4 py-3 font-mono text-text-muted">{(r.diameterMm / 10).toFixed(2)} cm</td>
                <td class="px-4 py-3 font-mono text-text-muted">{r.diameterIn.toFixed(3)} in</td>
                <td class="px-4 py-3 font-mono text-text-muted">{r.circumferenceMm.toFixed(2)} mm</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <p class="mt-4 text-xs text-text-faint">
        * Computed from ISO 8653:2016, BS EN 28653:1993, and JIS S 4700:2022 standards. 1 Inch = 25.40 mm.
      </p>
    </section>

    <!-- ── The thing only we know ──────────────────────────────────────────
         Queries: "ring size conversion" · "uk to us ring size" · "ring size in mm"
         This is the page's original contribution — the discrepancy we verified. -->
      <!-- ── Deep Dive ───────────────────────────────────────────────── -->
      <div class="section-divider"></div>
      <section class="scroll-mt-20" aria-labelledby="disagree">
      <p class="section-label">Deep dive</p>
      <h2 id="disagree" class="text-[clamp(1.75rem,3.5vw,2.25rem)]">
        Why two ring size charts give you different answers
      </h2>

      <p class="mt-5 max-w-[62ch] text-text-muted">
        Because most of them are copies of copies. We checked the sites currently ranking for this
        search, and they contradict each other — and in one case themselves.
      </p>

      <ul class="mt-6 max-w-[62ch] list-disc space-y-3 pl-6 text-text-muted">
        <li>For a {six.diameterMm.toFixed(2)} mm inner diameter, three ranking sites give three
          different UK sizes: L, L½ and M.</li>
        <li>The page ranking first for <em>ring size calculator</em> reports 16.50 mm as EU 52 on its
          millimetre slider and the same 1.65 cm as EU 51.8 on its centimetre slider.</li>
        <li>Its two on-page charts disagree with each other about US 5 — one says 16.2 mm, the other
          15.7 mm — and the first one skips sizes 6 and 8 altogether.</li>
      </ul>

      <p class="mt-6 max-w-[62ch] text-text-muted">
        So we do not keep a chart. We keep one number — inner diameter in millimetres — and derive
        everything else from it with the published formula. Two of our numbers cannot disagree,
        because there is only ever one number.
      </p>

      <h3 class="mt-10 text-lg">The arithmetic, in full</h3>

      <div class="table-scroll mt-4">
        <table class="w-full min-w-[36rem] text-left text-sm">
          <caption class="sr-only">Conversion rules and their sources</caption>
          <thead>
            <tr class="bg-surface-sunk">
              <th scope="col" class="rounded-l-lg px-3 py-2 font-medium">System</th>
              <th scope="col" class="px-3 py-2 font-medium">Rule</th>
              <th scope="col" class="rounded-r-lg px-3 py-2 font-medium">Source</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-t border-border">
              <th scope="row" class="px-3 py-3 font-medium">US / Canada</th>
              <td class="px-3 py-3 tabular">diameter = 0.8128 n + 11.633 mm</td>
              <td class="px-3 py-3 text-text-muted">de facto — no standards body</td>
            </tr>
            <tr class="border-t border-border">
              <th scope="row" class="px-3 py-3 font-medium">UK / Australia</th>
              <td class="px-3 py-3 tabular">A = 37.5 mm circumference, +1.25 mm a letter</td>
              <td class="px-3 py-3 text-text-muted">BS EN 28653:1993</td>
            </tr>
            <tr class="border-t border-border">
              <th scope="row" class="px-3 py-3 font-medium">EU</th>
              <td class="px-3 py-3 tabular">size = inner circumference in mm</td>
              <td class="px-3 py-3 text-text-muted">ISO 8653:2016</td>
            </tr>
            <tr class="border-t border-border">
              <th scope="row" class="px-3 py-3 font-medium">FR / IT / ES / CH</th>
              <td class="px-3 py-3 tabular">circumference − 40</td>
              <td class="px-3 py-3 text-text-muted">same scale as ISO, renumbered</td>
            </tr>
            <tr class="border-t border-border">
              <th scope="row" class="px-3 py-3 font-medium">Japan</th>
              <td class="px-3 py-3 tabular">size 1 = 13 mm diameter, +⅓ mm a size</td>
              <td class="px-3 py-3 text-text-muted">JIS S 4700:2022</td>
            </tr>
            <tr class="border-t border-border">
              <th scope="row" class="px-3 py-3 font-medium">India</th>
              <td class="px-3 py-3">no formula — lookup table</td>
              <td class="px-3 py-3 text-text-muted">no standard exists</td>
            </tr>
          </tbody>
        </table>
      </div>

      <p class="mt-6 max-w-[62ch] text-text-muted">
        You will often see the US rule written as
        <span class="tabular">circumference = 2.55 n + 36.5 mm</span>. That is the same rule, rounded:
        multiply the diameter formula by π and you get 2.5535 n + 36.549. We use the unrounded form,
        which is why our millimetres carry two decimals rather than one.
      </p>

      <h3 class="mt-10 text-lg">Why our UK letter may differ from your jeweller&rsquo;s</h3>
      <p class="mt-4 max-w-[62ch] text-text-muted">
        Ask four ring size sites what US 6 is in UK letters and you get three answers:
        <span class="tabular">L</span>, <span class="tabular">L½</span> and <span class="tabular">M</span>.
        We checked. Ours is <span class="tabular">L½</span>, taken straight from BS EN 28653:1993 —
        size A is 37.5 mm of inner circumference and every letter adds 1.25 mm.
      </p>
      <p class="mt-4 max-w-[62ch] text-text-muted">
        The disagreement is not arithmetic. Those charts are internally consistent too: one US
        quarter-size is 0.638 mm of circumference and one UK half-letter is 0.625 mm, so the two
        scales genuinely track each other. The gap comes from the <em>letter sequence</em>. British
        scales do not all include the same half sizes — the chart we compared omits I½ — and one
        missing half-step shifts everything above it by half a letter.
      </p>
      <p class="mt-4 max-w-[62ch] text-text-muted">
        We could have quietly shifted our formula to match the most common chart. We have not,
        because that would mean replacing a standard with somebody&rsquo;s copy of a copy. Instead
        we give you the letter the standard produces and tell you it can vary. If your jeweller
        works from a different chart, hand them the circumference in millimetres — that number
        means the same thing on every chart in the world.
      </p>

      <h3 class="mt-10 text-lg">India, France, Italy, Spain and Brazil are one scale</h3>
      <p class="mt-4 max-w-[62ch] text-text-muted">
        This is the part no other ring size page seems to say out loud. France, Italy, Spain,
        Switzerland and Brazil all number rings the same way: take the inner circumference in
        millimetres and subtract 40. Brazil&rsquo;s standard, ABNT NBR 16058, is aligned to
        ISO&nbsp;8653 and gives the same answer — the Brazilian trade rule is literally &ldquo;add 40
        to the size to get the perimeter&rdquo;. So a French size 12, an Italian 12 and a Brazilian
        aro 12 are the same physical ring. Our table shows them in separate columns because that is
        what people search for, but the number will always match.
      </p>

      <h3 class="mt-10 text-lg">Where we are genuinely unsure: India</h3>
      <p class="mt-4 max-w-[62ch] text-text-muted">
        India has no sizing standard — there is no BIS specification for ring sizes, so there is
        nothing to be wrong about. What we did instead of copying somebody&rsquo;s chart was compare
        the published tables of four Indian jewellers: Jewelove, RishiRich Jewels, Gems Mart
        Jewellers and Sukkhi. All four turn out to use the same &ldquo;circumference minus 40&rdquo;
        rule as France and Brazil, and they agree on every row they publish — Sukkhi&rsquo;s table
        runs from size 1 to 37 and fits the rule exactly. That is what we compute.
      </p>
      <p class="mt-4 max-w-[62ch] text-text-muted">
        The catch is Tanishq, the largest jeweller in India, whose published chart runs roughly one
        size smaller than that convention. We could not confirm the offset across their full range,
        because Tanishq blocks requests from Pakistan, where this site is built — so we are telling
        you what we know rather than papering over it. Every competitor we audited prints one Indian
        number as though it were settled. We print ours next to the diameter in millimetres, and
        that millimetre figure is the one to give your jeweller. It is the only unambiguous answer.
      </p>
    </section>

      <!-- ── Edge cases ────────────────────────────────────────────────── -->
      <div class="section-divider"></div>
      <section class="scroll-mt-20" aria-labelledby="cases">
        <p class="section-label">Edge cases</p>
        <h2 id="cases" class="text-[clamp(1.75rem,3.5vw,2.25rem)]">Cases the number alone won't cover</h2>

      <h3 class="mt-8 text-lg">Your knuckle is wider than the base of your finger</h3>
      <p class="mt-4 max-w-[62ch] text-text-muted">
        Measure both, and take the size that clears the knuckle. A ring that fits the base perfectly
        but will not pass the knuckle is not wearable; a ring that clears the knuckle and sits a
        little loose is. If the gap between the two is more than about a full size, a jeweller can
        fit sizing beads inside the band — that solves it properly, and no calculator can.
      </p>

      <h3 class="mt-8 text-lg">The band is wide</h3>
      <p class="mt-4 max-w-[62ch] text-text-muted">
        A wide band covers more of the finger and feels tighter at the same diameter. The usual
        advice is to add a quarter to a half size above roughly 6 mm of width.
      </p>
      <p class="mt-4 max-w-[62ch] text-text-muted">
        We will not dress that up as a calculation. There is no formula for it — the correction
        depends on how soft the finger is and how rounded the inside edge of the band is, and no
        standard covers either. Anyone giving you an exact figure for this has invented it. Try the
        half size up if the band is wide and the fit is borderline.
      </p>

      <h3 class="mt-8 text-lg">Fingers change size during the day</h3>
      <p class="mt-4 max-w-[62ch] text-text-muted">
        Warmth, salt, exercise and altitude all swell fingers; cold shrinks them. The swing is real
        enough to cross a half size, which is why a ring can spin in the morning and stick by
        evening. Measure at room temperature, in the middle of the day, and if you get two different
        answers, take the larger.
      </p>

      <h3 class="mt-8 text-lg">You are sizing someone else's finger, secretly</h3>
      <p class="mt-4 max-w-[62ch] text-text-muted">
        Borrow a ring they already wear on the right finger and measure it with method 1 above. The
        finger matters: a ring worn on the right hand is usually a quarter to a half size different
        from the same finger on the left, and non-ring fingers are not comparable at all. If you can
        only get a ring from the wrong finger, buy the ring resizable and size it after.
      </p>

      <h3 class="mt-8 text-lg">Some rings cannot be resized at all</h3>
      <p class="mt-4 max-w-[62ch] text-text-muted">
        Eternity rings set with stones the whole way round, tension settings, and rings in tungsten,
        titanium, ceramic or stainless steel are effectively fixed — there is no plain metal to cut
        and no safe way to work the material. For any of those, and for an engagement ring, confirm
        with a jeweller before you buy. An on-screen measurement is a good estimate; it is not a
        fitting.
      </p>
    </section>

