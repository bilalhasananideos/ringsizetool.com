---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="Template — Micro Tool Factory"
  description="Starter template. Replace this with the real page."
  noindex={true}
>
  <div class="mx-auto w-full max-w-5xl px-5 py-16">
    <h1 class="text-[clamp(2.25rem,5vw,3.25rem)]">Template</h1>
    <p class="mt-5 max-w-[68ch] text-text-muted">
      This is the starter. Copy this folder to <code class="font-mono text-sm">sites/&lt;domain&gt;</code>,
      then read <code class="font-mono text-sm">CLAUDE.md</code> and <code class="font-mono text-sm">DESIGN.md</code> before building anything.
    </p>

    <div class="mt-10 rounded-xl border border-border bg-surface p-6">
      <h2 class="text-2xl">Token check</h2>
      <p class="mt-3 text-sm text-text-muted">
        Toggle the theme in the header. Everything below must stay readable in both.
      </p>
      <div class="mt-5 flex flex-wrap items-center gap-3">
        <button class="h-11 rounded-lg bg-accent px-5 text-surface transition-colors duration-150 hover:bg-accent-hover">
          Primary
        </button>
        <button class="h-11 rounded-lg border border-border-strong px-5 text-text transition-colors duration-150 hover:border-accent">
          Secondary
        </button>
        <span data-readout class="rounded-lg bg-surface-sunk px-3 py-2 text-sm">16.50 mm</span>
      </div>
    </div>
  </div>
</Layout>
