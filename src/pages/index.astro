---
import Layout from '../layouts/Layout.astro';
import RingSizer from '../components/RingSizer.astro';
import { SITE_NAME, NOINDEX_SITE } from '../config';
---
<Layout
  title="Ring Sizer — Measure Your Ring Size on Screen | Ring Size Tool"
  description="Free ring sizer. Measure your ring size at home with a bank card and your screen — no printer, no ring sizer needed. US, UK, EU, Japan and India sizes instantly."
  noindex={NOINDEX_SITE}
>
  <div class="mx-auto w-full max-w-3xl px-5 py-12 sm:py-16">
    <h1 class="text-[clamp(2.25rem,5vw,3.25rem)]">
      Find your ring size without a ring sizer
    </h1>
    <p class="mt-5 max-w-[62ch] text-lg text-text-muted">
      Hold a bank card against your screen to calibrate, then measure a ring you already own — or
      your finger with a strip of paper. No printer, no plastic sizer, nothing to install.
    </p>

    <div class="mt-10">
      <RingSizer />
    </div>
  </div>
</Layout>
