---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Something went wrong (500)" description="An unexpected error occurred." noindex={true}>
  <div class="mx-auto w-full max-w-[68ch] px-5 py-24 text-center">
    <p class="font-mono text-sm text-text-faint">500</p>
    <h1 class="mt-3 text-[clamp(2rem,4vw,2.75rem)]">Something went wrong</h1>
    <p class="mt-5 text-text-muted">This is our fault, not yours. Try again in a moment.</p>
    <a href="/" class="mt-8 inline-flex h-11 items-center rounded-lg bg-accent px-5 text-surface no-underline transition-colors duration-150 hover:bg-accent-hover">
      Go to the tool
    </a>
  </div>
</Layout>
