---
import Layout from '../layouts/Layout.astro';
import Prose from '../components/Prose.astro';
import { SITE_NAME, EMAIL, NOINDEX_SITE } from '../config';
---
<Layout title={`Contact — ${SITE_NAME}`} description={`Contact ${SITE_NAME} with a ring sizing question, or a correction if a number looks wrong. Every report is checked against the published standards.`} noindex={NOINDEX_SITE}>
  <Prose title="Contact">
    <p>Email <a href={`mailto:${EMAIL}`}>{EMAIL}</a>. Replies usually within a few days.</p>
    <h2>Found something wrong?</h2>
    <p>
      Accuracy matters here more than anything else. If a number looks wrong, tell us what you
      measured and what the tool returned, and we will check it.
    </p>
  </Prose>
</Layout>
