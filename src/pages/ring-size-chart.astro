---
/**
 * /ring-size-chart — the complete chart, as real HTML.
 *
 * Why this page exists, precisely: the site ranking #1 for chart intent
 * publishes its comprehensive 9-column chart as a PNG (`ring-size-chart.png`,
 * alt="ring size chart"). Google cannot read a single value in it, screen
 * readers get four words, it cannot reflow on a phone, and nobody can copy a
 * number out of it to send a jeweller. They rank first while their best asset
 * is invisible. This page is the same data as selectable, indexable HTML.
 *
 * MUST NOT duplicate the homepage chart. The homepage carries HALF sizes and
 * five systems. This page carries QUARTER sizes, all seven systems, and both
 * millimetres and inches. Keep that split — two near-identical tables on one
 * site is self-inflicted duplicate content.
 */
import Layout from '../layouts/Layout.astro';
import FaqSection from '../components/FaqSection.astro';
import { NOINDEX_SITE, SITE_URL } from '../config';
import {
  CHART_ROWS, AVERAGE_US_SIZE, fromDiameter, fromCircumference, diameterFromUs,
  DIAMETER_LOOKUP_ROWS, CIRCUMFERENCE_LOOKUP_ROWS, INCH_LOOKUP_ROWS, JP_LOOKUP_ROWS,
  US_BASE_MM, US_STEP_MM, UK_BASE_CIRC_MM, UK_STEP_MM, ISO_MIN, ISO_MAX, JP_MAX, MM_PER_INCH,
} from '../data/ringSizes';
import { modeSpec, toDia } from '../data/ringModes';
import { breadcrumbSchema, CHART_FAQS, faqPageSchema } from '../data/faq';

/* Every row is generated. Never type a size into this file. */
const rows = CHART_ROWS;

/* Women's and men's slices exist because "women's ring size chart" and
   "men's ring size chart" are separate searches. They are cuts of the same
   generated data, not a second set of numbers. */
const womens = rows.filter((r) => r.usNumeric !== null && r.usNumeric >= 3 && r.usNumeric <= 9);
const mens = rows.filter((r) => r.usNumeric !== null && r.usNumeric >= 8 && r.usNumeric <= 14);

const first = rows[0];
const last = rows[rows.length - 1];

/* Decimal places per column, taken from the tool's own precision table rather
   than typed here, so a value read off this chart and typed into the sizer
   names the same size. The inch-circumference column was a hardcoded 3 dp
   while the tool needs 4, and two rows came back a size off when typed in:
   2.494 in gave JP 22 for a JP 23 row, 2.645 in gave X½ for a Y row (QA audit
   #7). verify-sizes.ts walks every row at these same decimal places. */
const dp = {
  diaMm: modeSpec('dia', 'mm').dp,
  diaCm: modeSpec('dia', 'cm').dp,
  diaIn: modeSpec('dia', 'in').dp,
  circMm: modeSpec('circ', 'mm').dp,
  circIn: modeSpec('circ', 'in').dp,
};

/* Rows whose PRINTED diameter reads back as a different size, found rather
   than listed. One is known — US 6¼, whose circumference sits 0.006 mm above
   the EU 52/53 line, so its diameter rounded to 16.71 mm falls just below it —
   but computing the set means the note can never go stale (QA audit #8). The
   circumference column has no such row, which is why the note points there. */
const SYSTEMS = [['us', 'US'], ['uk', 'UK'], ['eu', 'EU'], ['jp', 'Japan'], ['in', 'India']] as const;
const knifeEdges = rows.flatMap((r) => {
  const typed = parseFloat(r.diameterMm.toFixed(dp.diaMm));
  const back = fromDiameter(toDia(typed, 'dia', 'mm'));
  const differs = SYSTEMS.filter(([k]) => back[k] !== r[k]);
  return differs.length ? [{ r, typed, back, differs }] : [];
});

const jsonLd = [
  faqPageSchema(CHART_FAQS),
  breadcrumbSchema([
    { name: 'Ring Sizer', url: SITE_URL },
    { name: 'Ring Size Chart', url: `${SITE_URL}/ring-size-chart` },
  ]),
];

/* First-column formatting for the lookup tables: "17 mm", "17.5 mm", "2.3 in".
   A trailing ".0" is how no one writes a ruler reading. */
const plain = (n: number) => (Number.isInteger(n) ? String(n) : n.toFixed(1));

/* Worked examples for the per-country sections. Every figure in that prose is
   one of these rows, computed by the data module — none is typed. */
const us7 = fromDiameter(diameterFromUs(7));
const us0Mm = US_BASE_MM;
const usQuarterMm = US_STEP_MM / 4;
const dia18 = fromDiameter(18);
const dia18RawUs = (18 - US_BASE_MM) / US_STEP_MM;
const ukStepsT = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.indexOf('T');
const ukT = fromCircumference(UK_BASE_CIRC_MM + ukStepsT * UK_STEP_MM);
const ukM = fromCircumference(UK_BASE_CIRC_MM + 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.indexOf('M') * UK_STEP_MM);
const eu54 = fromCircumference(54);
const eu54Rows = rows.filter((r) => r.eu === 54).map((r) => `US ${r.us}`);
const in14 = fromCircumference(14 + 40);
const aro19 = fromCircumference(19 + 40);
const jpAt = (mm: number) => fromDiameter(mm).jp;
const jpFirst = JP_LOOKUP_ROWS[0];
const jpLast = JP_LOOKUP_ROWS[JP_LOOKUP_ROWS.length - 1];

const SECTIONS = [
  { href: '#full', label: 'Every size' },
  { href: '#womens', label: 'Women’s' },
  { href: '#mens', label: 'Men’s' },
  { href: '#units', label: 'mm, cm & inches' },
  { href: '#measurement', label: 'From a measurement' },
  { href: '#systems', label: 'By country' },
  { href: '#sources', label: 'Where the numbers come from' },
];
---
<Layout
  title="Ring Size Chart Online — MM, CM & Inches | Ring Size Tool"
  description="Ring size chart for US, UK, EU/ISO, Japan, India, France and Brazil in quarter sizes — diameter and circumference in mm, cm and inches. Computed, not copied."
  noindex={NOINDEX_SITE}
  jsonLd={jsonLd}
>
  <div class="mx-auto w-full max-w-4xl px-4 py-8 sm:px-6 sm:py-12">

    <nav aria-label="Breadcrumb" class="text-sm text-text-faint">
      <a href="/" class="text-accent-text underline underline-offset-2">Ring Sizer</a>
      <span aria-hidden="true"> · </span>Ring Size Chart
    </nav>

    <header class="mt-6">
      <h1 class="max-w-[20ch] text-[clamp(2.25rem,5.5vw,3.5rem)]">
        Ring size <span class="text-accent-text">chart</span>
      </h1>

      <p class="mt-5 max-w-[60ch] text-lg text-text-muted">
        Every quarter size from US {first.us} to US {last.us}, in all seven systems, with inner
        diameter and circumference in millimetres and inches.
      </p>

      <p class="mt-6 border-l-2 border-accent py-1 pl-4 text-sm text-text-muted">
        Every value is computed from the published standard — nothing is copied from another chart,
        and nothing is behind a download. The site currently ranking first for this search publishes
        its chart as an <strong class="text-text">image</strong>, so none of it can be read, copied
        or searched.
      </p>

      <p class="mt-6 text-sm text-text-faint">
        Don’t know your size yet? The{' '}
        <a href="/" class="text-accent-text underline underline-offset-2">ring sizer</a>
        {' '}measures it against your screen in about a minute, or read the{' '}
        <a href="/how-to-measure-ring-size-at-home" class="text-accent-text underline underline-offset-2">step-by-step guide</a>
        {' '}first. No screen to hand?{' '}
        <a href="/printable-ring-sizer" class="text-accent-text underline underline-offset-2">Print a paper ring sizer</a> instead.
      </p>
    </header>

    <nav aria-label="On this page" class="mt-8 flex flex-wrap gap-2">
      {SECTIONS.map((s) => (
        <a
          href={s.href}
          class="rounded-lg border border-border px-3 py-2 text-sm text-text-muted no-underline
                 transition-colors duration-150 hover:border-accent hover:text-text"
        >{s.label}</a>
      ))}
    </nav>

    <!-- ── The full chart ──────────────────────────────────────────────────
         Query: "ring size chart", "ring sizer chart", "ring size conversion
         chart". Quarter steps and all seven systems — the homepage carries
         half steps and five, deliberately. -->
    <section class="mt-14" aria-labelledby="full">
      <h2 id="full" class="text-[clamp(1.75rem,3.5vw,2.25rem)]">Every size, every system</h2>

      <p class="mt-5 max-w-[62ch] text-text-muted">
        US sizes are sold in quarters, so the chart is built in quarters. India, Italy, Spain,
        Switzerland and Brazil share one scale — inner circumference in millimetres minus 40 —
        which is why those columns agree. France is not on it: a French <em>taille</em> is the
        ISO number, so read France from the EU / ISO / FR column.
      </p>

      <div class="table-scroll mt-6">
        <table class="w-full min-w-[58rem] text-left text-sm">
          <caption class="sr-only">
            Ring size conversion chart in quarter sizes: US and Canada, UK and Australia, EU/ISO/France,
            Japan, India, Italy/Spain/Switzerland, Brazil, with inner diameter and circumference in
            millimetres, centimetres and inches.
          </caption>
          <thead>
            <tr class="bg-surface-sunk">
              <th scope="col" class="rounded-l-lg px-3 py-2 font-medium">US / CA</th>
              <th scope="col" class="px-3 py-2 font-medium">UK / AU</th>
              <th scope="col" class="px-3 py-2 font-medium">EU / ISO / FR</th>
              <th scope="col" class="px-3 py-2 font-medium">Japan</th>
              <th scope="col" class="px-3 py-2 font-medium">India</th>
              <th scope="col" class="px-3 py-2 font-medium">IT / ES / CH</th>
              <th scope="col" class="px-3 py-2 font-medium">Brazil</th>
              <th scope="col" class="px-3 py-2 font-medium">Diameter</th>
              <th scope="col" class="px-3 py-2 font-medium">Ø cm</th>
              <th scope="col" class="px-3 py-2 font-medium">Ø inches</th>
              <th scope="col" class="px-3 py-2 font-medium">Circumference</th>
              <th scope="col" class="rounded-r-lg px-3 py-2 font-medium">Circ. inches</th>
            </tr>
          </thead>
          <tbody class="tabular">
            {rows.map((r) => (
              <tr class="border-t border-border">
                <th scope="row" class="px-3 py-2.5 font-medium text-text">{r.us}</th>
                <td class="px-3 py-2.5">{r.uk ?? '—'}</td>
                <td class="px-3 py-2.5">{r.eu ?? '—'}</td>
                <td class="px-3 py-2.5">{r.jp ?? '—'}</td>
                <td class="px-3 py-2.5">{r.in ?? '—'}</td>
                <td class="px-3 py-2.5">{r.it ?? '—'}</td>
                <td class="px-3 py-2.5">{r.br ?? '—'}</td>
                <td class="px-3 py-2.5">{r.diameterMm.toFixed(dp.diaMm)} mm</td>
                {/* 3 dp. Two would be 0.1 mm of resolution, and a UK half size
                    is 0.199 mm of diameter, so a 2 dp centimetre column cannot
                    distinguish the very sizes the row beside it names. */}
                <td class="px-3 py-2.5">{(r.diameterMm / 10).toFixed(dp.diaCm)} cm</td>
                <td class="px-3 py-2.5">{r.diameterIn.toFixed(dp.diaIn)}</td>
                <td class="px-3 py-2.5">{r.circumferenceMm.toFixed(dp.circMm)} mm</td>
                <td class="px-3 py-2.5">{r.circumferenceIn.toFixed(dp.circIn)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <p class="mt-5 max-w-[62ch] text-sm text-text-faint">
        UK sizes run as long stretches of half letters. That is correct, not a bug: a US quarter
        step is 0.64&nbsp;mm of circumference and a UK half letter is 0.625&nbsp;mm, so the two
        scales drift against each other and never line up.{' '}
        <a href="/#disagree" class="text-accent-text underline underline-offset-2">Why charts disagree</a>
      </p>

      {knifeEdges.map(({ r, typed, back, differs }) => (
        <p class="mt-3 max-w-[62ch] text-sm text-text-faint">
          {`US ${r.us} is the one row to read by circumference. Its exact size sits a hair over a boundary, so its diameter rounded to ${typed.toFixed(dp.diaMm)} mm, typed into the sizer, reads ${differs.map(([k, label]) => `${label} ${back[k]}`).join(' and ')} rather than ${differs.map(([k, label]) => `${label} ${r[k]}`).join(' and ')}. Both are right for the figure typed; give a jeweller the circumference, ${r.circumferenceMm.toFixed(dp.circMm)} mm, which reads back exactly.`}
        </p>
      ))}
    </section>

    <!-- ── Women's ─────────────────────────────────────────────────────────
         Query: "women's ring size chart", "average ring size for women". -->
    <section class="mt-16" aria-labelledby="womens">
      <h2 id="womens" class="text-[clamp(1.75rem,3.5vw,2.25rem)]">Women’s ring size chart</h2>

      <p class="mt-5 max-w-[62ch] text-text-muted">
        The range jewellers actually stock for women, US 3 to 9. The commonest is
        US&nbsp;{AVERAGE_US_SIZE.women}. There is no census of finger sizes — these figures describe
        what sells, so treat them as a sanity check, not a verdict.{' '}
        <a href="/average-ring-size" class="text-accent-text underline underline-offset-2">What the averages actually mean</a>.
      </p>

      <div class="table-scroll mt-6">
        <table class="w-full min-w-[38rem] text-left text-sm">
          <caption class="sr-only">Women’s ring sizes, US 3 to 9, in every system</caption>
          <thead>
            <tr class="bg-surface-sunk">
              <th scope="col" class="rounded-l-lg px-3 py-2 font-medium">US / CA</th>
              <th scope="col" class="px-3 py-2 font-medium">UK / AU</th>
              <th scope="col" class="px-3 py-2 font-medium">EU / ISO</th>
              <th scope="col" class="px-3 py-2 font-medium">Japan</th>
              <th scope="col" class="px-3 py-2 font-medium">India</th>
              <th scope="col" class="rounded-r-lg px-3 py-2 font-medium">Diameter</th>
            </tr>
          </thead>
          <tbody class="tabular">
            {womens.map((r) => (
              <tr class={`border-t border-border${r.usNumeric === AVERAGE_US_SIZE.women ? ' bg-accent-sunk' : ''}`}>
                <th scope="row" class="px-3 py-2.5 font-medium text-text">
                  {r.us}{r.usNumeric === AVERAGE_US_SIZE.women && (
                    <span class="ml-2 text-xs font-normal text-accent-text">most common</span>
                  )}
                </th>
                <td class="px-3 py-2.5">{r.uk ?? '—'}</td>
                <td class="px-3 py-2.5">{r.eu ?? '—'}</td>
                <td class="px-3 py-2.5">{r.jp ?? '—'}</td>
                <td class="px-3 py-2.5">{r.in ?? '—'}</td>
                <td class="px-3 py-2.5">{r.diameterMm.toFixed(2)} mm</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- ── Men's ───────────────────────────────────────────────────────────
         Query: "men's ring size chart", "average ring size for men". -->
    <section class="mt-16" aria-labelledby="mens">
      <h2 id="mens" class="text-[clamp(1.75rem,3.5vw,2.25rem)]">Men’s ring size chart</h2>

      <p class="mt-5 max-w-[62ch] text-text-muted">
        US 8 to 14, with US&nbsp;{AVERAGE_US_SIZE.men} the commonest. The same caveat applies: this
        is what jewellers sell, not a measurement of the population.
      </p>

      <div class="table-scroll mt-6">
        <table class="w-full min-w-[38rem] text-left text-sm">
          <caption class="sr-only">Men’s ring sizes, US 8 to 14, in every system</caption>
          <thead>
            <tr class="bg-surface-sunk">
              <th scope="col" class="rounded-l-lg px-3 py-2 font-medium">US / CA</th>
              <th scope="col" class="px-3 py-2 font-medium">UK / AU</th>
              <th scope="col" class="px-3 py-2 font-medium">EU / ISO</th>
              <th scope="col" class="px-3 py-2 font-medium">Japan</th>
              <th scope="col" class="px-3 py-2 font-medium">India</th>
              <th scope="col" class="rounded-r-lg px-3 py-2 font-medium">Diameter</th>
            </tr>
          </thead>
          <tbody class="tabular">
            {mens.map((r) => (
              <tr class={`border-t border-border${r.usNumeric === AVERAGE_US_SIZE.men ? ' bg-accent-sunk' : ''}`}>
                <th scope="row" class="px-3 py-2.5 font-medium text-text">
                  {r.us}{r.usNumeric === AVERAGE_US_SIZE.men && (
                    <span class="ml-2 text-xs font-normal text-accent-text">most common</span>
                  )}
                </th>
                <td class="px-3 py-2.5">{r.uk ?? '—'}</td>
                <td class="px-3 py-2.5">{r.eu ?? '—'}</td>
                <td class="px-3 py-2.5">{r.jp ?? '—'}</td>
                <td class="px-3 py-2.5">{r.in ?? '—'}</td>
                <td class="px-3 py-2.5">{r.diameterMm.toFixed(2)} mm</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- ── Units ───────────────────────────────────────────────────────────
         Query: "ring size chart in mm", "ring size in cm", "ring size in
         inches". The #1 has a section on exactly this. -->
    <section class="mt-16" aria-labelledby="units">
      <h2 id="units" class="text-[clamp(1.75rem,3.5vw,2.25rem)]">Millimetres, centimetres and inches</h2>

      <p class="mt-5 max-w-[62ch] text-text-muted">
        These are the same measurement written three ways, so no conversion table is needed —
        divide millimetres by 10 for centimetres, or by 25.4 for inches. What matters far more is <strong class="text-text"> which</strong> measurement you have.
      </p>

      {/* Drawn, not described: "diameter or circumference?" is spatial, and the
          one mistake this section exists to prevent. Inline so it follows the
          theme tokens in light and dark; role="img" with a title and desc so a
          screen reader gets the same picture. */}
      <figure class="mt-8">
        <svg
          viewBox="0 0 380 220"
          class="h-auto w-full max-w-md"
          role="img"
          aria-labelledby="ring-dims-title ring-dims-desc"
        >
          <title id="ring-dims-title">Inner diameter and inner circumference of a ring</title>
          <desc id="ring-dims-desc">
            A ring seen from above. The inner diameter is the straight line across the inside, edge
            to edge. The inner circumference is the distance round the inside edge, pi times the
            diameter. The metal band itself is not part of either measurement.
          </desc>
          <circle cx="110" cy="110" r="80" fill="none" class="stroke-border-strong" stroke-width="20" />
          <circle cx="110" cy="110" r="70" fill="none" class="stroke-accent-text" stroke-width="3" stroke-dasharray="6 5" />
          <line x1="42" y1="110" x2="178" y2="110" class="stroke-text" stroke-width="2" />
          <line x1="42" y1="102" x2="42" y2="118" class="stroke-text" stroke-width="2" />
          <line x1="178" y1="102" x2="178" y2="118" class="stroke-text" stroke-width="2" />
          <text x="110" y="100" text-anchor="middle" class="fill-text text-sm">Inner diameter</text>
          <line x1="160" y1="60" x2="206" y2="42" class="stroke-text-faint" stroke-width="1" />
          <text x="212" y="40" class="fill-text text-sm">Inner circumference</text>
          <text x="212" y="58" class="fill-text-muted text-sm">= π × diameter</text>
          <line x1="179" y1="150" x2="206" y2="166" class="stroke-text-faint" stroke-width="1" />
          <text x="212" y="168" class="fill-text text-sm">The band itself</text>
          <text x="212" y="186" class="fill-text-muted text-sm">is not measured</text>
        </svg>
      </figure>

      <dl class="mt-6 space-y-5">
        <div class="rounded-xl border border-border bg-surface p-5">
          <dt class="font-medium">Inner diameter</dt>
          <dd class="mt-1 max-w-[62ch] text-text-muted">
            Straight across the inside of the ring, edge to edge. This is the number every size
            system is built from, and the one to give a jeweller. US&nbsp;{AVERAGE_US_SIZE.women} is <span class="tabular"> {rows.find((r) => r.usNumeric === AVERAGE_US_SIZE.women)!.diameterMm.toFixed(2)} mm</span>.
          </dd>
        </div>
        <div class="rounded-xl border border-border bg-surface p-5">
          <dt class="font-medium">Inner circumference</dt>
          <dd class="mt-1 max-w-[62ch] text-text-muted">
            All the way round the inside — what a paper strip round your finger measures. It is
            exactly π&nbsp;× the diameter, which is why EU/ISO sizes <em>are</em> this number.
            US&nbsp;{AVERAGE_US_SIZE.women} is <span class="tabular"> {rows.find((r) => r.usNumeric === AVERAGE_US_SIZE.women)!.circumferenceMm.toFixed(2)} mm</span>.
          </dd>
        </div>
      </dl>

      <p class="mt-6 max-w-[62ch] text-sm text-text-faint">
        Mixing the two up is the commonest sizing mistake there is, and it puts you out by roughly
        three times — a 16&nbsp;mm circumference is a child’s ring; a 16&nbsp;mm diameter is
        about US&nbsp;5½.
      </p>
    </section>

    <!-- ── From a measurement ──────────────────────────────────────────────
         Query family, all in GSC for this page 25 Aug–4 Oct 2026: "17mm ring
         size", "what ring size is 17mm", "18mm diameter ring size", "ring
         size 22mm", "1.8 diameter ring size", "7.5 cm ring size", "5.2 cm
         circumference ring size", "2.3 inches ring size", "ring size 54".
         They sat at positions 18–95 while the two-decimal strings the big
         table happens to contain ranked 1–11: people search the round figure
         their ruler gave them. Three generated tables, one per way of
         measuring — never a page per value (SEO-AUDIT.md §16). -->
    <section class="mt-16" aria-labelledby="measurement">
      <h2 id="measurement" class="text-[clamp(1.75rem,3.5vw,2.25rem)]">Have a measurement, not a size?</h2>

      <p class="mt-5 max-w-[62ch] text-text-muted">
        The chart above runs in US quarter sizes, so its millimetres come out as
        {' '}{rows[16].diameterMm.toFixed(2)} and {rows[17].diameterMm.toFixed(2)} — figures no ruler
        gives you. These tables start from the round number you actually read and give the nearest
        size in every system. Use the one that matches how you measured; the{' '}
        <a href="#units" class="text-accent-text underline underline-offset-2">difference between diameter and circumference</a>
        {' '}is the one thing to get right.
      </p>

      <h3 id="by-diameter" class="mt-10 text-xl font-semibold">Across a ring: inner diameter in millimetres</h3>
      <p class="mt-3 max-w-[62ch] text-text-muted">
        Straight across the inside of a ring that already fits, edge to edge, read to the nearest
        half millimetre.
      </p>

      <div class="table-scroll mt-5">
        <table class="w-full min-w-[46rem] text-left text-sm">
          <caption class="sr-only">
            Ring size from inner diameter, {plain(DIAMETER_LOOKUP_ROWS[0].diameterMm)} to
            {' '}{plain(DIAMETER_LOOKUP_ROWS[DIAMETER_LOOKUP_ROWS.length - 1].diameterMm)} mm in half
            millimetres, with centimetres, inches and the nearest US, UK, EU, Japanese, Indian and
            Italian size.
          </caption>
          <thead>
            <tr class="bg-surface-sunk">
              <th scope="col" class="rounded-l-lg px-3 py-2 font-medium">Diameter</th>
              <th scope="col" class="px-3 py-2 font-medium">cm</th>
              <th scope="col" class="px-3 py-2 font-medium">Inches</th>
              <th scope="col" class="px-3 py-2 font-medium">US / CA</th>
              <th scope="col" class="px-3 py-2 font-medium">UK / AU</th>
              <th scope="col" class="px-3 py-2 font-medium">EU / ISO / FR</th>
              <th scope="col" class="px-3 py-2 font-medium">Japan</th>
              <th scope="col" class="px-3 py-2 font-medium">India</th>
              <th scope="col" class="rounded-r-lg px-3 py-2 font-medium">IT / ES / CH / BR</th>
            </tr>
          </thead>
          <tbody class="tabular">
