---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_NAME, SITE_URL, EMAIL, GA_MEASUREMENT_ID, NOINDEX_SITE } from '../config';
import { CONSENT_STORE_KEY, CONSENT_VERSION, CONSENT_MAX_AGE_MS } from '../data/consent';
import ConsentBanner from '../components/ConsentBanner.astro';

interface Props {
  title: string;
  description: string;
  /** Set true only while the site lives on *.pages.dev with no real domain yet. */
  noindex?: boolean;
  ogImage?: string;
  /** Alt text for the social card. Defaults to the page title. */
  ogImageAlt?: string;
  /** 'article' for the guide pages; the tool and reference pages stay 'website'. */
  ogType?: 'website' | 'article';
  /**
   * True when this page mounts the RingSizer. The header's "Get Started" CTA
   * points at #tool-heading, which only exists on pages that embed the tool —
   * on every other page it was a dead anchor, sending a click to the top of the
   * page. Only index.astro and how-to-measure-ring-size-at-home.astro pass it.
   */
  hasTool?: boolean;
  /** Schema.org objects. Build them from page data, never hand-write the numbers. */
  jsonLd?: Record<string, unknown>[];
}

const {
  title,
  description,
  noindex = false,
  ogImage = '/og.png',
  ogImageAlt,
  ogType = 'website',
  hasTool = false,
  jsonLd = [],
} = Astro.props;

/* og.png is 1200x630. Declaring the dimensions lets Facebook, LinkedIn and
   Slack lay the card out before they have fetched the image; without them the
   first share of a URL often renders as a small square or no image at all. */
const OG_IMAGE_W = '1200';
const OG_IMAGE_H = '630';

/* ── Sitewide entity markup ──────────────────────────────────────────────
 * Two nodes, on every page, describing WHO publishes this and WHAT the site
 * is. Both are things a reader can already verify from the page: the name is
 * in the header, the logo is the mark beside it, the address is the domain
 * they are on, and the email is the one /contact publishes and which
 * genuinely receives mail.
 *
 * ⚠️ WHAT IS DELIBERATELY ABSENT. SEO-AUDIT.md §19 Day 21 asked for
 * "Organization sitewide and Service/WebSite on /, matching ringsize.app's 7
 * types", and matching a competitor's TYPE COUNT is not a reason to publish a
 * type. So:
 *   · No `Service`. The tool is already declared as a `WebApplication` on the
 *     homepage, which is what it is. `Service` describes an offering made by
 *     a provider to a customer; adding it on top would be a second, vaguer
 *     claim about the same free tool purely to raise the count.
 *   · No `sameAs`. It takes social profiles, and this brand has none. Listing
 *     accounts that do not exist is inventing a fact.
 *   · No `address`, `founder`, or `foundingDate` — none of them is verifiable
 *     from the site, and schema must not assert what the page cannot support.
 *   · No `SearchAction` on WebSite. That declares a site search, and there
 *     isn't one. Google ignores it at best; at worst it is a false claim.
 *
 * The @id references are what make these one entity graph rather than two
 * loose blobs repeated per page — WebSite points at the Organization instead
 * of restating it.
 */
const ORG_ID = `${SITE_URL}/#organization`;
const SITE_ID = `${SITE_URL}/#website`;

const SITE_SCHEMA: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': ORG_ID,
    name: SITE_NAME,
    url: `${SITE_URL}/`,
    /* Real file, real dimensions — checked, not guessed. Google wants a logo
       of at least 112px on its shortest side; this is 128 square. */
    logo: {
      '@type': 'ImageObject',
      url: `${SITE_URL}/images/logo-128.webp`,
      width: 128,
      height: 128,
    },
    email: EMAIL,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': SITE_ID,
    name: SITE_NAME,
    url: `${SITE_URL}/`,
    publisher: { '@id': ORG_ID },
    inLanguage: 'en',
  },
];

/**
 * `build.format: 'file'` emits about.html, so Astro.url.pathname is
 * "/about.html" (and "/index.html" for the root) at build time. Left as-is
 * that produces a canonical pointing at a URL nobody visits. Normalise it.
 */
const canonical = new URL(
  Astro.url.pathname.replace(/index\.html$/, '').replace(/\.html$/, ''),
  Astro.site,
).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      /* Two mutually exclusive robots directives. While the site is on a
         temporary URL nothing may be indexed; once it is not, the positive
         directive matters — the defaults truncate snippets and thumbnails,
         and this site's value in a SERP is its numbers and its chart. */
      noindex
        ? <meta name="robots" content="noindex, nofollow" />
        : <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    }

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={OG_IMAGE_W} />
    <meta property="og:image:height" content={OG_IMAGE_H} />
    <meta property="og:image:alt" content={ogImageAlt ?? title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt ?? title} />

    {
      /* Emitted even while the site is noindex, so the schema is testable now
         rather than first exercised on launch day. The robots meta above is
         what actually keeps the page out of the index. */
      [...SITE_SCHEMA, ...jsonLd].map((schema) => (
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
      ))
    }

    {/* Both faces are used above the fold — Playfair for the h1, Inter for body. */}
    <link rel="preload" href="/fonts/playfair-var-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-var-latin.woff2" as="font" type="font/woff2" crossorigin />
    {/* Must match --bg. Kept in sync by setThemeColor() below, because the
        toggle can override the system preference at runtime. */}
    <meta name="theme-color" content="#FBFAF8" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {/* Theme, applied before first paint. Without this the page flashes light then goes dark. */}
    <script is:inline>
      window.setThemeColor = function () {
        var dark =
          document.documentElement.getAttribute('data-theme') === 'dark' ||
          (!document.documentElement.hasAttribute('data-theme') &&
            window.matchMedia('(prefers-color-scheme: dark)').matches);
        var m = document.querySelector('meta[name="theme-color"]');
        if (m) m.setAttribute('content', dark ? '#100F0D' : '#FBFAF8');
      };
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t === 'dark' || t === 'light') {
            document.documentElement.setAttribute('data-theme', t);
          }
        } catch (e) {
          /* private mode, blocked storage — fall through to prefers-color-scheme */
        }
        window.setThemeColor();
      })();
    </script>

    {/* GA4 runs on the production host only, and only after the visitor says
        yes. Host gate: NOINDEX_SITE used to keep dev and preview builds out of
        the numbers, but it is false in every build now, so `npm run preview`
        and the *.pages.dev alias were counted as real traffic — GA4's page
        report for 21–29 Sep holds 23 page views from hostName "localhost" and
        4 from "ringsizetool.pages.dev".

        Consent gate (src/data/consent.ts has the sources): this is Google's
        "basic" consent mode. Until the visitor accepts, gtag.js is never
        fetched, `window.gtag` does not exist, and no GA cookie is set. The
        tool's usage events already test `typeof gtag === 'function'` at the
        moment they fire, so before consent they do nothing, and after it they
        work without a reload. Any `_ga` cookie from before this banner existed
        is deleted on every page view that lacks a yes.

        This runs in <head>, before the body paints, and only writes
        data-consent on <html>; global.css shows the banner from that
        attribute, so there is no flash and no layout shift. The banner's
        buttons call window.rstConsent.choose(). */}
    {!NOINDEX_SITE && (
      <script
        is:inline
        define:vars={{
          GA_MEASUREMENT_ID,
          GA_HOST: new URL(SITE_URL).hostname,
          CONSENT_KEY: CONSENT_STORE_KEY,
          CONSENT_VERSION,
          CONSENT_MAX_AGE_MS,
        }}
      >
        (function () {
          var root = document.documentElement;
          var gaLoaded = false;

          function read() {
            try {
              var v = JSON.parse(localStorage.getItem(CONSENT_KEY) || 'null');
              if (!v || v.v !== CONSENT_VERSION) return null;
              if (v.a !== 'granted' && v.a !== 'denied') return null;
              var age = Date.now() - v.t;
              if (typeof v.t !== 'number' || age < 0 || age > CONSENT_MAX_AGE_MS) return null;
              return v.a;
            } catch (e) {
              return null; /* blocked storage: treat as unanswered, load nothing */
            }
          }

          function save(answer) {
            try {
              localStorage.setItem(CONSENT_KEY, JSON.stringify({ v: CONSENT_VERSION, a: answer, t: Date.now() }));
            } catch (e) {
              /* the choice still applies to this page; it cannot be remembered */
            }
          }

          /* gtag's default cookie_domain is "auto", the highest domain that
             accepts a cookie, so try every level of the host as well as
             host-only — whichever one set it is the one that clears it. */
          function clearGaCookies() {
            var parts = location.hostname.split('.');
            var domains = [''];
            for (var i = 0; i < parts.length - 1; i++) domains.push('; domain=.' + parts.slice(i).join('.'));
            document.cookie.split(';').forEach(function (c) {
              var name = c.split('=')[0].trim();
              if (name !== '_ga' && name.indexOf('_ga_') !== 0) return;
              domains.forEach(function (d) {
                document.cookie = name + '=; Max-Age=0; path=/' + d;
              });
            });
          }

          function loadGa() {
            if (gaLoaded || location.hostname !== GA_HOST) return;
            gaLoaded = true;
            window.dataLayer = window.dataLayer || [];
            window.gtag = function () {
              window.dataLayer.push(arguments);
            };
            /* Order per Google's basic-mode guide: defaults first, then the
               update the visitor's yes allows. Only analytics is granted. */
            window.gtag('consent', 'default', {
              ad_storage: 'denied',
              ad_user_data: 'denied',
              ad_personalization: 'denied',
              analytics_storage: 'denied',
            });
            window.gtag('consent', 'update', { analytics_storage: 'granted' });
            window.gtag('set', { allow_ad_personalization_signals: false });
            window.gtag('js', new Date());
            window.gtag('config', GA_MEASUREMENT_ID, { allow_google_signals: false });
            var tag = document.createElement('script');
            tag.async = true;
            tag.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_MEASUREMENT_ID;
            document.head.appendChild(tag);
          }

          var answer = read();
          root.setAttribute('data-consent', answer || 'unset');
          if (answer === 'granted') loadGa();
          else clearGaCookies();

          window.rstConsent = {
            choose: function (next) {
              if (next !== 'granted' && next !== 'denied') return;
              save(next);
              root.setAttribute('data-consent', next);
              root.removeAttribute('data-consent-open');
              if (next === 'granted') {
                loadGa();
                return;
              }
              window['ga-disable-' + GA_MEASUREMENT_ID] = true;
              clearGaCookies();
              /* gtag.js cannot be unloaded from a running page, and it keeps
                 timers (engagement pings on page hide). A reload is the one
                 certain way to stop it after a yes is withdrawn. */
              if (gaLoaded) location.reload();
            },
          };
        })();
      </script>
    )}

    <slot name="head" />
  </head>

  <body class="min-h-dvh flex flex-col">
    <a href="#main" class="skip-link">Skip to content</a>
    {/* First after the skip link, so keyboard users reach the choice before
        the navigation. Hidden by CSS unless <html data-consent="unset"> or
        data-consent-open is set — see the head script above. */}
    {!NOINDEX_SITE && <ConsentBanner />}
    <Header hasTool={hasTool} />
    <main id="main" class="flex-1 w-full">
      <slot />
    </main>
    <Footer />
  </body>
</html>
