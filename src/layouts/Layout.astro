---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_NAME } from '../config';

interface Props {
  title: string;
  description: string;
  /** Set true only while the site lives on *.pages.dev with no real domain yet. */
  noindex?: boolean;
  ogImage?: string;
  /** Schema.org objects. Build them from page data, never hand-write the numbers. */
  jsonLd?: Record<string, unknown>[];
}

const { title, description, noindex = false, ogImage = '/og.png', jsonLd = [] } = Astro.props;

/**
 * `build.format: 'file'` emits about.html, so Astro.url.pathname is
 * "/about.html" (and "/index.html" for the root) at build time. Left as-is
 * that produces a canonical pointing at a URL nobody visits. Normalise it.
 */
const canonical = new URL(
  Astro.url.pathname.replace(/index\.html$/, '').replace(/\.html$/, ''),
  Astro.site,
).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {
      /* Emitted even while the site is noindex, so the schema is testable now
         rather than first exercised on launch day. The robots meta above is
         what actually keeps the page out of the index. */
      jsonLd.map((schema) => (
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
      ))
    }

    <link
      rel="preload"
      href="/fonts/instrument-serif-400-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {/* Theme, applied before first paint. Without this the page flashes light then goes dark. */}
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t === 'dark' || t === 'light') {
            document.documentElement.setAttribute('data-theme', t);
          }
        } catch (e) {
          /* private mode, blocked storage — fall through to prefers-color-scheme */
        }
      })();
    </script>

    <slot name="head" />
  </head>

  <body class="min-h-dvh flex flex-col">
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main" class="flex-1 w-full">
      <slot />
    </main>
    <Footer />
  </body>
</html>
