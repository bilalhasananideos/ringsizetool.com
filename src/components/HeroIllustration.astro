---
/**
 * Two variants, swapped by theme with pure CSS — no JS, no flash.
 *
 * LIGHT: Hand line-art illustration (gold + charcoal ink on cream paper)
 * with transparent alpha.
 *
 * DARK: Precision geometric diagram (dashed calibration circle, gold ring,
 * caliper ticks, mm readout). Vector-sharp on dark background.
 */
---
<div class="hero-art flex w-full max-w-sm sm:max-w-md items-center justify-center">
  <!-- LIGHT MODE: The hand line-art illustration -->
  <img
    src="/images/hero-ring-hand.webp"
    alt="Line drawing of a hand wearing a ring"
    width="681"
    height="583"
    class="hero-art-photo h-auto w-full max-h-[340px] object-contain drop-shadow-sm transition-opacity duration-300"
    loading="eager"
    fetchpriority="high"
  />

  <!-- DARK MODE: The crisp geometric diagram with gold ring & caliper measurements -->
  <div class="hero-art-diagram w-full flex items-center justify-center">
    <svg
      class="h-auto w-full max-w-[320px]"
      viewBox="0 0 320 320"
      fill="none"
      role="img"
      aria-label="Diagram of a ring measured against a calibrated guide circle"
    >
      <circle cx="160" cy="160" r="130" stroke="var(--border-strong)" stroke-width="1.5" stroke-dasharray="2 7" stroke-linecap="round" />
      <g stroke="var(--text-faint)" stroke-width="1.5" stroke-linecap="round">
        <path d="M160 22v16M160 282v16M22 160h16M282 160h16" />
        <path d="M65 65l11 11M244 65l-11 11M65 255l11-11M244 255l-11-11" opacity="0.6" />
      </g>
      <path d="M160 96v128M96 160h128" stroke="var(--border-strong)" stroke-width="1" />
      <circle cx="160" cy="160" r="66" stroke="var(--accent-bright)" stroke-width="2" opacity="0.25" />
      <circle cx="160" cy="160" r="62" stroke="var(--accent-bright)" stroke-width="4" />
      <line x1="160" y1="160" x2="222" y2="160" stroke="var(--accent-bright)" stroke-width="1.5" stroke-dasharray="3 4" />
      <circle cx="160" cy="160" r="3" fill="var(--accent-bright)" />
      <circle cx="222" cy="160" r="3" fill="var(--accent-bright)" />
      <text x="172" y="152" font-family="var(--font-mono)" font-size="13" font-weight="600" fill="var(--accent-bright)">16.5 mm</text>
    </svg>
  </div>
</div>

<style>
  /* Default (light): photo shown, diagram hidden */
  .hero-art-diagram { display: none; }
  .hero-art-photo { display: block; }

  /* Dark mode via system preference when no explicit light theme */
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .hero-art-photo { display: none; }
    :root:not([data-theme="light"]) .hero-art-diagram { display: flex; }
  }

  /* Explicit dark mode override */
  :root[data-theme="dark"] .hero-art-photo { display: none; }
  :root[data-theme="dark"] .hero-art-diagram { display: flex; }

  /* Explicit light mode override */
  :root[data-theme="light"] .hero-art-photo { display: block; }
  :root[data-theme="light"] .hero-art-diagram { display: none; }
</style>
