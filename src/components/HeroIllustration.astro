---
/**
 * Original artwork — a precision-diagram motif, not an illustrated hand.
 *
 * A hand-drawn hand was tried first and looked amateurish: fingers mismatched,
 * palm shape wrong. Freehand anatomical line art needs real drawing skill;
 * simple geometry does not. This also fits the brand better — "instrument,
 * not stock photo" is the whole positioning (see the hero-removal comment in
 * index.astro), and a caliper-style diagram says that more honestly than a
 * decorative hand ever would.
 *
 * Echoes the tool's own visual language: a dashed guide circle (screen
 * calibration), a solid ring at true relative proportion, and tick marks
 * like a caliper scale. Per DESIGN.md's diagram spec — 1.5px stroke,
 * --text-faint for structure, --accent-bright for the measured element.
 */
---
<svg
  viewBox="0 0 320 320"
  fill="none"
  role="img"
  aria-label="Diagram of a ring measured against a calibrated guide circle"
  class="h-auto w-full max-w-sm"
>
  <!-- Outer guide circle — dashed, the calibration reference -->
  <circle cx="160" cy="160" r="130" stroke="var(--border-strong)" stroke-width="1.5" stroke-dasharray="2 7" stroke-linecap="round" />

  <!-- Caliper tick marks around the guide circle -->
  <g stroke="var(--text-faint)" stroke-width="1.5" stroke-linecap="round">
    <path d="M160 22v16M160 282v16M22 160h16M282 160h16" />
    <path d="M65 65l11 11M244 65l-11 11M65 255l11-11M244 255l-11-11" opacity="0.6" />
  </g>

  <!-- Crosshair through the centre -->
  <path d="M160 96v128M96 160h128" stroke="var(--border-strong)" stroke-width="1" />

  <!-- The ring itself — the accented, measured element -->
  <circle cx="160" cy="160" r="66" stroke="var(--accent-bright)" stroke-width="2" opacity="0.2" />
  <circle cx="160" cy="160" r="62" stroke="var(--accent-bright)" stroke-width="4" />

  <!-- Measurement callout -->
  <line x1="160" y1="160" x2="222" y2="160" stroke="var(--accent-bright)" stroke-width="1.5" stroke-dasharray="3 4" />
  <circle cx="160" cy="160" r="2.5" fill="var(--accent-bright)" />
  <circle cx="222" cy="160" r="2.5" fill="var(--accent-bright)" />

  <text x="176" y="152" font-family="var(--font-mono)" font-size="13" fill="var(--text-muted)">16.5&#160;mm</text>
</svg>
