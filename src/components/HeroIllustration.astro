---
/**
 * Hero illustration — hand line-art shown in both light and dark mode.
 * The hand image has a transparent alpha channel so it blends naturally
 * over both the light cream and dark charcoal backgrounds.
 *
 * Uses Astro's <Image> component to fix the dev-toolbar audit hints.
 * loading="eager" + fetchpriority="high" are intentional — this is the
 * Largest Contentful Paint element and must NOT be lazy-loaded.
 */
import { Image } from 'astro:assets';
/* src/assets, NOT public/. Importing an image that also sits in public/ ships
 * it TWICE: once processed into _astro (the copy the page uses) and once
 * copied verbatim to /images/, which nothing requests. That was 138 KB of
 * dead weight in every deploy. Measured, not assumed — both files were in
 * dist/ side by side. logo-128.webp stays in public/ because the Organization
 * schema references it by public URL. */
import heroSrc from '../assets/hero-ring-hand.webp';
---
<div class="hero-art flex w-full max-w-sm sm:max-w-md items-center justify-center">
  <Image
    src={heroSrc}
    alt="Line drawing of a hand wearing a ring"
    class="h-auto w-full max-h-[340px] object-contain drop-shadow-sm"
    loading="eager"
    fetchpriority="high"
    quality={90}
  />
</div>
