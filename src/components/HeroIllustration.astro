---
/**
 * Hero illustration — hand line-art shown in both light and dark mode.
 * The hand image has a transparent alpha channel so it blends naturally
 * over both the light cream and dark charcoal backgrounds.
 */
---
<div class="hero-art flex w-full max-w-sm sm:max-w-md items-center justify-center">
  <img
    src="/images/hero-ring-hand.webp"
    alt="Line drawing of a hand wearing a ring"
    width="681"
    height="583"
    class="h-auto w-full max-h-[340px] object-contain drop-shadow-sm"
    loading="eager"
    fetchpriority="high"
  />
</div>
