---
// Three states: system (default) -> light -> dark -> system.
//
// The button used to show a sun in all three and carry a fixed
// aria-label="Change colour theme". Two consequences (QA-AUDIT-2026-09-30.md
// §7.3): on a dark OS, one click in three — dark -> system — changed nothing
// visible, so the control read as broken; and the aria-label OVERRODE the
// sr-only "Light theme" text the script kept updating, so a screen reader was
// never told the current state either. Now the icon shows the state and the
// accessible name says both the state and what a press will do.
---
<button
  type="button"
  id="theme-toggle"
  data-theme-state="system"
  class="inline-flex h-11 w-11 items-center justify-center rounded-lg border border-border text-text-muted transition-colors duration-150 hover:text-text hover:border-border-strong"
  aria-label="Colour theme: System. Switch to Light"
  title="Colour theme: System. Switch to Light"
>
  {/* System: a half-filled disc, the usual "follows the device" mark. */}
  <svg data-icon="system" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
       stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
    <circle cx="12" cy="12" r="8" />
    <path d="M12 4a8 8 0 0 1 0 16z" fill="currentColor" stroke="none" />
  </svg>
  <svg data-icon="light" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
       stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4.5" />
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
  </svg>
  <svg data-icon="dark" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
       stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" />
  </svg>
</button>

<style>
  /* One icon at a time, chosen by the button's own state attribute. The server
   * renders "system"; the inline script below corrects it synchronously, right
   * after the button is parsed, so a stored choice does not flash the wrong
   * icon. */
  #theme-toggle svg { display: none; }
  #theme-toggle[data-theme-state='system'] svg[data-icon='system'],
  #theme-toggle[data-theme-state='light'] svg[data-icon='light'],
  #theme-toggle[data-theme-state='dark'] svg[data-icon='dark'] { display: block; }
</style>

<script is:inline>
  (function () {
    var btn = document.getElementById('theme-toggle');
    if (!btn) return;
    var order = ['system', 'light', 'dark'];
    var osDark = window.matchMedia('(prefers-color-scheme: dark)');
    var cap = function (s) { return s.charAt(0).toUpperCase() + s.slice(1); };

    function read() {
      try {
        return localStorage.getItem('theme') || 'system';
      } catch (e) {
        return 'system';
      }
    }

    /* "System" alone does not say what the reader is looking at, and it is the
     * state where the next press can look like a no-op, so it names the theme
     * the device is actually giving. */
    function describe(state) {
      var now = state === 'system' ? 'System (' + (osDark.matches ? 'dark' : 'light') + ')' : cap(state);
      var next = order[(order.indexOf(state) + 1) % order.length];
      return 'Colour theme: ' + now + '. Switch to ' + cap(next);
    }

    function paint(state) {
      btn.setAttribute('data-theme-state', state);
      var text = describe(state);
      btn.setAttribute('aria-label', text);
      btn.setAttribute('title', text);
    }

    function apply(next) {
      if (next === 'system') {
        document.documentElement.removeAttribute('data-theme');
        try { localStorage.removeItem('theme'); } catch (e) {}
      } else {
        document.documentElement.setAttribute('data-theme', next);
        try { localStorage.setItem('theme', next); } catch (e) {}
      }
      if (window.setThemeColor) window.setThemeColor();
      paint(next);
    }

    apply(read());

    btn.addEventListener('click', function () {
      apply(order[(order.indexOf(read()) + 1) % order.length]);
    });

    /* The device can change theme under a "System" choice (sunset schedules);
     * keep the name true. */
    var onOsChange = function () { if (read() === 'system') paint('system'); };
    if (osDark.addEventListener) osDark.addEventListener('change', onOsChange);
    else if (osDark.addListener) osDark.addListener(onOsChange);
  })();
</script>
