---
interface Props {
  size?: number;
  class?: string;
}

const { size = 54, class: className = '' } = Astro.props;
---
<img
  src="/images/logo.webp"
  alt="Ring Size Tool Logo"
  width={size}
  height={size}
  class:list={['aspect-square object-contain shrink-0', className]}
  loading="eager"
  decoding="async"
/>
