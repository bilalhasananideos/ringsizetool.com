---
interface Props {
  size?: number;
  class?: string;
}

const { size = 36, class: className = '' } = Astro.props;
---
<svg
  width={size}
  height={size}
  viewBox="0 0 100 100"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  class={className}
  shape-rendering="geometricPrecision"
  aria-label="Ring Size Tool Logo"
>
  <defs>
    <!-- Ultra-Crisp High-Contrast Gold Gradient -->
    <linearGradient id="rst-gold-crisp" x1="10" y1="10" x2="90" y2="90" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#FFF3C4" />
      <stop offset="25%" stop-color="#F3CE5E" />
      <stop offset="50%" stop-color="#D4AF37" />
      <stop offset="80%" stop-color="#AA7E16" />
      <stop offset="100%" stop-color="#805B05" />
    </linearGradient>

    <!-- Caliper Rim Gradient -->
    <linearGradient id="rst-rim-grad" x1="0" y1="0" x2="100" y2="100" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#E5C358" />
      <stop offset="50%" stop-color="#FFF6D6" />
      <stop offset="100%" stop-color="#B8860B" />
    </linearGradient>
  </defs>

  <!-- ── 1. Outer Ring & Caliper / Ruler Scale (Optimized for 100x100 Grid) ── -->
  <!-- Left Clean Ring Arc -->
  <path
    d="M 50 6 A 44 44 0 0 0 50 94"
    stroke="url(#rst-gold-crisp)"
    stroke-width="3.5"
    stroke-linecap="round"
    fill="none"
  />

  <!-- Right Caliper Band (Ruler Track) -->
  <path
    d="M 50 5 
       A 45 45 0 0 1 50 95 
       L 49 86 
       A 36 36 0 0 0 49 14 
       Z"
    fill="url(#rst-gold-crisp)"
    stroke="url(#rst-rim-grad)"
    stroke-width="1"
  />

  <!-- Caliper Scale Tick Marks (Crisp Solid Geometry) -->
  <g stroke="#261A00" stroke-width="1.2" stroke-linecap="round">
    <!-- Top & Bottom Anchor Stops -->
    <line x1="49" y1="5" x2="49" y2="14" stroke-width="1.8" />
    <line x1="49" y1="86" x2="49" y2="95" stroke-width="1.8" />

    <!-- Degree Notches Radiating Cleanly -->
    <!-- -60° -->
    <line x1="72" y1="11" x2="68" y2="18" stroke-width="1.5" />
    <!-- -45° -->
    <line x1="81" y1="18" x2="75" y2="24" />
    <!-- -30° -->
    <line x1="89" y1="28" x2="82" y2="33" stroke-width="1.5" />
    <!-- -15° -->
    <line x1="93" y1="39" x2="85" y2="42" />
    <!-- 0° Center Caliper Major Tick -->
    <line x1="95" y1="50" x2="86" y2="50" stroke-width="2" stroke="#1A1200" />
    <!-- +15° -->
    <line x1="93" y1="61" x2="85" y2="58" />
    <!-- +30° -->
    <line x1="89" y1="72" x2="82" y2="67" stroke-width="1.5" />
    <!-- +45° -->
    <line x1="81" y1="82" x2="75" y2="76" />
    <!-- +60° -->
    <line x1="72" y1="89" x2="68" y2="82" stroke-width="1.5" />
  </g>

  <!-- ── 2. Serif RST Monogram (Clean, Bold, Optical Clarity) ──────────── -->
  <g fill="url(#rst-gold-crisp)">
    <!-- Letter 'R' with Elegant Swoop Under 'S' -->
    <path
      d="M 23 37 H 36 C 44 37 49 41 49 47.5 C 49 53 45 57 38 57.5 
         C 43 62 48 67 58 68.5 C 51 68.5 46 65 42 59.5 
         L 32 59.5 V 63 H 35 V 65 H 20 V 63 H 23 Z
         M 28 40 V 56.5 H 35 C 41 56.5 44 53.5 44 48 C 44 43 41 40 35 40 Z"
      fill-rule="evenodd"
    />

    <!-- Letter 'S' (Intertwined Serif Center) -->
    <path
      d="M 59 44 C 58 40 54 37.5 48.5 37.5 C 42 37.5 38 41 38 45.5 C 38 50 42 52.5 48 54.5 C 55 57 59.5 59.5 59.5 65 C 59.5 71.5 54 75.5 46 75.5 C 39 75.5 34 71 33 65 L 38 64.5 C 38.5 68.5 42 71.5 47 71.5 C 52 71.5 55 69 55 65 C 55 61 51 58.5 45 56 C 38.5 53.5 33.5 50.5 33.5 45 C 33.5 39.5 38.5 34 48.5 34 C 54.5 34 59 37.5 60.5 43 Z"
    />

    <!-- Letter 'T' (Right Serif) -->
    <path
      d="M 58 39 V 37 H 80 V 39 H 76 V 42 H 74 V 39 H 70 V 63 H 74 V 65 H 64 V 63 H 67 V 39 H 63 V 42 H 61 V 39 Z"
    />
  </g>
</svg>
