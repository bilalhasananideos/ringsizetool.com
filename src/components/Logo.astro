---
/**
 * The wordmark's ring glyph.
 *
 * Sourced from /images/logo-128.webp, NOT logo.webp: the full-size file is
 * 581x574 and 145 KB for a mark that renders at 48-56 px, on every page. The
 * 128 px version is 13 KB and still covers a 2x display at the largest size
 * the header uses.
 *
 * The alt text is empty on purpose. This mark always appears immediately
 * beside the site name in text (Header and Footer both), so naming it again
 * makes a screen reader read the brand twice. It is decorative here.
 *
 * Uses Astro's <Image> component so the build pipeline can emit the correct
 * srcset, width/height, and format hints — fixes the "Use the Image component"
 * dev-toolbar audit hint.
 */
import { Image } from 'astro:assets';
import logoSrc from '../../public/images/logo-128.webp';

interface Props {
  size?: number;
  class?: string;
}

const { size = 54, class: className = '' } = Astro.props;
---
<Image
  src={logoSrc}
  alt=""
  aria-hidden="true"
  width={size}
  height={size}
  class:list={['aspect-square object-contain shrink-0', className]}
  loading="eager"
  decoding="async"
  quality={90}
/>
