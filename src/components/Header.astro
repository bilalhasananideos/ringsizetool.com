---
import ThemeToggle from './ThemeToggle.astro';
import Logo from './Logo.astro';
import { SITE_NAME, NAV } from '../config';

/* `build.format: 'file'` emits ring-size-chart.html, so Astro.url.pathname is
 * "/ring-size-chart.html" at build time and "/index.html" at the root. Compared
 * raw against NAV's "/ring-size-chart" it never matched, so aria-current="page"
 * and the accent underline rendered on ZERO built pages — the nav has never
 * marked where you are in production. Same normalisation Layout.astro applies
 * to the canonical URL, and for the same reason. */
const path = Astro.url.pathname.replace(/index\.html$/, '').replace(/\.html$/, '') || '/';
---
<header class="no-print sticky top-0 z-40 border-b border-border bg-bg/80 backdrop-blur-md backdrop-saturate-150">
  <!-- Tight on purpose: at 375px the wordmark plus two nav labels plus the
       toggle only just fit. Everything is nowrap so a second nav item can
       never silently wrap the header into two lines. -->
  <div class="mx-auto flex w-full max-w-6xl items-center justify-between gap-4 px-6 py-3.5 sm:px-8">
    <a href="/" class="flex shrink-0 items-center gap-3.5 text-text no-underline group">
      <Logo size={54} class="h-12 w-12 sm:h-14 sm:w-14 shrink-0 transition-transform duration-200 group-hover:scale-105" />
      <span class="font-bold tracking-tight text-lg sm:text-xl whitespace-nowrap">{SITE_NAME}</span>
    </a>

    <nav aria-label="Main" class="hidden md:flex items-center gap-1 sm:gap-2">
      {NAV.map((item) => (
        <a
          href={item.href}
          aria-current={path === item.href ? 'page' : undefined}
          class:list={[
            'relative whitespace-nowrap rounded-lg px-3 py-2 text-sm font-medium no-underline transition-colors duration-150',
            path === item.href
              ? 'text-text after:absolute after:bottom-0.5 after:left-3 after:right-3 after:h-0.5 after:bg-accent after:rounded-full'
              : 'text-text-muted hover:text-text',
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <ThemeToggle />
      <a
        href="#tool-heading"
        class="hidden sm:inline-flex h-9 items-center justify-center rounded-full bg-accent px-4 text-xs font-semibold text-on-accent no-underline transition-all hover:bg-accent-hover shadow-xs"
      >
        Get Started
      </a>
    </div>
  </div>

  {/* The nav above is hidden below md because the wordmark, four labels and the
      toggle cannot share one line at 375px. Hiding it was leaving phones with no
      site navigation at all — not a hamburger, and not in the footer either,
      which carries only the trust pages. Mobile is roughly 44% of impressions.

      A second row rather than a disclosure: four links need no menu, and a
      <details> or a checkbox toggle would add a control to open something that
      fits on screen as it is. Scrolls itself if a fifth label ever arrives. */}
  <nav
    aria-label="Main"
    class="md:hidden -mt-1 flex gap-1 overflow-x-auto border-t border-border/60 px-4 pb-1
           [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
  >
    {NAV.map((item) => (
      <a
        href={item.href}
        aria-current={path === item.href ? 'page' : undefined}
        class:list={[
          'inline-flex min-h-11 shrink-0 items-center whitespace-nowrap px-3 text-sm font-medium no-underline transition-colors duration-150',
          path === item.href
            ? 'text-text border-b-2 border-accent'
            : 'text-text-muted border-b-2 border-transparent hover:text-text',
        ]}
      >
        {item.label}
      </a>
    ))}
  </nav>
</header>
