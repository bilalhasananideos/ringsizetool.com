---
/**
 * A page's FAQ block. The markup lived only on the homepage; four other pages
 * needed the same thing, so it is a component rather than four copies that
 * drift apart.
 *
 * The caller is responsible for passing `faqPageSchema(theSameArray)` into its
 * Layout's jsonLd. Rendering questions here without emitting the schema, or
 * emitting schema for questions that are not on the page, are both Google
 * structured-data violations — the markup and the schema must match exactly.
 */
import type { Faq } from '../data/faq';

interface Props {
  faqs: Faq[];
  /** Overridable so each page's FAQ heading can carry its own keyword. */
  heading?: string;
  id?: string;
  /**
   * Shows the "answers aren't hidden behind a click" note — see the homepage
   * FAQ for the same paragraph and where the seven-page crawl figure came
   * from. Off by default so the other three pages using this component don't
   * pick it up silently; pass it explicitly per page.
   */
  showAnswerReadyNote?: boolean;
}

const {
  faqs,
  heading = 'Questions people actually ask',
  id = 'faq',
  showAnswerReadyNote = false,
} = Astro.props;
---
<section id={id} class="mt-16 scroll-mt-20" aria-labelledby={`${id}-title`}>
  <h2 id={`${id}-title`} class="text-[clamp(1.75rem,3.5vw,2.25rem)]">{heading}</h2>

  <p class="mt-3 max-w-[62ch] text-sm text-text-muted">
    Taken word for word from Google&rsquo;s &ldquo;People also ask&rdquo;. Nothing here is invented
    to pad the page.
  </p>
  {showAnswerReadyNote && (
    <p class="mt-3 max-w-[68ch] text-sm text-text-muted leading-relaxed">
      Every answer below is written straight into the page &mdash; open or closed, it is already
      there, nothing loads only after a click. We checked seven of the top-ranking ring-sizer
      pages the way a search engine actually reads them rather than the way a person browsing
      does: fetch and read, nothing clicked. Six of the seven returned under 130&nbsp;words
      apiece, and two listed their FAQ questions with no answers attached at all &mdash; because
      those only appear once a visitor expands them.
    </p>
  )}

  <div class="mt-8 divide-y divide-border border-y border-border">
    {faqs.map((f) => (
      <details class="group">
        <summary
          class="flex min-h-11 cursor-pointer select-none items-start justify-between gap-4 py-4
                 font-medium text-text transition-colors duration-150 hover:text-accent"
        >
          <span class="text-sm sm:text-base">{f.q}</span>
          <svg
            width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="2" stroke-linecap="round"
            class="mt-1 shrink-0 text-text-faint transition-transform duration-200 group-open:rotate-45"
            aria-hidden="true"
          >
            <path d="M12 5v14M5 12h14" />
          </svg>
        </summary>
        <p class="max-w-[68ch] pb-5 pt-1 text-sm leading-relaxed text-text-muted">{f.a}</p>
      </details>
    ))}
  </div>
</section>
