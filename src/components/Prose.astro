---
interface Props { title: string; }
const { title } = Astro.props;
---
<div class="mx-auto w-full max-w-[68ch] px-5 py-16">
  <h1 class="text-[clamp(2rem,4vw,2.75rem)]">{title}</h1>
  <div class="mt-8 space-y-5 text-text-muted [&_h2]:mt-12 [&_h2]:text-2xl [&_h2]:text-text [&_h3]:mt-8 [&_h3]:text-lg [&_h3]:font-semibold [&_h3]:text-text [&_a]:text-accent [&_a]:underline [&_a]:underline-offset-2 [&_ul]:list-disc [&_ul]:pl-6 [&_ul]:space-y-2 [&_strong]:text-text">
    <slot />
  </div>
</div>
