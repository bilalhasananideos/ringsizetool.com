---
/**
 * Interactive Ring Size Instrument.
 * Real-time measurement in MM, CM, and Inches, multi-region size conversions, and screen calibration.
 */
---

<section class="ring-sizer w-full" aria-labelledby="tool-heading">
  <h2 id="tool-heading" class="sr-only">Interactive Ring Sizer</h2>

  <!-- ── Step 1: Calibrate Drawer (Collapsible) ────────────────────────── -->
  <div data-step="calibrate" hidden class="card-elevated mb-6 rounded-2xl border border-border bg-surface p-6 sm:p-8 transition-all">
    <div class="flex items-center justify-between gap-3 mb-4">
      <div class="flex items-center gap-3">
        <span class="flex h-6 w-6 items-center justify-center rounded-full bg-accent text-on-accent text-xs font-bold">1</span>
        <h3 class="text-lg font-semibold text-text">Calibrate Screen Scale</h3>
      </div>
      <button data-cal-close type="button" class="cursor-pointer text-xs text-text-muted hover:text-text underline">
        Close ✕
      </button>
    </div>

    <div class="grid gap-6 md:grid-cols-[1.1fr_0.9fr] md:items-center">
      <div>
        <p class="text-sm text-text-muted leading-relaxed">
          Hold any standard bank card upright against your screen and adjust the slider until the outline matches its exact width (53.98 mm).
        </p>

        <div class="mt-5 rounded-xl border border-border bg-surface-sunk/50 p-4">
          <div class="flex items-center justify-between text-xs text-text-muted mb-2 font-medium">
            <span>Match outline to card</span>
            <span class="font-mono"><span data-readout data-cal-val>3.78</span> px/mm</span>
          </div>
          <input
            id="cal-range" data-cal-range type="range"
            min="2.5" max="7" step="0.01" value="3.78"
            class="h-2 w-full cursor-pointer appearance-none rounded-full bg-border-strong/40 accent-[#D4AF37] focus:outline-none"
          />
        </div>

        <div class="mt-5 flex flex-wrap items-center gap-3">
          <button data-cal-save type="button" class="h-10 cursor-pointer rounded-xl bg-accent px-5 text-xs font-semibold text-on-accent hover:bg-accent-hover transition-all shadow-xs">
            Save Scale
          </button>
          <button data-cal-reset type="button" class="h-10 cursor-pointer rounded-xl border border-border px-4 text-xs font-medium text-text-muted hover:text-text transition-colors">
            Reset Default (96 DPI)
          </button>
        </div>
      </div>

      <div class="flex flex-col items-center justify-center rounded-xl border border-dashed border-border bg-surface-sunk/50 p-6">
        <div
          data-card
          class="flex items-center justify-center rounded-lg border-2 border-dashed border-accent bg-accent-sunk/30 transition-all shadow-xs"
          style="width:204px;aspect-ratio:53.98/85.6"
        >
          <span class="text-xs font-medium text-accent-text text-center px-2 pointer-events-none select-none">
            Standard Bank Card<br/><span class="text-[10px] text-text-faint font-mono">53.98 mm</span>
          </span>
        </div>
        <p class="mt-3 text-[11px] text-text-faint font-mono">1:1 Physical Scale Outline</p>
      </div>
    </div>
  </div>

  <!-- ── Main Interactive Instrument Card ──────────────────────────────── -->
  <div data-step="measure" class="card-elevated rounded-2xl border border-border bg-surface p-6 sm:p-10 md:p-12 shadow-sm">
    <!-- Top Pill Switcher: MM, CM, Inches, Circumference -->
    <div class="flex justify-center">
      <div class="inline-flex flex-wrap justify-center rounded-full bg-surface-sunk p-1 border border-border/80 shadow-inner gap-1">
        <button
          type="button"
          data-mode-btn="mm"
          class="cursor-pointer rounded-full px-4 sm:px-5 py-2 text-xs sm:text-sm font-semibold transition-all duration-150 bg-surface text-text shadow-xs"
        >
          MM
        </button>
        <button
          type="button"
          data-mode-btn="cm"
          class="cursor-pointer rounded-full px-4 sm:px-5 py-2 text-xs sm:text-sm font-medium transition-all duration-150 text-text-muted hover:text-text"
        >
          CM
        </button>
        <button
          type="button"
          data-mode-btn="inches"
          class="cursor-pointer rounded-full px-4 sm:px-5 py-2 text-xs sm:text-sm font-medium transition-all duration-150 text-text-muted hover:text-text"
        >
          Inches
        </button>
        <button
          type="button"
          data-mode-btn="circumference"
          class="cursor-pointer rounded-full px-4 sm:px-5 py-2 text-xs sm:text-sm font-medium transition-all duration-150 text-text-muted hover:text-text"
        >
          Circumference
        </button>
      </div>
    </div>

    <!-- 2-Column Main Instrument Grid -->
    <div class="mt-10 grid gap-10 md:grid-cols-[1fr_1.15fr] md:items-center">

      <!-- Left Column: Interactive Ring Circle Guide & Live Readout -->
      <div class="flex flex-col items-center justify-center">
        <div class="relative flex h-64 w-64 sm:h-72 sm:w-72 items-center justify-center">
          <!-- Outer dashed guide circle with crosshair ticks -->
          <div class="absolute inset-3 rounded-full border border-dashed border-border-strong/70 pointer-events-none"></div>

          <!-- Crosshair tick marks -->
          <div class="absolute left-1 top-1/2 -translate-y-1/2 w-4 h-px bg-border-strong"></div>
          <div class="absolute right-1 top-1/2 -translate-y-1/2 w-4 h-px bg-border-strong"></div>
          <div class="absolute top-1 left-1/2 -translate-x-1/2 h-4 w-px bg-border-strong"></div>
          <div class="absolute bottom-1 left-1/2 -translate-x-1/2 h-4 w-px bg-border-strong"></div>

          <!-- Center Crosshair tick indicator -->
          <div class="absolute left-3 top-1/2 -translate-y-1/2 h-2 w-px bg-border-strong"></div>
          <div class="absolute right-3 top-1/2 -translate-y-1/2 h-2 w-px bg-border-strong"></div>

          <!-- Scalable Golden Ring Circle -->
          <div
            data-ring-circle
            class="rounded-full border-[3px] border-[#D4AF37] shadow-[0_0_20px_rgba(212,175,55,0.25)] transition-all duration-75"
            style="width:62.4px;height:62.4px"
          ></div>
        </div>

        <!-- Big Readout Underneath -->
        <div class="mt-4 text-center">
          <div class="font-display text-3xl sm:text-4xl font-semibold tracking-tight text-accent">
            <span data-readout data-main-val>16.50</span> <span data-main-unit class="text-2xl font-normal text-text-muted">mm</span>
          </div>
          <p data-main-label class="mt-1 text-xs uppercase tracking-wider text-text-faint font-medium">
            Inside Diameter
          </p>
        </div>
      </div>

      <!-- Right Column: Slider with Step Buttons & 2x2 Country Size Grid -->
      <div class="flex flex-col justify-center">
        <!-- Slider Control Area -->
        <div class="mb-8">
          <div class="flex items-center justify-between text-xs font-mono text-text-muted mb-2 font-medium">
            <span data-min-label>11.00 mm</span>
            <span data-max-label>25.00 mm</span>
          </div>

          <div class="flex items-center gap-3">
            <button
              type="button"
              data-step-btn="minus"
              class="flex h-8 w-8 cursor-pointer items-center justify-center rounded-lg border border-border bg-surface-sunk text-text-muted hover:border-accent hover:text-text active:scale-95 transition-all text-base font-bold select-none"
              title="Decrease size"
            >
              −
            </button>

            <div class="relative flex-1">
              <input
                id="ring-range"
                data-ring-range
                type="range"
                min="11"
                max="25"
                step="0.01"
                value="16.51"
                class="h-2 w-full cursor-pointer appearance-none rounded-full bg-border-strong/40 accent-[#D4AF37] focus:outline-none"
              />
            </div>

            <button
              type="button"
              data-step-btn="plus"
              class="flex h-8 w-8 cursor-pointer items-center justify-center rounded-lg border border-border bg-surface-sunk text-text-muted hover:border-accent hover:text-text active:scale-95 transition-all text-base font-bold select-none"
              title="Increase size"
            >
              +
            </button>
          </div>
        </div>

        <!-- 2x2 Country Size Grid Cards -->
        <div>
          <p class="text-xs font-semibold uppercase tracking-wider text-text-faint mb-2">Your Size Is</p>
          <div class="grid grid-cols-2 gap-3 sm:gap-4">
            <!-- US & Canada -->
            <div class="rounded-xl border border-border bg-surface-sunk/40 p-4 sm:p-5 text-center transition-all hover:border-accent/40 hover:shadow-xs">
              <dt class="text-xs font-medium text-text-muted">US / CA</dt>
              <dd data-readout data-out-us class="mt-2 font-display text-2xl sm:text-3xl font-semibold text-text">6</dd>
            </div>

            <!-- UK & Australia -->
            <div class="rounded-xl border border-border bg-surface-sunk/40 p-4 sm:p-5 text-center transition-all hover:border-accent/40 hover:shadow-xs">
              <dt class="text-xs font-medium text-text-muted">UK / AU</dt>
              <dd data-out-uk class="mt-2 font-display text-2xl sm:text-3xl font-semibold text-text">L ½</dd>
            </div>

            <!-- Europe -->
            <div class="rounded-xl border border-border bg-surface-sunk/40 p-4 sm:p-5 text-center transition-all hover:border-accent/40 hover:shadow-xs">
              <dt class="text-xs font-medium text-text-muted">EU / ISO</dt>
              <dd data-readout data-out-eu class="mt-2 font-display text-2xl sm:text-3xl font-semibold text-text">52</dd>
            </div>

            <!-- Japan -->
            <div class="rounded-xl border border-border bg-surface-sunk/40 p-4 sm:p-5 text-center transition-all hover:border-accent/40 hover:shadow-xs">
              <dt class="text-xs font-medium text-text-muted">Japan (JP)</dt>
              <dd data-readout data-out-jp class="mt-2 font-display text-2xl sm:text-3xl font-semibold text-text">12</dd>
            </div>
          </div>
        </div>

        <!-- Action Row: Show Size Chart & Calibration -->
        <div class="mt-5 flex flex-wrap items-center justify-between gap-3 border-t border-border/60 pt-4 text-xs">
          <a
            href="#chart"
            class="inline-flex items-center gap-1.5 font-semibold text-accent-text hover:opacity-80 transition-opacity underline underline-offset-2"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path d="M3 3h18v18H3z"></path>
              <path d="M3 9h18M3 15h18M9 3v18M15 3v18"></path>
            </svg>
            Show Size Chart ↓
          </a>

          <div class="flex items-center gap-3 text-text-faint">
            <span>India: <strong data-readout data-out-in class="font-semibold text-text font-mono">12</strong></span>
            <span>FR/IT/ES: <strong data-readout data-out-fr class="font-semibold text-text font-mono">12</strong></span>
            <button data-recal type="button" class="cursor-pointer text-accent-text underline underline-offset-2 hover:opacity-80 font-medium">
              Calibrate
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Hidden data points for schema and accessibility -->
    <div class="sr-only">
      <span data-readout data-cal-status>3.78</span>
      <span data-readout data-out-dia-mm>16.51 mm</span>
      <span data-readout data-out-dia-in>0.650 in</span>
      <span data-readout data-out-circ-mm>51.87 mm</span>
      <span data-readout data-out-circ-in>2.042 in</span>
      <p data-live aria-live="polite"></p>
    </div>
  </div>
</section>

<style>
  /* Custom stylish slider thumb */
  input[type="range"]::-webkit-slider-thumb {
    appearance: none;
    height: 22px;
    width: 22px;
    border-radius: 50%;
    background: #D4AF37;
    cursor: grab;
    box-shadow: 0 1px 5px rgba(0,0,0,0.3);
    transition: transform 0.1s ease, box-shadow 0.1s ease;
  }
  input[type="range"]:active::-webkit-slider-thumb {
    cursor: grabbing;
    transform: scale(1.15);
  }
  input[type="range"]::-webkit-slider-thumb:hover {
    transform: scale(1.1);
    box-shadow: 0 2px 8px rgba(212,175,55,0.45);
  }
  input[type="range"]::-moz-range-thumb {
    height: 22px;
    width: 22px;
    border-radius: 50%;
    background: #D4AF37;
    cursor: pointer;
    border: none;
    box-shadow: 0 1px 5px rgba(0,0,0,0.3);
  }
</style>

<script>
  import { fromDiameter } from '../data/ringSizes';

  const root = document.querySelector<HTMLElement>('.ring-sizer');
  if (root) {
    const $ = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel)!;

    const CARD_SHORT_MM = 53.98;   // ISO/IEC 7810 ID-1, held upright
    const STORE = 'rst.pxPerMm';
    const PPM_MIN = 2.5;
    const PPM_MAX = 7;
    const DIA_MIN = 11;
    const DIA_MAX = 25;

    const stepCal = $('[data-step="calibrate"]');
    const card = $<HTMLElement>('[data-card]');
    const calRange = $<HTMLInputElement>('[data-cal-range]');
    const calVal = $('[data-cal-val]');
    const ringRange = $<HTMLInputElement>('[data-ring-range]');
    const ringCircle = $<HTMLElement>('[data-ring-circle]');
    const mainVal = $('[data-main-val]');
    const mainUnit = $('[data-main-unit]');
    const mainLabel = $('[data-main-label]');
    const minLabel = $('[data-min-label]');
    const maxLabel = $('[data-max-label]');
    
    const modeButtons = {
      mm: $<HTMLButtonElement>('[data-mode-btn="mm"]'),
      cm: $<HTMLButtonElement>('[data-mode-btn="cm"]'),
      inches: $<HTMLButtonElement>('[data-mode-btn="inches"]'),
      circumference: $<HTMLButtonElement>('[data-mode-btn="circumference"]'),
    };
    
    const btnMinus = $<HTMLButtonElement>('[data-step-btn="minus"]');
    const btnPlus = $<HTMLButtonElement>('[data-step-btn="plus"]');

    let pxPerMm = 3.78;                       // default 96 CSS DPI
    let activeMode: 'mm' | 'cm' | 'inches' | 'circumference' = 'mm';
    let currentDia = 16.51;                   // default US 6 inner diameter (mm)

    const store = {
      get(): number | null {
        try {
          const v = parseFloat(localStorage.getItem(STORE) ?? '');
          return Number.isFinite(v) && v >= PPM_MIN && v <= PPM_MAX ? v : null;
        } catch { return null; }
      },
      set(v: number) { try { localStorage.setItem(STORE, String(v)); } catch { /* blocked */ } },
    };

    /* ── calibration controls ── */
    function setPxPerMm(v: number) {
      pxPerMm = Math.min(PPM_MAX, Math.max(PPM_MIN, v));
      card.style.width = `${CARD_SHORT_MM * pxPerMm}px`;
      const s = pxPerMm.toFixed(2);
      if (calRange.value !== s) calRange.value = s;
      if (calVal) calVal.textContent = s;
      $('[data-cal-status]').textContent = s;
      updateDisplay();
    }

    calRange.addEventListener('input', () => setPxPerMm(parseFloat(calRange.value)));

    $('[data-cal-save]').addEventListener('click', () => {
      store.set(pxPerMm);
      stepCal.hidden = true;
    });

    $('[data-cal-close]').addEventListener('click', () => {
      stepCal.hidden = true;
    });

    $('[data-cal-reset]').addEventListener('click', () => {
      setPxPerMm(3.78);
      store.set(3.78);
    });

    $('[data-recal]').addEventListener('click', () => {
      stepCal.hidden = !stepCal.hidden;
      if (!stepCal.hidden) {
        stepCal.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    });

    /* ── Switch modes: MM, CM, Inches, Circumference ── */
    function setMode(mode: typeof activeMode) {
      activeMode = mode;
      
      // Update active pill classes
      Object.entries(modeButtons).forEach(([k, btn]) => {
        if (k === mode) {
          btn.className = 'cursor-pointer rounded-full px-4 sm:px-5 py-2 text-xs sm:text-sm font-semibold transition-all duration-150 bg-surface text-text shadow-xs';
        } else {
          btn.className = 'cursor-pointer rounded-full px-4 sm:px-5 py-2 text-xs sm:text-sm font-medium transition-all duration-150 text-text-muted hover:text-text';
        }
      });

      if (mode === 'mm') {
        mainLabel.textContent = 'Inside Diameter';
        mainUnit.textContent = 'mm';
        minLabel.textContent = '11.00 mm';
        maxLabel.textContent = '25.00 mm';
        ringRange.min = '11';
        ringRange.max = '25';
        ringRange.step = '0.01';
        ringRange.value = currentDia.toFixed(2);
      } else if (mode === 'cm') {
        mainLabel.textContent = 'Inside Diameter';
        mainUnit.textContent = 'cm';
        minLabel.textContent = '1.10 cm';
        maxLabel.textContent = '2.50 cm';
        ringRange.min = '1.1';
        ringRange.max = '2.5';
        ringRange.step = '0.01';
        ringRange.value = (currentDia / 10).toFixed(2);
      } else if (mode === 'inches') {
        mainLabel.textContent = 'Inside Diameter';
        mainUnit.textContent = 'in';
        minLabel.textContent = '0.43 in';
        maxLabel.textContent = '0.98 in';
        ringRange.min = '0.433';
        ringRange.max = '0.984';
        ringRange.step = '0.005';
        ringRange.value = (currentDia / 25.4).toFixed(3);
      } else {
        mainLabel.textContent = 'Circumference';
        mainUnit.textContent = 'mm';
        minLabel.textContent = '34.50 mm';
        maxLabel.textContent = '78.50 mm';
        ringRange.min = '34.5';
        ringRange.max = '78.5';
        ringRange.step = '0.05';
        ringRange.value = (currentDia * Math.PI).toFixed(2);
      }
      
      updateDisplay();
    }

    Object.entries(modeButtons).forEach(([k, btn]) => {
      btn.addEventListener('click', () => setMode(k as typeof activeMode));
    });

    /* ── slider & step buttons handlers ── */
    function handleValueChange(val: number) {
      if (activeMode === 'mm') {
        currentDia = Math.min(DIA_MAX, Math.max(DIA_MIN, val));
      } else if (activeMode === 'cm') {
        currentDia = Math.min(DIA_MAX, Math.max(DIA_MIN, val * 10));
      } else if (activeMode === 'inches') {
        currentDia = Math.min(DIA_MAX, Math.max(DIA_MIN, val * 25.4));
      } else {
        currentDia = Math.min(DIA_MAX, Math.max(DIA_MIN, val / Math.PI));
      }
      updateDisplay();
    }

    ringRange.addEventListener('input', () => {
      handleValueChange(parseFloat(ringRange.value));
    });

    btnMinus.addEventListener('click', () => {
      const step = activeMode === 'mm' ? 0.1 : activeMode === 'cm' ? 0.01 : activeMode === 'inches' ? 0.005 : 0.25;
      const current = parseFloat(ringRange.value);
      const next = Math.max(parseFloat(ringRange.min), current - step);
      ringRange.value = String(next);
      handleValueChange(next);
    });

    btnPlus.addEventListener('click', () => {
      const step = activeMode === 'mm' ? 0.1 : activeMode === 'cm' ? 0.01 : activeMode === 'inches' ? 0.005 : 0.25;
      const current = parseFloat(ringRange.value);
      const next = Math.min(parseFloat(ringRange.max), current + step);
      ringRange.value = String(next);
      handleValueChange(next);
    });

    const dash = (v: string | number | null) => (v === null ? '—' : String(v));

    /* ── update all visuals & country size cards ── */
    function updateDisplay() {
      const d = Math.min(DIA_MAX, Math.max(DIA_MIN, currentDia));
      
      // Update dynamic golden ring scale
      const px = d * pxPerMm;
      ringCircle.style.width = `${px}px`;
      ringCircle.style.height = `${px}px`;

      // Update main numeric readout based on active mode
      if (activeMode === 'mm') {
        mainVal.textContent = d.toFixed(2);
      } else if (activeMode === 'cm') {
        mainVal.textContent = (d / 10).toFixed(2);
      } else if (activeMode === 'inches') {
        mainVal.textContent = (d / 25.4).toFixed(2);
      } else {
        mainVal.textContent = (d * Math.PI).toFixed(2);
      }

      // Convert diameter to official standards
      const r = fromDiameter(d);
      const set = (sel: string, v: string) => { 
        const el = root.querySelector(sel);
        if (el) el.textContent = v;
      };

      set('[data-out-us]', dash(r.us));
      set('[data-out-uk]', dash(r.uk));
      set('[data-out-eu]', dash(r.eu));
      set('[data-out-jp]', dash(r.jp));
      set('[data-out-in]', dash(r.in));
      set('[data-out-fr]', dash(r.fr));
      set('[data-out-br]', dash(r.br));
      set('[data-out-dia-mm]', `${r.diameterMm.toFixed(2)} mm`);
      set('[data-out-dia-in]', `${r.diameterIn.toFixed(3)} in`);
      set('[data-out-circ-mm]', `${r.circumferenceMm.toFixed(2)} mm`);
      set('[data-out-circ-in]', `${r.circumferenceIn.toFixed(3)} in`);
    }

    /* ── boot initialization ── */
    const saved = store.get();
    if (saved) {
      setPxPerMm(saved);
    } else {
      setPxPerMm(3.78);
    }
    updateDisplay();
  }
</script>
