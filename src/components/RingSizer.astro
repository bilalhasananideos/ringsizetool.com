    let pxPerMm = parseFloat($('[data-cal-status]').textContent ?? '') || DEFAULT_PX_PER_MM;
    const fallbackMode = {
      measure: (root.dataset.initMeasure ?? 'dia') as Measure,
      unit: (root.dataset.initUnit ?? 'mm') as Unit,
