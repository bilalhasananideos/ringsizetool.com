---
/**
 * Interactive Ring Size Instrument.
 * Real-time measurement in MM, CM, and Inches, multi-region size conversions, and screen calibration.
 *
 * The values rendered on the server below are DERIVED, not typed. They used to
 * be hand-written literals (6 / "L ½" / 52 / 12 / 16.51 mm / 51.87 mm), which
 * breaks the house rule in CLAUDE.md and had already drifted: the markup said
 * "L ½" with a space while ukFromCircumference() emits "L½", so the value
 * visibly changed shape the moment the script booted.
 */
import { fromDiameter, diameterFromUs, UK_NOTE, INDIA_NOTE } from '../data/ringSizes';
import {
  MEASURES, UNITS, SOURCES, sourceSpec, sourceFromMeasure, modeSpec, toMode, ceilTo, floorTo,
  type Measure, type Unit,
} from '../data/ringModes';
import {
  CARD_SHORT_MM, CARD_LONG_MM, CARD_CORNER_MM, DEFAULT_PX_PER_MM, PPM_MIN, PPM_MAX,
  CAL_OBJECTS, DEFAULT_CAL_OBJECT, calObject, imprecisionVsCard,
  RULER_MAX_MM, RULER_LABELS,
} from '../data/calibration';
import {
  PILL_ON as pillOn, PILL_OFF as pillOff,
  SOURCE_ON as sourceOn, SOURCE_OFF as sourceOff,
} from './pillClasses';

/**
 * Pages that exist to answer one query ("ring size in inches") mount the tool
 * already showing that answer, rather than making the visitor find a toggle
 * for the thing the page title promised. The toggle still works afterwards.
 */
interface Props {
  measure?: Measure;
  unit?: Unit;
}
const { measure: initMeasure = 'dia', unit: initUnit = 'mm' } = Astro.props;

/** US 6 - the women's average, and the size the tool opens on. */
const DEFAULT_DIA = diameterFromUs(6);
const d = fromDiameter(DEFAULT_DIA);

/* The pre-calibration default, the calibration bounds and the card's own
 * dimensions all come from src/data/calibration.ts. They used to be six
 * separate copies of 3.78 across frontmatter, three input attributes, a CSS
 * declaration and the reset handler, which is exactly the drift CLAUDE.md
 * forbids - and 3.78 was not even the right figure. The CSS spec pins
 * 1in = 96px, so it is 3.7795. */
const DEFAULT_PPM = DEFAULT_PX_PER_MM.toFixed(2);

/* Everything the server prints for the opening mode is derived from the same
 * table the client script uses, so the pre-hydration markup and the first
 * hydrated frame cannot show different numbers. */
const spec = modeSpec(initMeasure, initUnit);

/* The opening source is DERIVED from the opening measure, never chosen
 * separately — see sourceFromMeasure. A page that mounts the tool with
 * measure="circ" is a page about measuring a finger, and it must open saying so
 * rather than telling the visitor to fetch a ring. */
const initSource = sourceFromMeasure(initMeasure);
const initSourceSpec = sourceSpec(initSource);
const initValue = toMode(DEFAULT_DIA, initMeasure, initUnit).toFixed(spec.dp);
const initMin = ceilTo(spec.min, spec.dp);
const initMax = floorTo(spec.max, spec.dp);

const dash = (v: string | number | null) => (v === null ? '—' : String(v));

/* The reference object the drawer opens on. The card, always, on the server:
 * a returning visitor's stored choice is applied on boot, and rendering a
 * guess here would flash the wrong outline at them. */
const initObj = calObject(DEFAULT_CAL_OBJECT);

/* The precision cost, worded from the ratio rather than asserted. The card is
 * 1.00x by definition, so it gets the superlative instead of a multiplier -
 * "1.0x less precise than a card" would be nonsense printed on the card. */
const imprecisionLabel = (mm: number) => {
  const x = imprecisionVsCard(mm);
  return x <= 1 ? 'Most precise' : `≈${x.toFixed(1)}× less precise`;
};


---

<section
  class="ring-sizer w-full"
  aria-labelledby="ring-sizer-heading"
  data-init-measure={initMeasure}
  data-init-unit={initUnit}
>
  <h2 id="ring-sizer-heading" class="sr-only">Interactive ring sizer</h2>

  <!-- ── Step 1: Calibrate Drawer (Collapsible) ────────────────────────── -->
  <!-- `hidden` removed from markup: it must be visible on first paint for anyone
       with no saved calibration, or the whole "accurate because you calibrate
       your own screen" claim is silently false for every new visitor. The
       boot script hides it (and only it) once a valid saved value is found. -->
  <div data-step="calibrate" class="card-elevated mb-6 rounded-2xl border border-border bg-surface p-6 sm:p-8 transition-all">
    <div class="flex items-center justify-between gap-3 mb-4">
      <div class="flex items-center gap-3">
        <span class="flex h-6 w-6 items-center justify-center rounded-full bg-accent text-on-accent text-xs font-bold">1</span>
        <h3 class="text-lg font-semibold text-text">Calibrate Screen Scale</h3>
      </div>
      <!-- min-h-11 is CLAUDE.md's 44px touch target; this was 32. -my-2 keeps the
           header row from growing by the full difference — negative margin pulls
           the neighbours back without shrinking the button's own hit box. -->
      <button data-cal-close type="button" class="-my-2 inline-flex min-h-11 cursor-pointer items-center text-xs text-text-muted hover:text-text underline">
        Close ✕
      </button>
    </div>

    <!-- ── Which object? ───────────────────────────────────────────────
         The card is FIRST and default, and the sub-label on each option is a
         computed precision figure rather than a marketing word. Every coin
         here is under half the card's width, so it roughly doubles the error
         for the same steadiness of hand - `imprecisionVsCard` in
         calibration.ts derives the multiplier and verify-sizes.ts asserts the
         ordering. These options exist for the visitor who has NO card, whose
         alternative is the uncalibrated 96 DPI guess, not for accuracy.

         A picker with a "best" option must say which one that is, or it reads
         as eight equivalent choices and quietly costs precision - the one
         thing this site claims. -->
    <div class="mb-6">
      <h4 id="cal-object-heading" class="text-xs font-semibold uppercase tracking-wide text-text-muted">
        What will you hold against the screen?
      </h4>
      <div role="radiogroup" aria-labelledby="cal-object-heading" class="mt-3 grid gap-2 sm:grid-cols-3">
        {CAL_OBJECTS.map((o) => (
          <button
            type="button" role="radio"
            aria-checked={o.key === initObj.key ? 'true' : 'false'}
            tabindex={o.key === initObj.key ? 0 : -1}
            data-cal-obj-btn={o.key}
            class={o.key === initObj.key ? sourceOn : sourceOff}
          >
            <span class="flex flex-col items-center gap-0.5 leading-tight">
              {/* The {' '} is load-bearing, not formatting. Astro eats the
                  newline between two adjacent inline tags, and the button's
                  accessible name would come out as one run —
                  "US quarter≈2.2× less precise". `npm run sweep` fails the
                  build on exactly this shape, which is how it was caught. */}
              <span>{o.label}</span>{' '}
              <span class="text-[10px] font-normal text-text-faint">{imprecisionLabel(o.mm)}</span>
            </span>
          </button>
        ))}
      </div>
    </div>

    <div class="grid gap-6 md:grid-cols-[1.1fr_0.9fr] md:items-center">
      <div>
        <p data-cal-hint class="text-sm text-text-muted leading-relaxed">{initObj.hint}</p>
        <!-- Provenance in the UI, not just in a source comment. Every figure
             the drawer matches against traces to a governing standard, and a
             visitor who wants to check one should not have to read the repo. -->
        <p class="mt-2 text-xs text-text-faint">
          Size from <span data-cal-source class="font-medium">{initObj.source}</span>
        </p>

        <div class="mt-5 rounded-xl border border-border bg-surface-sunk/50 p-4">
          <div class="flex items-center justify-between text-xs text-text-muted mb-2 font-medium">
            <span>Match outline to card</span>
            <span class="font-mono"><span data-readout data-cal-val>{DEFAULT_PPM}</span> px/mm</span>
          </div>
          <div class="flex items-center gap-3">
            <label class="sr-only" for="cal-range">Match outline to card, pixels per millimetre</label>
            <input
              id="cal-range" data-cal-range type="range"
              min={PPM_MIN} max={PPM_MAX} step="0.01" value={DEFAULT_PPM}
              class="h-2 w-full cursor-pointer appearance-none rounded-full bg-border-strong/40 accent-[#D4AF37] focus:outline-none"
            />
            <label class="sr-only" for="cal-num">Pixels per millimetre, exact value</label>
            <input
              id="cal-num" data-cal-num type="number" inputmode="decimal"
              min={PPM_MIN} max={PPM_MAX} step="0.01" value={DEFAULT_PPM}
              class="h-9 w-20 shrink-0 rounded-lg border border-border bg-surface px-2 text-right text-sm text-text"
            />
          </div>
        </div>

        <div class="mt-5 flex flex-wrap items-center gap-3">
          <button data-cal-save type="button" class="h-11 cursor-pointer rounded-xl bg-accent px-5 text-xs font-semibold text-on-accent hover:bg-accent-hover transition-all shadow-xs">
            Save Scale
          </button>
          <button data-cal-reset type="button" class="h-11 cursor-pointer rounded-xl border border-border px-4 text-xs font-medium text-text-muted hover:text-text transition-colors">
            Reset
          </button>
        </div>
      </div>

      <!-- The reference outline, at two sizes, because a whole ID-1 card does
           not fit on a phone. At a real phone's ~6.1 px/mm the full card is
           329 x 522 px: wider than the padded column and taller than the
           viewport, so the visitor could not see both edges at once and the
           page scrolled sideways. Only the WIDTH is ever matched (the copy
           above says so), so the narrow layout shows the width alone as a
           dimension gauge and drops the 85.6 mm height that caused the trouble.

           Negative margins cancel this drawer's own padding so the gauge gets
           the full column, and overflow-x is the backstop above ~6 px/mm: the
           gauge scrolls inside its own box rather than pushing the page, which
           CLAUDE.md forbids outright. -->
      <!-- order-first on narrow screens, and it is not cosmetic. The visitor has
           to hold a physical card flat against the gauge while dragging the
           slider, and a card is 85.6 mm wide — wider than the phone screen. With
           the gauge below the slider the card lies across the control it is being
           matched with. Gauge on top, controls beneath, thumb free. Desktop keeps
           the two-column layout, where the card is held in the other hand. -->
      <div
        data-cal-shape={initObj.shape}
        class="cal-stage order-first md:order-none -mx-6 sm:-mx-8 md:mx-0 overflow-x-auto rounded-xl md:border md:border-dashed md:border-border md:bg-surface-sunk/50"
      >
        <div class="flex flex-col items-center justify-center px-0 py-2 md:p-6">
          <!-- `contents` so this wrapper adds no box of its own: the two card
               shapes keep the exact layout they were verified in on a real
               phone (31 Aug). display:none on a display:contents box still
               hides its children, which is how the shape switch works. -->
          <div class="cal-edge-wrap contents">

          <!-- Narrow: the same 53.98 mm, measured DOWN the screen instead of
               across it. A phone is about 60 mm wide and 130 mm tall, so the
               card's short edge only ever fits vertically once the screen is
               calibrated — laid across, it needs 432 px at the 8 px/mm ceiling
               and there is nowhere near that much width. Turned 90° it fits at
               every calibration with room to spare, and the card does not care
               which way up it is held. -->
          <div data-cal-gauge class="md:hidden shrink-0">
            <div class="cal-gauge relative mx-auto flex items-center justify-center rounded-lg border border-dashed border-accent bg-accent-sunk/30">
              <span class="cal-gauge-tick top-0"></span>
              <span class="cal-gauge-tick bottom-0"></span>
              <span class="cal-gauge-rule"></span>
              <span class="relative z-10 bg-surface px-1 text-[10px] font-mono text-accent-text pointer-events-none select-none">53.98 mm</span>
            </div>
            <p class="mt-3 max-w-[22rem] text-center text-[11px] text-text-faint">
              Hold a bank card against the screen and line its <strong class="text-text-muted">short edge</strong> up between the two bars
            </p>
          </div>

          <!-- Wide: the whole card, where there is room for it. -->
          <div data-cal-card class="hidden md:flex flex-col items-center">
            <div
              data-card
              class="cal-card flex items-center justify-center border-2 border-dashed border-accent bg-accent-sunk/30 transition-all shadow-xs"
            >
              <span class="text-xs font-medium text-accent-text text-center px-2 pointer-events-none select-none">
                Standard Bank Card<br/><span class="text-[10px] text-text-faint font-mono">53.98 mm</span>
              </span>
            </div>
            <p class="mt-3 text-[11px] text-text-faint font-mono">1:1 Physical Scale Outline</p>
          </div>
          </div>

          <!-- Coins need no breakpoint trick. The card's short edge is 432 px
               at the 8 px/mm ceiling, which is why the narrow layout has to
               rotate it; the largest coin here is 194 px at the same ceiling
               and fits any viewport upright, so one shape serves both. -->
          <div class="cal-disc-wrap hidden flex-col items-center">
            <div
              data-cal-disc
              class="cal-disc flex items-center justify-center border-2 border-dashed border-accent bg-accent-sunk/30 transition-all shadow-xs"
            >
              <span data-cal-disc-mm class="text-[10px] font-mono text-accent-text pointer-events-none select-none"></span>
            </div>
            <p class="mt-3 max-w-[22rem] text-center text-[11px] text-text-faint">
              Lay the coin flat on the screen and match the circle to its <strong class="text-text-muted">outer edge</strong>
            </p>
          </div>

        </div>
      </div>
    </div>
  </div>

  <!-- ── Main Interactive Instrument Card ──────────────────────────────── -->
  <div data-step="measure" class="card-elevated rounded-2xl border border-border bg-surface p-6 sm:p-10 md:p-12 shadow-sm">
    <!-- ── The first question: what the visitor HAS ─────────────────────
         This card used to open on the two switchers below — "Diameter or
         Circumference? MM, CM or Inches?" — and that is the wrong first
         question however good the six modes behind it are. It presupposes a
         measurement. Someone holding a ring and nothing else cannot answer it,
         and the sentence they needed ("lay it on the circle") was ~150 lines
         down the homepage, outside the tool. Every competitor that ranks for
         `ring sizer` opens with the object instead. SEO-AUDIT.md §2 P2.

         The switchers are DEMOTED, not removed. They keep every capability
         they had, they stay operable under all three sources, and the source
         merely pre-sets `measure` to the thing that source actually produces —
         a ring matched at its inner edge is a diameter, a paper strip is a
         circumference. Picking wrong costs one click. -->
    <div class="mx-auto max-w-2xl">
      <h3 id="source-heading" class="text-center text-lg font-semibold text-text">What do you have?</h3>

      <div role="radiogroup" aria-labelledby="source-heading" class="mt-4 grid gap-2 sm:grid-cols-3">
        {SOURCES.map((src) => (
          <button
            type="button" role="radio"
            aria-checked={src.key === initSource ? 'true' : 'false'}
            tabindex={src.key === initSource ? 0 : -1}
            data-source-btn={src.key}
            class={src.key === initSource ? sourceOn : sourceOff}
          >
            {src.label}
          </button>
        ))}
      </div>

      <p data-source-hint class="mt-4 text-center text-sm leading-relaxed text-text-muted">{initSourceSpec.hint}</p>

      <!-- ── The on-screen ruler ──────────────────────────────────────────
           Shown on the paper-strip route only, because it is the only route
           where there is a strip to measure. "Measure it flat against a
           ruler" quietly assumed the visitor owns one; this is that ruler,
           drawn at the calibration they already gave us.

           A scale to READ, not a control to drag — see the note in
           calibration.ts. The strip is held flat against the glass with one
           hand, so a draggable marker would need a second hand arriving from
           the side with the fingertip covering the very mark it is aligning
           to. The number goes into the field directly below, which already
           has keyboard and screen-reader behaviour worth inheriting.

           `hidden` in the markup, not a class: this element has no breakpoint
           utilities of its own, so nothing outranks it in the cascade and the
           attribute is the honest way to say "not applicable right now". -->
      <div data-ruler hidden class="mt-5">
        <div class="rounded-xl border border-border bg-surface-sunk/40 px-4 py-4">
          <p class="text-center text-xs leading-relaxed text-text-muted">
            Lay the strip flat on the screen with its end at <strong class="text-text">0</strong>, then read the number at your mark and type it in below.
          </p>

          <div class="mt-3 flex justify-center overflow-x-auto">
            <!-- aria-hidden, and deliberately. This is a picture of a ruler:
                 a visitor who cannot see it cannot lay a strip against it
                 either, and reading out "0 10 20 30 40 50 60 70 80" would be
                 noise in place of the instruction above, which is not
                 hidden. -->
            <div class="ruler shrink-0" aria-hidden="true">
              {RULER_LABELS.map((n) => (
                <span class="ruler-label" style={`--at:${n}`}>{n}</span>
              ))}
            </div>
          </div>

          <p class="mt-3 text-center text-[11px] text-text-faint">
            Millimetres, at true scale on this screen. <span data-ruler-cal>Calibrate first, or these are a guess.</span>
          </p>
        </div>
      </div>
    </div>

    <!-- Two switchers, because these are two independent questions: what you
         measured, and what unit you want it in. One combined row of four made
         circumference look like a unit and left it stuck in millimetres.

         They also finally carry a VISIBLE label. Both groups were announced to
         assistive tech via aria-label and were unlabelled for everyone else.

         ⚠️ One label above BOTH, not one each. Per-group labels were tried and
         measured at 375px: "You measured" is 82px, its pill group 216px, and
         the row is 277px — so that pair wrapped while "in" + the unit pills
         (212px) did not, leaving one group's label stacked and the other's
         inline. A single centred line naming the two groups in the order they
         appear cannot wrap into that asymmetry at any width, and "Or set"
         carries the demotion in words. -->
    <div class="mt-8 border-t border-border/60 pt-6">
      <p class="text-center text-xs font-medium text-text-faint">Or set what you measured, and its unit</p>
      <div class="mt-3 flex flex-wrap items-center justify-center gap-3">
        <div role="radiogroup" aria-label="What you measured" class="inline-flex flex-wrap justify-center rounded-full bg-surface-sunk p-1 border border-border/80 shadow-inner gap-1">
          {MEASURES.map((m) => (
            <button
              type="button" role="radio"
              aria-checked={m.key === initMeasure ? 'true' : 'false'}
              tabindex={m.key === initMeasure ? 0 : -1}
              data-measure-btn={m.key}
              class={m.key === initMeasure ? pillOn : pillOff}
            >
              {m.short}
            </button>
          ))}
        </div>

        <div role="radiogroup" aria-label="Units" class="inline-flex flex-wrap justify-center rounded-full bg-surface-sunk p-1 border border-border/80 shadow-inner gap-1">
          {UNITS.map((u) => (
            <button
              type="button" role="radio"
              aria-checked={u.key === initUnit ? 'true' : 'false'}
              tabindex={u.key === initUnit ? 0 : -1}
              data-unit-btn={u.key}
              class={u.key === initUnit ? pillOn : pillOff}
            >
              {u.short}
            </button>
          ))}
        </div>
      </div>
    </div>

    <!-- 2-Column Main Instrument Grid -->
    <div class="mt-10 grid gap-10 md:grid-cols-[1fr_1.15fr] md:items-center">

      <!-- Left Column: Interactive Ring Circle Guide & Live Readout -->
      <div class="flex flex-col items-center justify-center">

        <!-- The stage has always been the input for the ring route and has never
             said so. Graph paper, crosshairs and a life-size circle read as
             decoration without a caption, which is most of why the tool looked
             like a converter rather than a sizer. Sibling of the stage, not a
             child: the stage is overflow-hidden and its top-centre is already
             occupied by a crosshair tick. Hidden outright for the two sources
             where the stage is not what the visitor is touching — a caption
             that stays put while its instruction stops applying is worse than
             none. -->
        <p
          data-stage-caption
          hidden={initSourceSpec.stageCaption === null}
          class="mb-3 text-center text-xs font-medium text-accent-text"
        >{initSourceSpec.stageCaption}</p>

        <div data-ring-stage class="ring-stage relative flex h-64 w-64 sm:h-72 sm:w-72 items-center justify-center overflow-hidden rounded-xl">

          <!-- Graph paper at TRUE scale: 1 mm minor, 5 mm major. Cell size is
               driven by the same calibration value that sizes the ring circle,
               so counting squares gives the real measurement rather than a
               decorative one. -->
          <div class="ring-grid absolute inset-0 pointer-events-none" aria-hidden="true"></div>

          <!-- Crosshair tick marks: a centre reference for laying a ring on the
               stage. The edge ticks stay; the dashed guide circle that used to
               sit at inset-3 has been REMOVED and must not come back.

               It was a fixed 232 px ring — 61 mm at the default scale — drawn
               around a ring that is physically 13-24 mm. Measured 31 Aug 2026,
               the real ring filled 21% of it at the slider's bottom and 40% at
               the top, so it could never fill the guide it appeared to be a
               guide for. A visitor reads that as "the tool is drawing my ring
               too small", when the truth is the opposite: the ring is life-size
               and the guide was not. The fix is never to enlarge the ring, which
               would forfeit the site's only real claim; it is to stop drawing
               something the ring is supposed to match and cannot. The grid and
               the 10 mm legend already prove the scale is real, and the marker
               under the readout now says so in words. -->
          <div class="absolute left-1 top-1/2 -translate-y-1/2 w-4 h-px bg-border-strong"></div>
          <div class="absolute right-1 top-1/2 -translate-y-1/2 w-4 h-px bg-border-strong"></div>
          <div class="absolute top-1 left-1/2 -translate-x-1/2 h-4 w-px bg-border-strong"></div>
          <div class="absolute bottom-1 left-1/2 -translate-x-1/2 h-4 w-px bg-border-strong"></div>

          <!-- Scalable Golden Ring Circle -->
          <div
            data-ring-circle
            class="ring-circle rounded-full border-accent transition-all duration-75"
            style="width:62.4px;height:62.4px"
          ></div>

          <!-- Scale legend: proves the grid is real rather than decorative -->
          <div class="absolute bottom-2 left-2 flex items-center gap-2">
            <div class="ring-scale-bar h-1.5 border-x border-b border-border-strong"></div>
            <span class="text-xs text-text-faint">10 mm</span>
          </div>
        </div>

        <!-- Big Readout Underneath -->
        <div class="mt-4 text-center">
          <div class="font-display text-3xl sm:text-4xl font-semibold tracking-tight text-accent">
            <span data-readout data-main-val>{initValue}</span> <span data-main-unit class="text-2xl font-normal text-text-muted">{spec.unitLabel}</span>
          </div>
          <p data-main-label class="mt-1 text-xs uppercase tracking-wider text-text-faint font-medium">
            {spec.label}
          </p>

          <!-- Scale marker. The site's whole argument is that the ring above is
               life-size on THIS screen, and once the calibrate drawer closes
               nothing said so. It is deliberately two-state: before a saved
               calibration exists the tool is running on a guessed starting scale
               (see startingPpm), and claiming 1:1 then would be exactly the kind
               of confident-and-wrong the rest of this file exists to avoid. A
               better guess is still a guess. Server-rendered in
               the uncalibrated state because that is what a first-load visitor
               with no stored value actually has. -->
          <!-- NOT inline-flex. It was, and on a phone the longer two-line message
               left the icon stranded at the far left, a hundred pixels from its
               own text (owner's screenshot, 31 Aug): the flex text span took the
               full width and centred its text inside itself, so line one pulled
               away from the icon. Plain inline flow instead — the icon is just the
               first thing in a centred paragraph, so both lines centre together
               and the icon stays against the first word at every width.
               The space between the two spans is load-bearing; keep them on one
               source line or Astro eats it. -->
          <p data-scale-marker data-calibrated="false" class="mt-3 text-xs font-medium leading-relaxed">
            <span data-scale-icon class="font-mono text-text-faint" aria-hidden="true">&mdash;</span> <span data-scale-text class="text-text-faint">Not calibrated yet &mdash; sizes assume a standard screen</span>
          </p>
        </div>
      </div>

      <!-- Right Column: Slider with Step Buttons & 2x2 Country Size Grid -->
      <div class="flex flex-col justify-center">
        <!-- Slider Control Area -->
        <div class="mb-8">
          <div class="flex items-center justify-between text-xs font-mono text-text-muted mb-2 font-medium">
            <span data-min-label>{`${initMin} ${spec.unitLabel}`}</span>
            <span data-max-label>{`${initMax} ${spec.unitLabel}`}</span>
          </div>

          <div class="flex items-center gap-3">
            <button
              type="button"
              data-step-btn="minus"
              class="flex h-11 w-11 sm:h-9 sm:w-9 cursor-pointer items-center justify-center rounded-lg border border-border bg-surface-sunk text-text-muted hover:border-accent hover:text-text active:scale-95 transition-all text-base font-bold select-none"
              title="Decrease size"
            >
              −
            </button>

            <div class="relative flex-1">
              <label class="sr-only" for="ring-range">Ring size slider</label>
              <input
                id="ring-range"
                data-ring-range
