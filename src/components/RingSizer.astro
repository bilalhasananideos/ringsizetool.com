---
/**
 * The tool. Everything runs in the browser — nothing is uploaded.
 *
 * Two steps: calibrate the screen against a bank card, then measure.
 * Calibration is stored per-device so repeat visits skip step 1.
 *
 * The calibration outline is PORTRAIT (card held upright). A landscape card
 * outline is 85.6 mm across, which is ~324 px at the CSS default and wider
 * than the content column on a 375 px phone — the right-hand edge gets clipped
 * and the user cannot match it. Upright, the constrained dimension is 53.98 mm
 * (~204 px) and it fits. The wrapper is also full-bleed and scrollable, because
 * on a narrow phone the card legitimately occupies most of the screen width.
 */
import { INDIA_NOTE, UK_NOTE } from '../data/ringSizes';
---

<section class="ring-sizer" aria-labelledby="tool-heading">
  <h2 id="tool-heading" class="sr-only">Ring size tool</h2>

  <!-- ── Step 1: calibrate ───────────────────────────────────────────── -->
  <div data-step="calibrate" class="rounded-xl border border-border bg-surface p-5 sm:p-7">
    <h3 class="text-lg font-semibold">Step 1 · Calibrate your screen</h3>

    <p class="mt-3 max-w-[62ch] text-text-muted">
      Hold any bank card <strong class="text-text">upright</strong> against the screen — short edge
      at the top — and drag the slider until the outline matches it exactly. Every card is
      85.60&nbsp;×&nbsp;53.98&nbsp;mm (ISO/IEC&nbsp;7810&nbsp;ID-1), so this tells us how many
      pixels your screen puts in a millimetre.
    </p>

    <!-- Full-bleed on mobile: the card is ~84% of a phone's physical width, which
         is wider than the padded column. Scrolls rather than clips, as a backstop. -->
    <div class="mt-6 -mx-5 overflow-x-auto px-5 sm:mx-0 sm:px-0">
      <div
        data-card
        class="rounded-lg border-2 border-dashed border-accent bg-accent-sunk/40"
        style="width:204px;aspect-ratio:53.98/85.6"
      >
        <span class="sr-only">
          Calibration outline for a bank card held upright, 53.98 millimetres wide
          by 85.6 millimetres tall.
        </span>
      </div>
    </div>

    <div class="mt-6 max-w-md">
      <label for="cal-range" class="block text-sm font-medium">Match the outline to your card</label>
      <input
        id="cal-range" data-cal-range type="range"
        min="2.5" max="7" step="0.01" value="3.78"
        class="mt-2 h-11 w-full accent-[var(--accent)]"
        aria-describedby="cal-hint"
      />
      <div class="mt-2 flex flex-wrap items-center gap-3">
        <label for="cal-num" class="text-sm text-text-muted">Pixels per mm</label>
        <input
          id="cal-num" data-cal-num type="number" inputmode="decimal" autocomplete="off"
          min="2.5" max="7" step="0.01" value="3.78"
          class="h-11 w-28 rounded-lg border border-border bg-surface px-3 text-text"
        />
      </div>
      <p id="cal-hint" class="mt-2 text-sm text-text-faint">
        Type a value if you already know your screen's scale.
      </p>
    </div>

    <div class="mt-5 flex flex-wrap gap-3">
      <button data-cal-save type="button"
        class="h-11 rounded-lg bg-accent px-5 font-medium text-surface transition-colors duration-150 hover:bg-accent-hover">
        The outline matches
      </button>
      <button data-cal-skip type="button"
        class="h-11 rounded-lg border border-border-strong px-5 transition-colors duration-150 hover:border-accent">
        Skip — I know my diameter
      </button>
    </div>

    <p class="mt-4 text-sm text-text-faint">
      Keep your browser zoom at 100%. Zooming after calibrating will make the result wrong.
    </p>
  </div>

  <!-- ── Step 2: measure ─────────────────────────────────────────────── -->
  <div data-step="measure" hidden class="mt-5 rounded-xl border border-border bg-surface p-5 sm:p-7">
    <h3 class="text-lg font-semibold">Step 2 · Measure</h3>

    <!-- The saved calibration must stay visible. Someone who calibrated on a
         phone and returns on a laptop would otherwise get a silently wrong
         answer with no cue that a stale scale is in use. -->
    <p class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm">
      <span class="text-text-muted">
        Using <span data-readout data-cal-status>3.78</span> px/mm on this device.
      </span>
      <button data-recal type="button" class="text-accent-text underline underline-offset-2">
        Re-calibrate
      </button>
    </p>

    <fieldset class="mt-5">
      <legend class="text-sm font-medium">How do you want to measure?</legend>
      <div class="mt-2 flex flex-wrap gap-2">
        <label class="method-chip">
          <input type="radio" name="method" value="ring" checked class="sr-only" />
          <span>I have a ring</span>
        </label>
        <label class="method-chip">
          <input type="radio" name="method" value="finger" class="sr-only" />
          <span>Measure my finger</span>
        </label>
        <label class="method-chip">
          <input type="radio" name="method" value="known" class="sr-only" />
          <span>I know the size</span>
        </label>
      </div>
    </fieldset>

    <!-- Ring on screen -->
    <div data-panel="ring" class="mt-6">
      <p class="max-w-[62ch] text-text-muted">
        Place a ring that already fits on the screen and adjust the circle until it sits exactly
        inside the ring's <strong class="text-text">inner</strong> edge.
      </p>
      <div class="mt-6 grid place-items-center rounded-lg bg-surface-sunk py-8">
        <div data-ring-circle class="rounded-full border-2 border-accent" style="width:62px;height:62px"></div>
      </div>
      <div class="mt-6 flex flex-wrap items-end gap-4">
        <div class="min-w-[12rem] flex-1">
          <label for="ring-range" class="block text-sm font-medium">Circle size</label>
          <input id="ring-range" data-ring-range type="range" min="11" max="25" step="0.05" value="16.5"
            class="mt-2 h-11 w-full accent-[var(--accent)]" />
        </div>
        <div>
          <label for="ring-num" class="block text-sm font-medium">Diameter</label>
          <div class="mt-2 flex items-center gap-2">
            <input id="ring-num" data-ring-num type="number" inputmode="decimal" autocomplete="off" min="11" max="25" step="0.05" value="16.5"
              class="h-11 w-24 rounded-lg border border-border bg-surface px-3 text-text" />
            <span class="text-sm text-text-muted">mm</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Paper strip -->
    <div data-panel="finger" hidden class="mt-6">
      <p class="max-w-[62ch] text-text-muted">
        Wrap a strip of paper snugly around the base of your finger, mark where it overlaps, then
        measure the flat strip.
      </p>
      <div class="mt-5 flex flex-wrap items-end gap-3">
        <div>
          <label for="circ-input" class="block text-sm font-medium">Strip length</label>
          <input id="circ-input" data-circ-input type="number" inputmode="decimal" autocomplete="off" min="30" max="90" step="0.1" value="51.9"
            class="mt-2 h-11 w-40 rounded-lg border border-border bg-surface px-3 text-text" />
        </div>
        <div>
          <label for="circ-unit" class="block text-sm font-medium">Unit</label>
          <select id="circ-unit" data-circ-unit class="mt-2 h-11 rounded-lg border border-border bg-surface px-3 text-text">
            <option value="mm">millimetres</option>
            <option value="cm">centimetres</option>
            <option value="in">inches</option>
          </select>
        </div>
      </div>
    </div>

    <!-- Known diameter -->
    <div data-panel="known" hidden class="mt-6">
      <p class="max-w-[62ch] text-text-muted">
        Measure straight across the inside of a ring you own, from inner edge to inner edge.
      </p>
      <div class="mt-5 flex flex-wrap items-end gap-3">
        <div>
          <label for="dia-input" class="block text-sm font-medium">Inner diameter</label>
          <input id="dia-input" data-dia-input type="number" inputmode="decimal" autocomplete="off" min="11" max="25" step="0.01" value="16.51"
            class="mt-2 h-11 w-40 rounded-lg border border-border bg-surface px-3 text-text" />
        </div>
        <div>
          <label for="dia-unit" class="block text-sm font-medium">Unit</label>
          <select id="dia-unit" data-dia-unit class="mt-2 h-11 rounded-lg border border-border bg-surface px-3 text-text">
            <option value="mm">millimetres</option>
            <option value="in">inches</option>
          </select>
        </div>
      </div>
    </div>
  </div>

  <!-- ── Result ──────────────────────────────────────────────────────── -->
  <div data-step="result" hidden class="mt-5 rounded-xl border border-border bg-surface p-5 sm:p-7">
    <h3 class="text-sm font-medium tracking-wide text-text-muted uppercase">Your ring size</h3>

    <!-- Out-of-range input must not leave the previous, now-wrong, numbers up. -->
    <p data-error hidden class="mt-3 rounded-lg border border-danger px-4 py-3 text-danger">
      That measurement is outside the range this tool covers (11–25&nbsp;mm inner diameter).
      Check the number and the unit.
    </p>

    <div data-results>
      <p class="mt-2 flex items-baseline gap-3">
        <span data-readout data-out-us class="text-[clamp(2.5rem,8vw,4rem)] leading-none text-accent">6</span>
        <span class="text-lg text-text-muted">US / Canada</span>
      </p>

      <p data-out-context class="mt-3 max-w-[60ch] text-text-muted"></p>

      <!-- Reachable: the slider bottoms out at 11 mm, below the smallest size
           any of the seven systems defines (US 0 is 11.63 mm). Every cell is an
           em dash there, which needs saying rather than just looking broken. -->
      <p data-below-range hidden class="mt-3 max-w-[60ch] text-text-muted">
        That is smaller than the smallest size any of these systems defines — the US scale starts
        at 11.63&nbsp;mm. The diameter and circumference below are still exact.
      </p>

      <fieldset class="mt-3">
        <legend class="sr-only">Compare against the average for</legend>
        <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm">
          <span class="text-text-faint">Compare with the average for</span>
          <label class="flex items-center gap-2">
            <input type="radio" name="who" value="women" checked class="accent-[var(--accent)]" />
            <span>women</span>
          </label>
          <label class="flex items-center gap-2">
            <input type="radio" name="who" value="men" class="accent-[var(--accent)]" />
            <span>men</span>
          </label>
        </div>
      </fieldset>

      <div class="table-scroll mt-7">
        <table class="w-full min-w-[34rem] text-left text-sm">
          <caption class="sr-only">Your size in every international system</caption>
          <thead>
            <tr class="bg-surface-sunk">
              <th scope="col" class="rounded-l-lg px-3 py-2 font-medium">UK / AU</th>
              <th scope="col" class="px-3 py-2 font-medium">EU / ISO</th>
              <th scope="col" class="px-3 py-2 font-medium">Japan</th>
              <th scope="col" class="px-3 py-2 font-medium">India</th>
              <th scope="col" class="px-3 py-2 font-medium">FR / IT / ES</th>
              <th scope="col" class="rounded-r-lg px-3 py-2 font-medium">Brazil</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-t border-border" data-readout>
              <td class="px-3 py-3" data-out-uk>—</td>
              <td class="px-3 py-3" data-out-eu>—</td>
              <td class="px-3 py-3" data-out-jp>—</td>
              <td class="px-3 py-3" data-out-in>—</td>
              <td class="px-3 py-3" data-out-fr>—</td>
              <td class="px-3 py-3" data-out-br>—</td>
            </tr>
          </tbody>
        </table>
      </div>

      <dl class="mt-7 grid grid-cols-2 gap-x-6 gap-y-4 sm:grid-cols-4">
        <div>
          <dt class="text-sm text-text-muted">Diameter</dt>
          <dd data-readout data-out-dia-mm class="mt-0.5">—</dd>
        </div>
        <div>
          <dt class="text-sm text-text-muted">Diameter (in)</dt>
          <dd data-readout data-out-dia-in class="mt-0.5">—</dd>
        </div>
        <div>
          <dt class="text-sm text-text-muted">Circumference</dt>
          <dd data-readout data-out-circ-mm class="mt-0.5">—</dd>
        </div>
        <div>
          <dt class="text-sm text-text-muted">Circumference (in)</dt>
          <dd data-readout data-out-circ-in class="mt-0.5">—</dd>
        </div>
      </dl>
    </div>

    <!-- Announced instead of the live-updating cells, which would spam a
         screen reader on every slider step. -->
    <p data-live aria-live="polite" class="sr-only"></p>

    <p class="mt-7 rounded-lg border border-border bg-surface-sunk p-4 text-sm text-text-muted">
      <strong class="text-text">This is an estimate.</strong> Accuracy depends on your screen,
      browser zoom and how carefully you align things. For an engagement ring or anything that
      cannot be resized, confirm with a jeweller before buying.
      <span class="mt-2 block" data-uk-note hidden>
        <strong class="text-text">On the UK letter:</strong> {UK_NOTE}
      </span>
      <span class="mt-2 block" data-india-note hidden>
        <strong class="text-text">On the Indian size:</strong> {INDIA_NOTE}
      </span>
    </p>
  </div>
</section>

<style>
  /* Method chooser. A radio group rather than an ARIA tablist: arrow-key
     navigation, focus and checked state all come from the browser, and the
     selected state is correct before JavaScript runs. */
  .method-chip span {
    display: block;
    min-height: 2.75rem;
    padding: 0 1rem;
    line-height: 2.75rem;
    font-size: 0.875rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text-muted);
    cursor: pointer;
    transition: border-color 120ms ease-out, background-color 120ms ease-out;
  }
  .method-chip input:checked + span {
    border-color: var(--accent);
    background: var(--accent-sunk);
    color: var(--text);
  }
  .method-chip input:focus-visible + span {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .method-chip span:hover { border-color: var(--border-strong); }
</style>

<script>
  import { fromDiameter, sizeContext, MM_PER_INCH } from '../data/ringSizes';

  const root = document.querySelector<HTMLElement>('.ring-sizer');
  if (root) {
    const $ = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel)!;

    const CARD_SHORT_MM = 53.98;   // ISO/IEC 7810 ID-1, held upright
    const STORE = 'rst.pxPerMm';
    const PPM_MIN = 2.5;
    const PPM_MAX = 7;
    const DIA_MIN = 11;
    const DIA_MAX = 25;

    const stepCal = $('[data-step="calibrate"]');
    const stepMeasure = $('[data-step="measure"]');
    const stepResult = $('[data-step="result"]');
    const card = $<HTMLElement>('[data-card]');
    const calRange = $<HTMLInputElement>('[data-cal-range]');
    const calNum = $<HTMLInputElement>('[data-cal-num]');
    const ringRange = $<HTMLInputElement>('[data-ring-range]');
    const ringNum = $<HTMLInputElement>('[data-ring-num]');
    const ringCircle = $<HTMLElement>('[data-ring-circle]');
    const errorBox = $('[data-error]');
    const resultsBox = $('[data-results]');
    const liveBox = $('[data-live]');

    let pxPerMm = 3.78;                       // 96 CSS DPI, the usual default
    let mode: 'ring' | 'finger' | 'known' = 'ring';
    let who: 'women' | 'men' = 'women';

    const store = {
      get(): number | null {
        try {
          const v = parseFloat(localStorage.getItem(STORE) ?? '');
          // Anything outside the slider's own range is corrupt or came from a
          // different build. Reject it rather than letting the slider clamp
          // while pxPerMm silently keeps the bad value.
          return Number.isFinite(v) && v >= PPM_MIN && v <= PPM_MAX ? v : null;
        } catch { return null; }
      },
      set(v: number) { try { localStorage.setItem(STORE, String(v)); } catch { /* blocked */ } },
    };

    /* ── calibration ── */
    function setPxPerMm(v: number) {
      pxPerMm = Math.min(PPM_MAX, Math.max(PPM_MIN, v));
      card.style.width = `${CARD_SHORT_MM * pxPerMm}px`;
      const s = pxPerMm.toFixed(2);
      if (calRange.value !== s) calRange.value = s;
      if (document.activeElement !== calNum) calNum.value = s;
      $('[data-cal-status]').textContent = s;
    }

    calRange.addEventListener('input', () => setPxPerMm(parseFloat(calRange.value)));
    calNum.addEventListener('input', () => {
      const v = parseFloat(calNum.value);
      if (Number.isFinite(v)) setPxPerMm(v);
    });

    function showMeasure() {
      stepCal.hidden = true;
      stepMeasure.hidden = false;
      stepResult.hidden = false;
      update();
    }

    $('[data-cal-save]').addEventListener('click', () => {
      store.set(pxPerMm);
      showMeasure();
    });

    $('[data-cal-skip]').addEventListener('click', () => {
      showMeasure();
      selectMode('known');
    });

    $('[data-recal]').addEventListener('click', () => {
      stepCal.hidden = false;
      stepMeasure.hidden = true;
      stepResult.hidden = true;
      stepCal.scrollIntoView({ block: 'start' });
    });

    /* ── method chooser ── */
    function selectMode(next: typeof mode) {
      mode = next;
      const radio = root.querySelector<HTMLInputElement>(`input[name="method"][value="${next}"]`);
      if (radio) radio.checked = true;
      root.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => {
        p.hidden = p.dataset.panel !== next;
      });
      update();
    }

    root.querySelectorAll<HTMLInputElement>('input[name="method"]').forEach((r) =>
      r.addEventListener('change', () => selectMode(r.value as typeof mode)),
    );

    root.querySelectorAll<HTMLInputElement>('input[name="who"]').forEach((r) =>
      r.addEventListener('change', () => { who = r.value as typeof who; update(); }),
    );

    /* ── keep the ring slider and its number field in step ── */
    function setRingDiameter(v: number, from: 'range' | 'num') {
      const s = v.toFixed(2).replace(/\.?0+$/, '');
      if (from !== 'range') ringRange.value = String(v);
      if (from !== 'num') ringNum.value = s;
    }

    ringRange.addEventListener('input', () => {
      setRingDiameter(parseFloat(ringRange.value), 'range');
      update();
    });
    ringNum.addEventListener('input', () => {
      const v = parseFloat(ringNum.value);
      if (Number.isFinite(v)) setRingDiameter(v, 'num');
      update();
    });

    /* ── measurement ── */
    function currentDiameterMm(): number {
      if (mode === 'ring') return parseFloat(ringNum.value);

      if (mode === 'finger') {
        const raw = parseFloat($<HTMLInputElement>('[data-circ-input]').value);
        const unit = $<HTMLSelectElement>('[data-circ-unit]').value;
        const mm = unit === 'cm' ? raw * 10 : unit === 'in' ? raw * MM_PER_INCH : raw;
        return mm / Math.PI;
      }

      const raw = parseFloat($<HTMLInputElement>('[data-dia-input]').value);
      return $<HTMLSelectElement>('[data-dia-unit]').value === 'in' ? raw * MM_PER_INCH : raw;
    }

    let liveTimer: ReturnType<typeof setTimeout> | undefined;
    function announce(text: string) {
      clearTimeout(liveTimer);
      liveTimer = setTimeout(() => { liveBox.textContent = text; }, 500);
    }

    const dash = (v: string | number | null) => (v === null ? '—' : String(v));

    function update() {
      const d = currentDiameterMm();
      const valid = Number.isFinite(d) && d >= DIA_MIN && d <= DIA_MAX;

      errorBox.hidden = valid;
      resultsBox.hidden = !valid;
      if (!valid) {
        announce('That measurement is outside the range this tool covers.');
        return;
      }

      if (mode === 'ring') {
        const px = d * pxPerMm;
        ringCircle.style.width = `${px}px`;
        ringCircle.style.height = `${px}px`;
      }

      const r = fromDiameter(d);
      const set = (sel: string, v: string) => { $(sel).textContent = v; };

      set('[data-out-us]', dash(r.us));
      set('[data-out-uk]', dash(r.uk));
      set('[data-out-eu]', dash(r.eu));
      set('[data-out-jp]', dash(r.jp));
      set('[data-out-in]', dash(r.in));
      set('[data-out-fr]', dash(r.fr));
      set('[data-out-br]', dash(r.br));
      set('[data-out-dia-mm]', `${r.diameterMm.toFixed(2)} mm`);
      set('[data-out-dia-in]', `${r.diameterIn.toFixed(3)} in`);
      set('[data-out-circ-mm]', `${r.circumferenceMm.toFixed(2)} mm`);
      set('[data-out-circ-in]', `${r.circumferenceIn.toFixed(3)} in`);
      set('[data-out-context]', sizeContext(r.usNumeric, who));

      $('[data-below-range]').hidden = !(r.us === null && r.uk === null && r.eu === null);
      $('[data-uk-note]').hidden = r.uk === null;
      $('[data-india-note]').hidden = r.in === null;

      announce(
        `US size ${dash(r.us)}. UK ${dash(r.uk)}, EU ${dash(r.eu)}, Japan ${dash(r.jp)}, ` +
        `India ${dash(r.in)}. Inner diameter ${r.diameterMm.toFixed(2)} millimetres.`,
      );
    }

    root.querySelectorAll('[data-circ-input],[data-circ-unit],[data-dia-input],[data-dia-unit]')
      .forEach((el) => el.addEventListener('input', update));

    /* ── boot ── */
    const saved = store.get();
    setPxPerMm(saved ?? pxPerMm);
    selectMode('ring');
    if (saved) showMeasure();
  }
</script>
