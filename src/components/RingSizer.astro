<style define:vars={{
  calCardMm: `${CARD_SHORT_MM}`,
  calCardLongMm: `${CARD_LONG_MM}`,
  calCornerMm: `${CARD_CORNER_MM}`,
  calDefaultPpm: `${DEFAULT_PX_PER_MM}px`,
  /* The selected object's matched dimension. The server always renders the
   * card; the script rewrites this property on the drawer when the visitor
   * picks another object, so one CSS rule draws every disc. */
  calObjMm: `${initObj.mm}`,
  /* Static — the scale's length never changes, so define:vars stamping it on
   * every element is harmless here. Contrast --calObjMm above, which does. */
  rulerMaxMm: `${RULER_MAX_MM}`,
}}>
  /* --mm is the calibrated CSS pixels per millimetre. This default is the
   * SERVER's, i.e. 96 DPI, because static HTML cannot know the viewport; the
   * calibration control overwrites it on the stage element so the grid, the ring
   * and the readout can never disagree about what a millimetre is.
   *
   * ⚠️ On a narrow screen the script starts at PHONE_PX_PER_MM instead, so an
   * uncalibrated phone visitor DOES see the gauge grow once, on boot, from 204 px
   * to 324 px. That jump is accepted deliberately. The alternative was a media
   * query setting --calDefaultPpm per breakpoint, which removes the jump but
   * leaves the gauge sized for a phone while the "3.78" printed beside it still
   * comes from the server — a page that contradicts itself until JS runs. One
   * honest correction beats a quiet disagreement. See startingPpm. */
  .ring-stage {
    --mm: var(--calDefaultPpm);
  }

  /* ── Calibration reference ──────────────────────────────────────────
   * --cal-mm is the same calibrated pixels-per-millimetre the ring stage
   * uses; the script writes it once on the drawer and both the full card and
   * the narrow gauge derive from it, so they cannot disagree about what a
   * millimetre is. The default matches the CSS spec's own 1in = 96px, which
   * is the right first guess and the wrong answer on nearly every phone. */
  [data-step="calibrate"] {
    --cal-mm: var(--calDefaultPpm);
    /* ⚠️ The selected object's dimension is deliberately NOT --calObjMm here.
     *
     * `define:vars` does not put its variables on the component root — it
     * stamps them as an inline style on EVERY element the template renders.
     * So .cal-disc, its wrapper and the stage all carry
     * `--calObjMm: 53.98` inline, and an element's own inline declaration
     * beats any value inherited from an ancestor. Setting --calObjMm on this
     * drawer from the script therefore changed nothing at all: the picker
     * switched to the quarter and the outline stayed 53.98 mm wide, i.e. it
     * silently drew the wrong reference — measured 204 px where 91.7 was
     * expected.
     *
     * --cal-mm has always worked precisely because it is NOT a define:vars
     * name: no descendant declares it, so inheritance reaches them. This
     * seeds the same pattern for the object — the server's value is read
     * once here, and the script overwrites THIS property. Any future value
     * the script must change needs its own non-define:vars name too. */
    --cal-obj-mm: var(--calObjMm);
  }

  .cal-card {
    width: calc(var(--cal-mm) * var(--calCardMm));
    /* Was the literal `53.98 / 85.6`, which is CARD_SHORT_MM and CARD_LONG_MM
     * retyped into a stylesheet - the exact drift CLAUDE.md forbids and this
     * file's own header warns about. Both now come from the constants. */
    aspect-ratio: var(--calCardMm) / var(--calCardLongMm);
    /* ISO/IEC 7810 radiuses ID-1 corners to 2.88-3.48 mm. Drawing the midpoint
     * of that at the calibrated scale means the outline matches the shape of a
     * real card, not just its width. */
    border-radius: calc(var(--cal-mm) * var(--calCornerMm));
  }

  /* The narrow-viewport reference. Only ONE dimension is ever matched, so the
   * gauge spends its height on the 53.98 mm and its width on being visible:
   * 18 mm, with a floor so it does not become a hairline at low calibrations.
   * Height, not width, because that is the axis a phone has to spare. */
  .cal-gauge {
    height: calc(var(--cal-mm) * var(--calCardMm));
    width: calc(var(--cal-mm) * 18);
    min-width: 3.5rem;
  }

  /* ── The on-screen ruler ───────────────────────────────────────────
   * Its own --mm, defaulted here and overwritten inline by setPxPerMm, the
   * same contract the ring stage and the calibrate drawer use. (--mm is not a
   * define:vars name, so no descendant declares it and inheritance reaches
   * the ticks. That distinction is load-bearing — see the --cal-obj-mm note.)
   */
  [data-ruler] {
    --mm: var(--calDefaultPpm);
  }

  /* The face is drawn, not marked up: three repeating gradients, one per tick
   * tier, each clipped to its own length by background-size. Ticks in the
   * markup would be 80 empty <span>s that assistive tech has to skip and the
   * DOM has to carry, for a graphic nobody can interact with.
   *
   * Vertical is the NARROW case and therefore the base rule, because a phone
   * has the height and not the width: 80 mm is 480 px at a phone's ~6 px/mm,
   * against a 375 px viewport. Ticks grow from the left edge. */
  .ruler {
    position: relative;
    width: 4.25rem;
    height: calc(var(--mm) * var(--rulerMaxMm));
    color: var(--color-text-muted, currentColor);
    background-repeat: no-repeat;
    background-position: 0 0;
    background-image:
      repeating-linear-gradient(to bottom, currentColor 0 1px, transparent 1px calc(var(--mm) * 10)),
      repeating-linear-gradient(to bottom, currentColor 0 1px, transparent 1px calc(var(--mm) * 5)),
      repeating-linear-gradient(to bottom, currentColor 0 1px, transparent 1px calc(var(--mm) * 1));
    background-size: 20px 100%, 13px 100%, 7px 100%;
    /* The zero edge, and it is the one the strip is laid against. */
    border-left: 1.5px solid currentColor;
  }

  .ruler-label {
    position: absolute;
    left: 24px;
    top: calc(var(--mm) * var(--at));
    transform: translateY(-50%);
    font-size: 10px;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    line-height: 1;
    pointer-events: none;
    user-select: none;
  }

  /* Wide: the same scale laid across, where there is room for it. 80 mm is
   * 330 px at a laptop's ~4.12 px/mm, which fits a column comfortably. */
  @media (min-width: 768px) {
    .ruler {
      width: calc(var(--mm) * var(--rulerMaxMm));
      height: 4.25rem;
      background-image:
        repeating-linear-gradient(to right, currentColor 0 1px, transparent 1px calc(var(--mm) * 10)),
        repeating-linear-gradient(to right, currentColor 0 1px, transparent 1px calc(var(--mm) * 5)),
        repeating-linear-gradient(to right, currentColor 0 1px, transparent 1px calc(var(--mm) * 1));
      background-size: 100% 20px, 100% 13px, 100% 7px;
      border-left: 0;
      border-top: 1.5px solid currentColor;
    }

    .ruler-label {
      left: calc(var(--mm) * var(--at));
      top: 24px;
      transform: translateX(-50%);
    }
  }

  /* ── The coin outline ──────────────────────────────────────────────
   * One rule for every disc: the diameter is whatever --calObjMm currently
   * holds, at the calibrated scale. A coin is matched at its OUTER edge, and
   * the border sits on that edge exactly as the ring circle's does. */
  .cal-disc {
    width: calc(var(--cal-mm) * var(--cal-obj-mm));
    height: calc(var(--cal-mm) * var(--cal-obj-mm));
    border-radius: 9999px;
  }

  /* Which shape is on screen, driven by one attribute on the stage rather
   * than by toggling `hidden` on each piece. The card shapes carry Tailwind's
   * `md:flex` / `md:hidden`, and a plain [hidden] attribute loses to those in
   * the cascade; an attribute + class selector outranks a single utility
   * class, so this switch works without !important and without touching the
   * breakpoint rules that the phone layout was verified against. */
  [data-cal-shape='disc'] .cal-edge-wrap { display: none; }
  [data-cal-shape='disc'] .cal-disc-wrap { display: flex; }

  /* The two bars ARE the measurement: outer edge to outer edge is 53.98 mm,
   * which is also how the ring circle is read. One rule for both. */
  .cal-gauge-tick {
    position: absolute;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--accent);
  }

  .cal-gauge-rule {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
    background: var(--accent);
    opacity: 0.55;
  }

  .ring-grid {
    background-image:
      linear-gradient(to right,  var(--border-strong) 0 1px, transparent 1px),
      linear-gradient(to bottom, var(--border-strong) 0 1px, transparent 1px),
      linear-gradient(to right,  var(--border) 0 1px, transparent 1px),
      linear-gradient(to bottom, var(--border) 0 1px, transparent 1px);
    background-size:
      calc(var(--mm) * 5) 100%,
      100% calc(var(--mm) * 5),
      var(--mm) 100%,
      100% var(--mm);
    /* 50% 50% puts a major line exactly on the centre, aligning the grid with
     * the crosshair ticks and the ring circle. */
    background-position: 50% 50%;
    /* 1 mm lines are dense enough that full-strength borders read as a solid
     * wash, especially in light mode. Fade the whole layer instead of picking
     * new colours so the grid stays behind the ring, not next to it. */
    opacity: 0.5;
  }

  .ring-scale-bar {
    width: calc(var(--mm) * 10);
  }

  /* A hairline, deliberately. Tailwind's preflight makes this border-box, so
   * the circle's OUTER edge is the true diameter and the drawn line eats
   * inward. At 3px and a phone's ~6 px/mm that line was 0.5 mm thick, and a
   * whole US size is only 0.81 mm of diameter — so aiming at the inside of
   * the stroke instead of the outside put the answer most of a size out. At
   * 1px the ambiguity is 0.17 mm, comfortably under one quarter size. */
  .ring-circle {
    border-width: 1px;
  }

  /* Custom stylish slider thumb */
  input[type="range"]::-webkit-slider-thumb {
    appearance: none;
    height: 22px;
    width: 22px;
    border-radius: 50%;
    background: #D4AF37;
    cursor: grab;
