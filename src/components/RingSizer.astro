     * link opens on the finger instruction instead of telling the visitor to go
     * and find a ring. Not read from the DOM: the server rendered its guess from
     * the PROP, and the URL outranks the prop. */
    let activeSource: Source = sourceFromMeasure(activeMeasure);
    let currentDia = diameterFromUs(6);       // US 6 - the women's average

    /** The spec for whatever the tool is currently showing. */
    const bounds = () => modeSpec(activeMeasure, activeUnit);

    /* The typed field is allowed to be one decimal finer than the slider: a
     * person reading "16.51" off a caliper should be able to type it even
     * where the slider snaps to 0.05. */
    const numStep = (dp: number) => (10 ** -dp).toFixed(dp);

    const store = {
      get(): number | null {
        try {
          const v = parseFloat(localStorage.getItem(PPM_STORE_KEY) ?? '');
          return Number.isFinite(v) && v >= PPM_MIN && v <= PPM_MAX ? v : null;
        } catch { return null; }
      },
      set(v: number) { try { localStorage.setItem(PPM_STORE_KEY, String(v)); } catch { /* blocked */ } },
      /* The zoom baseline. Written only when a calibration is committed, so it
       * always describes the screen state that px/mm was measured against. */
      getDpr(): number | null {
        try {
          const v = parseFloat(localStorage.getItem(DPR_STORE_KEY) ?? '');
          return Number.isFinite(v) && v > 0 ? v : null;
        } catch { return null; }
      },
      setDpr() {
        dprAtCal = window.devicePixelRatio;
        try { localStorage.setItem(DPR_STORE_KEY, String(dprAtCal)); } catch { /* blocked */ }
      },
    };

    /* Where the slider starts for someone who has never calibrated. Decided in
     * JS rather than CSS on purpose: a media query would size the GAUGE for a
     * phone while the printed "3.78" beside it still came from the server, and
     * the two would disagree until the script booted. Doing it here moves the
     * number, the slider, the gauge and the ring stage together in one call, so
     * the pre-JS paint is internally consistent and so is everything after it.
     * See PHONE_PX_PER_MM in src/data/calibration.ts for why 96 DPI was wrong. */
    const startingPpm = () => {
      /* `> 0` is not defensive noise. A hidden or not-yet-laid-out browsing
       * context reports innerWidth as 0, and `0 <= 500` is true — which handed
       * the phone starting point to a DESKTOP during this change's own testing.
       * Unknown width must fall back to the desktop default, never to the phone
       * one: guessing "phone" on a desktop doubles the scale, where guessing
       * "desktop" on a phone only restores the previous behaviour. */
      const w = window.innerWidth;
      return w > 0 && w <= PHONE_VIEWPORT_MAX_PX ? PHONE_PX_PER_MM : DEFAULT_PX_PER_MM;
    };

    /* The scale marker and the calibrate drawer answer the SAME question, so
     * they are driven from one call rather than two conditions that can drift
     * apart. Anywhere the drawer's state changes because of what the visitor
     * did about calibration, this goes with it.
     *
     * Known edge: [data-cal-reset] writes the starting value to the store, so a
     * visitor who resets is then counted as calibrated. That is deliberate —
     * the marker must never contradict the drawer, and the drawer treats any
     * stored value as settled. A screen genuinely at that value is a real screen,
     * so the claim is unearned rather than false. */
    const scaleMarker = $('[data-scale-marker]');
    const scaleIcon = $('[data-scale-icon]');
    const scaleText = $('[data-scale-text]');

    /* ── the scale marker: THREE states, and the third is the point ──────────
     * A calibration is only true at the zoom level it was taken at. Zoom and the
     * marker went on claiming "Actual size on your screen" regardless, which is
     * this site's one real claim going quietly false — the exact failure the
     * two-state marker was built to avoid, one level up.
     *
     * Two mechanisms, because no single reading covers both:
     *   pinch-zoom          moves `visualViewport.scale`, NOT devicePixelRatio
     *   browser zoom        moves `devicePixelRatio`, NOT visualViewport.scale
     * Checking only the first would have left desktop Ctrl +/- silently wrong,
     * which is the likelier case on the machine this site is built on.
     *
     * The DPR test needs a baseline, so the DPR at calibration is stored beside
     * the px/mm. Anyone who calibrated before this shipped has no baseline; that
     * reads as "cannot tell" and says nothing, because a warning that fires when
     * nothing is wrong is worse than no warning. */
    let calibrated = false;
    let dprAtCal: number | null = null;

    function zoomLooksChanged(): boolean {
      const vv = window.visualViewport;
      /* Pinch-zoom. The tolerance is for sub-pixel noise, not for real zoom:
       * the smallest deliberate step any browser offers is far larger. */
      if (vv && Math.abs(vv.scale - 1) > 0.01) return true;
      if (dprAtCal !== null && Math.abs(window.devicePixelRatio - dprAtCal) > 0.01) return true;
      return false;
    }

    function renderMarker() {
      const zoomed = calibrated && zoomLooksChanged();
      const state = !calibrated ? 'none' : zoomed ? 'zoomed' : 'ok';
      if (scaleMarker.dataset.state === state) return;   // no needless DOM writes
      scaleMarker.dataset.state = state;
      scaleMarker.dataset.calibrated = String(calibrated && !zoomed);
      if (state === 'ok') {
        scaleIcon.textContent = '\u2713';
        scaleIcon.className = 'font-mono text-accent-text';
        scaleText.textContent = 'Actual size on your screen';
        scaleText.className = 'text-accent-text';
      } else if (state === 'zoomed') {
        scaleIcon.textContent = '\u26a0';
        scaleIcon.className = 'font-mono text-text-muted';
        scaleText.textContent = 'Zoom has changed \u2014 reset it to 100% or calibrate again';
        scaleText.className = 'text-text-muted';
      } else {
        scaleIcon.textContent = '\u2014';
        scaleIcon.className = 'font-mono text-text-faint';
        scaleText.textContent = 'Not calibrated yet \u2014 sizes assume a standard screen';
        scaleText.className = 'text-text-faint';
      }
    }

    function setCalibrated(yes: boolean) {
      calibrated = yes;
      renderMarker();
      /* An uncalibrated ruler is a picture of a ruler. It still helps — the
       * starting scale is a reasonable guess and the strip has to be measured
       * against something — but it must not be presented as a measurement,
       * which is the same two-state rule the scale marker follows. */
      rulerCal.textContent = yes
        ? 'Calibrated to this screen.'
        : 'Calibrate first, or these are a guess.';
      rulerCal.className = yes ? 'text-text-muted' : 'text-text-faint';
    }

    /* Both zoom mechanisms surface as a resize: pinch fires visualViewport's own
     * resize, browser zoom fires the window's. Cheap to recompute — renderMarker
     * writes nothing when the state has not moved. */
    window.addEventListener('resize', renderMarker);
    window.visualViewport?.addEventListener('resize', renderMarker);

    /* ── which object is being matched ──
     * Changing the reference does NOT change pxPerMm. The visitor is still
     * looking at whatever scale they had; only the outline they are matching
     * it against is different, and they re-match it. Writing a new px/mm here
     * would silently recalibrate someone who merely wanted to read the
     * options, which is the opposite of what a picker should do. */
    function setCalObject(key: string, persist = true) {
      const obj = calObject(key);

      calObjButtons.forEach((btn) => {
        const on = btn.dataset.calObjBtn === obj.key;
        btn.className = on ? SOURCE_ON : SOURCE_OFF;
        btn.setAttribute('aria-checked', String(on));
        /* Roving tabindex, same contract as the three groups below it. */
        btn.tabIndex = on ? 0 : -1;
      });

      calHint.textContent = obj.hint;
      calSource.textContent = obj.source;
      calStage.dataset.calShape = obj.shape;
      /* One property, read by .cal-disc. Set on the drawer rather than the
       * disc itself so it sits alongside --cal-mm, the other half of the
       * same calculation.
       *
       * ⚠️ --cal-obj-mm, NOT --calObjMm. The latter is a define:vars name and
       * every descendant carries it inline, so writing it here is a no-op
       * that draws the wrong object. See the CSS rule for the full account. */
      stepCal.style.setProperty('--cal-obj-mm', `${obj.mm}`);
      /* Two decimals: the quarter is 24.257 mm and printing 24.26 on an
       * outline drawn at 24.257 is a number that does not describe the thing
       * beside it. The card's label is a whole 53.98 and unaffected. */
      calDiscMm.textContent = `${obj.mm.toFixed(2)} mm`;

      if (persist) {
        try { localStorage.setItem(CAL_OBJECT_STORE_KEY, obj.key); } catch { /* blocked */ }
      }
    }

    /* ── calibration controls ── */
    function setPxPerMm(v: number, syncNum = true) {
      pxPerMm = clampPpm(v);
      /* One variable, two shapes: the full card outline on wide screens and
       * the width gauge on narrow ones both derive their size from --cal-mm,
       * so whichever the visitor is looking at is the same millimetre. */
      stepCal.style.setProperty('--cal-mm', `${pxPerMm}px`);
      /* The graph paper and its 10 mm legend are sized off this one variable,
       * so a recalibration moves them with the ring instead of leaving a grid
       * that looks precise while measuring nothing. */
      ringStage.style.setProperty('--mm', `${pxPerMm}px`);
      /* Same variable, same reason, third surface: a ruler drawn at a stale
       * scale is worse than no ruler, because it looks like an instrument. */
      ruler.style.setProperty('--mm', `${pxPerMm}px`);
      const s = pxPerMm.toFixed(2);
      if (calRange.value !== s) calRange.value = s;
      /* Not while the visitor is typing into this very field: clamping writes
       * the bound back on every keystroke, so someone reaching for 2.9 saw
       * their "2" become "2.50" under the cursor. The ring field already
       * follows this rule; this one did not. It is resynced on commit. */
      if (syncNum && calNum.value !== s) calNum.value = s;
      if (calVal) calVal.textContent = s;
      $('[data-cal-status]').textContent = s;
      updateDisplay();
    }

    calRange.addEventListener('input', () => setPxPerMm(parseFloat(calRange.value)));
    calNum.addEventListener('input', () => {
      const v = parseFloat(calNum.value);
      if (Number.isFinite(v)) setPxPerMm(v, false);
    });
    /* Commit (blur or Enter): the field can never be left showing a number the
     * tool is not actually using, including an empty or junk entry. */
    calNum.addEventListener('change', () => {
      const v = parseFloat(calNum.value);
      setPxPerMm(Number.isFinite(v) ? v : pxPerMm);
    });

    $('[data-cal-save]').addEventListener('click', () => {
      store.set(pxPerMm);
      store.setDpr();
      stepCal.hidden = true;
      setCalibrated(true);
    });

    $('[data-cal-close]').addEventListener('click', () => {
      stepCal.hidden = true;
    });

    $('[data-cal-reset]').addEventListener('click', () => {
      /* Resets to the same place a fresh visitor starts, not to 96 DPI — on a
       * phone those are different numbers and resetting to the desktop one would
       * hand back the 62%-of-a-card outline this was fixed to avoid.
       *
       * The button used to read "Reset Default (96 DPI)". It now reads just
       * "Reset", because the number it resets TO depends on the viewport and the
       * label is server-rendered where the viewport is unknown. A label naming
       * one figure while the button applies another is the kind of small lie this
       * file exists to avoid; the value lands in the field beside it either way. */
      const back = startingPpm();
      setPxPerMm(back);
      store.set(back);
      store.setDpr();
      setCalibrated(true);
    });

    $('[data-recal]').addEventListener('click', () => {
      stepCal.hidden = !stepCal.hidden;
      if (!stepCal.hidden) {
        stepCal.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    });

    /* ── The first question: what the visitor has ──────────────────────────
     *
     * `syncMode` is the whole safety story of this pair of functions.
     *
     *   setSource(s)          the visitor picked a source -> pre-set the measure
     *   setSource(s, false)   the measure moved -> repaint the picker only
     *
     * setMode() calls the second form, so the two can keep each other honest
     * without recursing: setSource -> setMode -> syncSourceToMeasure sees the
     * source it is already on and returns.
     */
    function setSource(s: Source, syncMode = true) {
      activeSource = s;
      const spec = sourceSpec(s);

      sourceButtons.forEach((btn) => {
        const on = btn.dataset.sourceBtn === s;
        btn.className = on ? SOURCE_ON : SOURCE_OFF;
        btn.setAttribute('aria-checked', String(on));
        /* Roving tabindex, same contract as the two pill groups below: the
         * GROUP is one tab stop and the stop is whichever radio is checked. */
        btn.tabIndex = on ? 0 : -1;
      });

      sourceHint.textContent = spec.hint;

      /* The caption is the stage's only instruction, so it is removed rather
       * than blanked when the stage is not the input — an empty <p> still holds
       * its margin and pushes the ring off centre. */
      stageCaption.hidden = spec.stageCaption === null;
      if (spec.stageCaption !== null) stageCaption.textContent = spec.stageCaption;

      /* The ruler is for the paper strip and nothing else. On the ring route
       * the stage circle IS the instrument, and on 'number' the visitor
       * already has their figure — showing a ruler there would be an
       * instruction that has stopped applying, the same defect the caption
       * rule above exists to avoid. */
      ruler.hidden = s !== 'finger';

      /* A ring is matched at its inner edge (a diameter); a paper strip is a
       * circumference. This is the factor of pi, not a preference. 'number'
       * carries measure: null and must never touch a measure the visitor set. */
      if (syncMode && spec.measure !== null && spec.measure !== activeMeasure) {
        setMode(spec.measure, activeUnit);
      }
    }

    /* Flipping Diameter <-> Circumference by hand has to move the picker with
     * it, or the card claims "A ring that fits" while the tool is reading a
     * circumference.
     *
     * ⚠️ 'number' is sticky, and deliberately. Someone who has told the tool
     * they are typing a caliper reading then changes a UNIT — mm to inches, say
     * — and re-deriving from the measure would silently reclassify them as
     * holding a ring, rewriting the instruction under their cursor. A source is
     * a statement about the person; only the person retracts it. */
    function syncSourceToMeasure(m: Measure) {
      if (activeSource === 'number') return;
      const derived = sourceFromMeasure(m);
      if (derived !== activeSource) setSource(derived, false);
    }

    /* ── Switch modes: (diameter | circumference) × (mm | cm | in) ── */
    function setMode(m: Measure, u: Unit, pushUrl = true) {
      activeMeasure = m;
      activeUnit = u;

      const paint = (btns: HTMLButtonElement[], attr: string, active: string) => {
        btns.forEach((btn) => {
          const on = btn.dataset[attr] === active;
          btn.className = on ? PILL_ON : PILL_OFF;
          btn.setAttribute('aria-checked', String(on));
          /* Roving tabindex: the GROUP is one tab stop, and the stop is
           * whichever pill is currently checked. */
          btn.tabIndex = on ? 0 : -1;
        });
      };
      paint(measureButtons, 'measureBtn', m);
      paint(unitButtons, 'unitBtn', u);
      syncSourceToMeasure(m);

      /* The view lives in the URL so it can be shared, bookmarked and linked
       * to from the pages that exist to answer one of these questions.
       * replaceState, not pushState: flipping a unit is not a navigation, and
       * filling the back button with unit changes would trap the visitor. */
      if (pushUrl) {
        const url = new URL(location.href);
        url.searchParams.set('measure', m === 'circ' ? 'circumference' : 'diameter');
        url.searchParams.set('unit', u === 'in' ? 'inches' : u);
        history.replaceState(null, '', url);
      }

      const b = bounds();
      mainLabel.textContent = b.label;
      mainUnit.textContent = b.unitLabel;
      minLabel.textContent = `${ceilTo(b.min, b.dp)} ${b.unitLabel}`;
      maxLabel.textContent = `${floorTo(b.max, b.dp)} ${b.unitLabel}`;
      /* Bounds are rounded INWARD to the mode's own decimal grid. Using the
       * exact converted bound instead (DIA_MIN in inches is 0.4330708...)
       * offsets the whole step grid by an irrational amount, and the slider
       * starts reporting values like "0.648070866141732". A clean grid costs
       * at most one step of reach at each end, which is 0.005 in - far less
       * than the precision anyone can achieve holding a ring against glass. */
      ringRange.min = ceilTo(b.min, b.dp);
      ringRange.max = floorTo(b.max, b.dp);
      ringRange.step = b.step;
      /* The exact value, to this mode's precision. The browser will snap the
       * slider's own `value` to the nearest step - in circumference mode a
       * 0.05 mm step turns 51.87 into 51.86 - so the THUMB can sit up to half
       * a step off. That is deliberate and invisible: the slider carries no
       * number of its own, while the field and the big readout below both show
       * the exact figure.
       *
       * The alternative - adopting whatever the slider snapped to as the new
       * truth - keeps the thumb honest but makes switching units MUTATE the
       * measurement. Cycling mm -> cm -> in -> circ -> mm drifted 16.51 to
       * 16.49, enough to flip the Japanese size from 12 to 11 without the
       * visitor touching the slider. Losing the measurement is worse than a
       * thumb that is a fraction of a step out. */
      const exact = toMode(currentDia, m, u).toFixed(b.dp);
      ringRange.value = exact;

      ringNum.min = ringRange.min;
      ringNum.max = ringRange.max;
      ringNum.step = numStep(b.dp);
      ringNum.value = exact;          // exact, NOT ringRange.value post-snap

      updateDisplay();
    }

    /* These two rows announce themselves as role="radiogroup" but behaved like
     * six unrelated buttons: Tab stopped on every one and the arrow keys did
     * nothing. The ARIA authoring practices are explicit that a radiogroup is
     * a single tab stop and that arrows move focus AND selection together, so
     * claiming the role without the behaviour is worse than not claiming it —
     * a screen-reader user is told to expect arrows that are not there. */
    const ARROW_DELTA: Record<string, number> = {
      ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1,
    };

    function wireRadioGroup(
      buttons: HTMLButtonElement[],
      select: (btn: HTMLButtonElement) => void,
    ) {
      buttons.forEach((btn, i) => {
        btn.addEventListener('click', () => select(btn));
        btn.addEventListener('keydown', (e: KeyboardEvent) => {
          const delta = ARROW_DELTA[e.key];
          if (delta === undefined) return;
          /* Or the page scrolls under the visitor while they change units. */
          e.preventDefault();
          const next = buttons[(i + delta + buttons.length) % buttons.length];
          select(next);
          next.focus();
        });
      });
    }

    wireRadioGroup(calObjButtons, (btn) =>
      setCalObject(btn.dataset.calObjBtn ?? DEFAULT_CAL_OBJECT));
    wireRadioGroup(sourceButtons, (btn) =>
      setSource(btn.dataset.sourceBtn as Source));
    wireRadioGroup(measureButtons, (btn) =>
      setMode(btn.dataset.measureBtn as Measure, activeUnit));
    wireRadioGroup(unitButtons, (btn) =>
      setMode(activeMeasure, btn.dataset.unitBtn as Unit));

    /* ── slider & step buttons handlers ── */
    function handleValueChange(val: number, writeBack = true) {
      currentDia = Math.min(DIA_MAX, Math.max(DIA_MIN, toDia(val, activeMeasure, activeUnit)));

      /* If the request was out of range we just clamped it, so the number field
       * and the slider are now showing something that is not what the tool is
       * actually using. Type "5" in mm mode and the field kept saying 5 while
       * the readout said 11.00. Write the clamped value back to both.
       *
       * Only on a genuine clamp: rewriting mid-drag or mid-keystroke would
       * fight the user's cursor. */
      const b = bounds();
      const clamped = toMode(currentDia, activeMeasure, activeUnit);
      if (writeBack && Math.abs(clamped - val) > 10 ** -(b.dp + 1)) {
        const s = clamped.toFixed(b.dp);
        ringRange.value = s;
        ringNum.value = s;
      }

      updateDisplay();
    }

    ringRange.addEventListener('input', () => {
      // toFixed, not the raw string: the slider hands back "22.2" where the
      // readout beside it says "22.20".
      const v = parseFloat(ringRange.value);
      ringNum.value = Number.isFinite(v) ? v.toFixed(bounds().dp) : ringRange.value;
      handleValueChange(v);
    });
    /* Typing is not committing. The clamp used to run on every keystroke and
     * write its result straight back into the field, so in millimetres — where
     * the floor is 12.89 — reaching for 16.51 turned the "1" into "12.89"
     * under the cursor and there was no way to type the rest. Worse, a field
     * emptied with backspace hit the early return and was simply abandoned:
     * the tool went on using a number the visitor could no longer see.
     *
     * The calibration field already had this right. Track while typing, write
     * back only on commit — and on commit, repair junk from state rather than
     * ignoring it. */
    ringNum.addEventListener('input', () => {
      const v = parseFloat(ringNum.value);
      if (!Number.isFinite(v)) return;
      ringRange.value = ringNum.value;
      handleValueChange(v, false);
    });
    ringNum.addEventListener('change', () => {
      const v = parseFloat(ringNum.value);
      if (Number.isFinite(v)) {
        handleValueChange(v);
        return;
      }
      const b = bounds();
      const s = toMode(currentDia, activeMeasure, activeUnit).toFixed(b.dp);
      ringRange.value = s;
      ringNum.value = s;
      updateDisplay();
    });

    /* The value a ± click starts from is derived from `currentDia`, NOT read
     * back off ringRange.value. The slider snaps to its own step grid, so
     * reading it back quantises the measurement on every click — exactly the
     * mutation setMode() goes out of its way to avoid. In inches the grid is
     * 0.434 + 0.005k, so one + followed by one − moved 16.51 mm to 16.48 and
     * flipped the Japanese size from 12 to 11 without the visitor changing
     * anything. Both ends are clamped to the mode's own rounded-inward bounds. */
    function nudge(dir: 1 | -1) {
      const b = bounds();
      const current = toMode(currentDia, activeMeasure, activeUnit);
      const next = Math.min(
        parseFloat(ringRange.max),
        Math.max(parseFloat(ringRange.min), current + dir * b.nudge),
      );
      const s = next.toFixed(b.dp);
      ringRange.value = s;
      ringNum.value = s;
      /* parseFloat(s), not `next`: the field and the state must agree on the
       * same rounded figure, or the next click starts from a value nothing
       * on screen is showing. */
      handleValueChange(parseFloat(s));
    }

    btnMinus.addEventListener('click', () => nudge(-1));
    btnPlus.addEventListener('click', () => nudge(1));

    const dash = (v: string | number | null) => (v === null ? '—' : String(v));

    /* ── update all visuals & country size cards ── */
    function updateDisplay() {
      const d = Math.min(DIA_MAX, Math.max(DIA_MIN, currentDia));
      
      // Update dynamic golden ring scale
      const px = d * pxPerMm;
      ringCircle.style.width = `${px}px`;
      ringCircle.style.height = `${px}px`;

      /* Readout precision matches the mode's step. Inches used to render at
       * 2 dp against a 0.001 in step, so 0.01 in = 0.254 mm was the smallest
       * visible change - coarser than a US quarter size (0.2032 mm), and two
       * clicks of the step button appeared to do nothing. */
      const bd = bounds();
      mainVal.textContent = toMode(d, activeMeasure, activeUnit).toFixed(bd.dp);

      // Convert diameter to official standards
      const r = fromDiameter(d);
      /* root! and not root: everything here runs inside `if (root)`, but this
       * closure lives in a hoisted `function updateDisplay()`, and TypeScript
       * drops a const's narrowing at that boundary because such a function
       * could in principle be called before the check. The `$` helper above
       * asserts for the same reason. */
      const set = (sel: string, v: string) => { 
        const el = root!.querySelector(sel);
        if (el) el.textContent = v;
      };

      set('[data-out-us]', dash(r.us));
      set('[data-out-uk]', dash(r.uk));
      set('[data-out-eu]', dash(r.eu));
      set('[data-out-jp]', dash(r.jp));
      set('[data-out-in]', dash(r.in));
      set('[data-out-fr]', dash(r.fr));
      set('[data-out-dia-mm]', `${r.diameterMm.toFixed(2)} mm`);
      set('[data-out-dia-in]', `${r.diameterIn.toFixed(3)} in`);
      set('[data-out-circ-mm]', `${r.circumferenceMm.toFixed(2)} mm`);
      set('[data-out-circ-in]', `${r.circumferenceIn.toFixed(3)} in`);

      // aria-live was present in markup but never written to — a screen reader
      // user got zero feedback as the slider moved. Throttled so dragging
      // doesn't spam an announcement on every pixel of travel.
      if (live) {
        window.clearTimeout(liveTimer);
        liveTimer = window.setTimeout(() => {
          live.textContent = `US size ${dash(r.us)}, ${r.diameterMm.toFixed(2)} millimetres`;
        }, 400);
      }
    }
    let liveTimer = 0;

    /* ── boot initialization ──
     * A first-time visitor (no saved calibration) MUST see the calibrate
     * card — the entire "accurate because you calibrate your own screen"
     * claim is silently false otherwise. Only collapse it when we actually
     * have a valid saved value, mirroring what [data-cal-save] does. */
    const saved = store.get();
    if (saved) {
      setPxPerMm(saved);
      stepCal.hidden = true;
      /* Baseline first: setCalibrated renders the marker, and the marker needs to
       * know whether the zoom has moved since this value was saved. Null here
       * means the calibration predates the DPR key, and the zoom test stays mute
       * rather than guessing. */
      dprAtCal = store.getDpr();
      setCalibrated(true);
    } else {
      setPxPerMm(startingPpm());
      stepCal.hidden = false;
      setCalibrated(false);
    }

    /* setMode() is what fills the paired number input and derives the slider's
     * bounds and end labels. Boot used to call only updateDisplay(), so the
     * number field sat EMPTY until the visitor touched something, and the
     * bounds were whatever the markup happened to say. Run it once for the
     * starting mode so every one of those comes from the mode table.
     *
     * pushUrl is false here: boot must not stamp ?measure=&unit= onto a clean
     * URL the visitor never chose, which would turn every shared link into a
     * parameterised one and give the canonical page a second address. */
    setMode(activeMeasure, activeUnit, false);

    /* Painted explicitly rather than left to setMode's sync, which no-ops when
     * the derived source already matches. It usually does — and the one case
     * where it does not is exactly the case that matters: the server rendered
     * the source from the PROP, and a ?measure=circumference in the URL has
     * since overridden it, so the markup on screen is a source behind. */
    setSource(activeSource, false);

    /* The reference object the visitor last used. Restored with persist=false:
     * this is replaying their choice, not making a new one, and writing it back
     * would rewrite the key on every page load for no reason.
     *
     * Painted unconditionally, including for the card. The server rendered the
     * card's markup but not its disc label or --calObjMm, so running this once
     * is what guarantees the DOM and the data agree before anyone clicks —
     * the same argument as the setSource call above. A missing or unknown
     * stored key falls back to the card inside calObject(). */
    let storedObj: string | null = null;
    try { storedObj = localStorage.getItem(CAL_OBJECT_STORE_KEY); } catch { /* blocked */ }
    setCalObject(storedObj ?? DEFAULT_CAL_OBJECT, false);
  }
</script>
