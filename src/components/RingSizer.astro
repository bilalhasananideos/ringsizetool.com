---
/**
 * Interactive Ring Size Instrument.
 * Real-time measurement in MM, CM, and Inches, multi-region size conversions, and screen calibration.
 *
 * The values rendered on the server below are DERIVED, not typed. They used to
 * be hand-written literals (6 / "L ½" / 52 / 12 / 16.51 mm / 51.87 mm), which
 * breaks the house rule in CLAUDE.md and had already drifted: the markup said
 * "L ½" with a space while ukFromCircumference() emits "L½", so the value
 * visibly changed shape the moment the script booted.
 */
import { fromDiameter, diameterFromUs, UK_NOTE, INDIA_NOTE } from '../data/ringSizes';
import {
  MEASURES, UNITS, modeSpec, toMode, ceilTo, floorTo,
  DIA_MIN_MM, DIA_MAX_MM,
  type Measure, type Unit,
} from '../data/ringModes';
import { PILL_ON as pillOn, PILL_OFF as pillOff } from './pillClasses';

/**
 * Pages that exist to answer one query ("ring size in inches") mount the tool
 * already showing that answer, rather than making the visitor find a toggle
 * for the thing the page title promised. The toggle still works afterwards.
 */
interface Props {
  measure?: Measure;
  unit?: Unit;
}
const { measure: initMeasure = 'dia', unit: initUnit = 'mm' } = Astro.props;

/** US 6 - the women's average, and the size the tool opens on. */
const DEFAULT_DIA = diameterFromUs(6);
const d = fromDiameter(DEFAULT_DIA);

/** The script's own default before any calibration: 96 CSS DPI. */
const DEFAULT_PPM = 3.78;

/* Everything the server prints for the opening mode is derived from the same
 * table the client script uses, so the pre-hydration markup and the first
 * hydrated frame cannot show different numbers. */
const spec = modeSpec(initMeasure, initUnit);
const initValue = toMode(DEFAULT_DIA, initMeasure, initUnit).toFixed(spec.dp);
const initMin = ceilTo(spec.min, spec.dp);
const initMax = floorTo(spec.max, spec.dp);

const dash = (v: string | number | null) => (v === null ? '—' : String(v));


---

<section
  class="ring-sizer w-full"
  aria-labelledby="ring-sizer-heading"
  data-init-measure={initMeasure}
  data-init-unit={initUnit}
>
  <h2 id="ring-sizer-heading" class="sr-only">Interactive ring sizer</h2>

  <!-- ── Step 1: Calibrate Drawer (Collapsible) ────────────────────────── -->
  <!-- `hidden` removed from markup: it must be visible on first paint for anyone
       with no saved calibration, or the whole "accurate because you calibrate
       your own screen" claim is silently false for every new visitor. The
       boot script hides it (and only it) once a valid saved value is found. -->
  <div data-step="calibrate" class="card-elevated mb-6 rounded-2xl border border-border bg-surface p-6 sm:p-8 transition-all">
    <div class="flex items-center justify-between gap-3 mb-4">
      <div class="flex items-center gap-3">
        <span class="flex h-6 w-6 items-center justify-center rounded-full bg-accent text-on-accent text-xs font-bold">1</span>
        <h3 class="text-lg font-semibold text-text">Calibrate Screen Scale</h3>
      </div>
      <button data-cal-close type="button" class="cursor-pointer text-xs text-text-muted hover:text-text underline">
        Close ✕
      </button>
    </div>

    <div class="grid gap-6 md:grid-cols-[1.1fr_0.9fr] md:items-center">
      <div>
        <p class="text-sm text-text-muted leading-relaxed">
          Hold any standard bank card upright against your screen and adjust the slider until the outline matches its exact width (53.98 mm).
        </p>

        <div class="mt-5 rounded-xl border border-border bg-surface-sunk/50 p-4">
          <div class="flex items-center justify-between text-xs text-text-muted mb-2 font-medium">
            <span>Match outline to card</span>
            <span class="font-mono"><span data-readout data-cal-val>3.78</span> px/mm</span>
          </div>
          <div class="flex items-center gap-3">
            <input
              id="cal-range" data-cal-range type="range"
              min="2.5" max="7" step="0.01" value="3.78"
              class="h-2 w-full cursor-pointer appearance-none rounded-full bg-border-strong/40 accent-[#D4AF37] focus:outline-none"
            />
            <label class="sr-only" for="cal-num">Pixels per millimetre, exact value</label>
            <input
              id="cal-num" data-cal-num type="number" inputmode="decimal"
              min="2.5" max="7" step="0.01" value="3.78"
              class="h-9 w-20 shrink-0 rounded-lg border border-border bg-surface px-2 text-right text-sm text-text"
            />
          </div>
        </div>

        <div class="mt-5 flex flex-wrap items-center gap-3">
          <button data-cal-save type="button" class="h-10 cursor-pointer rounded-xl bg-accent px-5 text-xs font-semibold text-on-accent hover:bg-accent-hover transition-all shadow-xs">
            Save Scale
          </button>
          <button data-cal-reset type="button" class="h-10 cursor-pointer rounded-xl border border-border px-4 text-xs font-medium text-text-muted hover:text-text transition-colors">
            Reset Default (96 DPI)
          </button>
        </div>
      </div>

      <div class="flex flex-col items-center justify-center rounded-xl border border-dashed border-border bg-surface-sunk/50 p-6">
        <div
          data-card
          class="flex items-center justify-center rounded-lg border-2 border-dashed border-accent bg-accent-sunk/30 transition-all shadow-xs"
          style="width:204px;aspect-ratio:53.98/85.6"
        >
          <span class="text-xs font-medium text-accent-text text-center px-2 pointer-events-none select-none">
            Standard Bank Card<br/><span class="text-[10px] text-text-faint font-mono">53.98 mm</span>
          </span>
        </div>
        <p class="mt-3 text-[11px] text-text-faint font-mono">1:1 Physical Scale Outline</p>
      </div>
    </div>
  </div>

  <!-- ── Main Interactive Instrument Card ──────────────────────────────── -->
  <div data-step="measure" class="card-elevated rounded-2xl border border-border bg-surface p-6 sm:p-10 md:p-12 shadow-sm">
    <!-- Two switchers, because these are two independent questions: what you
         measured, and what unit you want it in. One combined row of four made
         circumference look like a unit and left it stuck in millimetres. -->
    <div class="flex flex-wrap items-center justify-center gap-3">
      <div role="radiogroup" aria-label="What you measured" class="inline-flex flex-wrap justify-center rounded-full bg-surface-sunk p-1 border border-border/80 shadow-inner gap-1">
        {MEASURES.map((m) => (
          <button
            type="button" role="radio"
            aria-checked={m.key === initMeasure ? 'true' : 'false'}
            data-measure-btn={m.key}
            class={m.key === initMeasure ? pillOn : pillOff}
          >
            {m.short}
          </button>
        ))}
      </div>

      <div role="radiogroup" aria-label="Units" class="inline-flex flex-wrap justify-center rounded-full bg-surface-sunk p-1 border border-border/80 shadow-inner gap-1">
        {UNITS.map((u) => (
          <button
            type="button" role="radio"
            aria-checked={u.key === initUnit ? 'true' : 'false'}
            data-unit-btn={u.key}
            class={u.key === initUnit ? pillOn : pillOff}
          >
            {u.short}
          </button>
        ))}
      </div>
    </div>

    <!-- 2-Column Main Instrument Grid -->
    <div class="mt-10 grid gap-10 md:grid-cols-[1fr_1.15fr] md:items-center">

      <!-- Left Column: Interactive Ring Circle Guide & Live Readout -->
      <div class="flex flex-col items-center justify-center">
        <div data-ring-stage class="ring-stage relative flex h-64 w-64 sm:h-72 sm:w-72 items-center justify-center overflow-hidden rounded-xl">

          <!-- Graph paper at TRUE scale: 1 mm minor, 5 mm major. Cell size is
               driven by the same calibration value that sizes the ring circle,
               so counting squares gives the real measurement rather than a
               decorative one. -->
          <div class="ring-grid absolute inset-0 pointer-events-none" aria-hidden="true"></div>

          <!-- Outer dashed guide circle with crosshair ticks -->
          <div class="absolute inset-3 rounded-full border border-dashed border-border-strong/70 pointer-events-none"></div>

          <!-- Crosshair tick marks -->
          <div class="absolute left-1 top-1/2 -translate-y-1/2 w-4 h-px bg-border-strong"></div>
          <div class="absolute right-1 top-1/2 -translate-y-1/2 w-4 h-px bg-border-strong"></div>
          <div class="absolute top-1 left-1/2 -translate-x-1/2 h-4 w-px bg-border-strong"></div>
          <div class="absolute bottom-1 left-1/2 -translate-x-1/2 h-4 w-px bg-border-strong"></div>

          <!-- Center Crosshair tick indicator -->
          <div class="absolute left-3 top-1/2 -translate-y-1/2 h-2 w-px bg-border-strong"></div>
          <div class="absolute right-3 top-1/2 -translate-y-1/2 h-2 w-px bg-border-strong"></div>

          <!-- Scalable Golden Ring Circle -->
          <div
            data-ring-circle
            class="ring-circle rounded-full border-accent transition-all duration-75"
            style="width:62.4px;height:62.4px"
          ></div>

          <!-- Scale legend: proves the grid is real rather than decorative -->
          <div class="absolute bottom-2 left-2 flex items-center gap-2">
            <div class="ring-scale-bar h-1.5 border-x border-b border-border-strong"></div>
            <span class="text-xs text-text-faint">10 mm</span>
          </div>
        </div>

        <!-- Big Readout Underneath -->
        <div class="mt-4 text-center">
          <div class="font-display text-3xl sm:text-4xl font-semibold tracking-tight text-accent">
            <span data-readout data-main-val>{initValue}</span> <span data-main-unit class="text-2xl font-normal text-text-muted">{spec.unitLabel}</span>
          </div>
          <p data-main-label class="mt-1 text-xs uppercase tracking-wider text-text-faint font-medium">
            {spec.label}
          </p>
        </div>
      </div>

      <!-- Right Column: Slider with Step Buttons & 2x2 Country Size Grid -->
      <div class="flex flex-col justify-center">
        <!-- Slider Control Area -->
        <div class="mb-8">
          <div class="flex items-center justify-between text-xs font-mono text-text-muted mb-2 font-medium">
            <span data-min-label>{`${initMin} ${spec.unitLabel}`}</span>
            <span data-max-label>{`${initMax} ${spec.unitLabel}`}</span>
          </div>

          <div class="flex items-center gap-3">
            <button
              type="button"
              data-step-btn="minus"
              class="flex h-8 w-8 cursor-pointer items-center justify-center rounded-lg border border-border bg-surface-sunk text-text-muted hover:border-accent hover:text-text active:scale-95 transition-all text-base font-bold select-none"
              title="Decrease size"
            >
              −
            </button>

            <div class="relative flex-1">
              <input
                id="ring-range"
                data-ring-range
                type="range"
                min={initMin}
                max={initMax}
                step={spec.step}
                value={initValue}
                class="h-2 w-full cursor-pointer appearance-none rounded-full bg-border-strong/40 accent-[#D4AF37] focus:outline-none"
              />
            </div>

            <label class="sr-only" for="ring-num">Exact value, type a number you already measured</label>
            <input
              id="ring-num" data-ring-num type="number" inputmode="decimal"
              class="h-9 w-20 shrink-0 rounded-lg border border-border bg-surface px-2 text-right text-sm text-text"
            />

            <button
              type="button"
              data-step-btn="plus"
              class="flex h-8 w-8 cursor-pointer items-center justify-center rounded-lg border border-border bg-surface-sunk text-text-muted hover:border-accent hover:text-text active:scale-95 transition-all text-base font-bold select-none"
              title="Increase size"
            >
              +
            </button>
          </div>
        </div>

        <!-- 2x2 Country Size Grid Cards -->
        <div>
          <p class="text-xs font-semibold uppercase tracking-wider text-text-faint mb-2">Your Size Is</p>
          <div class="grid grid-cols-2 gap-3 sm:gap-4">
            <!-- US & Canada -->
            <div class="rounded-xl border border-border bg-surface-sunk/40 p-4 sm:p-5 text-center transition-all hover:border-accent/40 hover:shadow-xs">
              <dt class="text-xs font-medium text-text-muted">US / CA</dt>
              <dd data-readout data-out-us class="mt-2 font-display text-2xl sm:text-3xl font-semibold text-text">{dash(d.us)}</dd>
            </div>

            <!-- UK & Australia -->
            <div class="rounded-xl border border-border bg-surface-sunk/40 p-4 sm:p-5 text-center transition-all hover:border-accent/40 hover:shadow-xs">
              <dt class="text-xs font-medium text-text-muted">UK / AU</dt>
              <dd data-out-uk class="mt-2 font-display text-2xl sm:text-3xl font-semibold text-text">{dash(d.uk)}</dd>
            </div>

            <!-- Europe -->
            <div class="rounded-xl border border-border bg-surface-sunk/40 p-4 sm:p-5 text-center transition-all hover:border-accent/40 hover:shadow-xs">
              <dt class="text-xs font-medium text-text-muted">EU / ISO</dt>
              <dd data-readout data-out-eu class="mt-2 font-display text-2xl sm:text-3xl font-semibold text-text">{dash(d.eu)}</dd>
            </div>

            <!-- Japan -->
            <div class="rounded-xl border border-border bg-surface-sunk/40 p-4 sm:p-5 text-center transition-all hover:border-accent/40 hover:shadow-xs">
              <dt class="text-xs font-medium text-text-muted">Japan (JP)</dt>
              <dd data-readout data-out-jp class="mt-2 font-display text-2xl sm:text-3xl font-semibold text-text">{dash(d.jp)}</dd>
            </div>
          </div>
        </div>

        <!-- The two systems we are least certain about are the two the tool
             prints with no qualification, which is the one thing the site says
             competitors get wrong. UK_NOTE and INDIA_NOTE come from the data
             module so the caveat can never drift from the maths it describes. -->
        <details class="mt-4 rounded-xl border border-border bg-surface-sunk/30 px-4 py-3 text-xs">
          <summary class="flex min-h-11 cursor-pointer items-center font-medium text-text-muted marker:text-text-faint">
            Why UK and India can differ from your jeweller&rsquo;s chart
          </summary>
          <p class="mt-2.5 text-text-faint leading-relaxed">{UK_NOTE}</p>
          <p class="mt-2 text-text-faint leading-relaxed">{INDIA_NOTE}</p>
        </details>

        <!-- Action Row: Show Size Chart & Calibration -->
        <div class="mt-5 flex flex-wrap items-center justify-between gap-3 border-t border-border/60 pt-4 text-xs">
          <a
            href="#chart"
            class="inline-flex items-center gap-1.5 font-semibold text-accent-text hover:opacity-80 transition-opacity underline underline-offset-2"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path d="M3 3h18v18H3z"></path>
              <path d="M3 9h18M3 15h18M9 3v18M15 3v18"></path>
            </svg>
            Show Size Chart ↓
          </a>

          <div class="flex items-center gap-3 text-text-faint">
            <span>India: <strong data-readout data-out-in class="font-semibold text-text font-mono">{dash(d.in)}</strong></span>
            <span>FR/IT/ES: <strong data-readout data-out-fr class="font-semibold text-text font-mono">{dash(d.fr)}</strong></span>
            <button data-recal type="button" class="cursor-pointer text-accent-text underline underline-offset-2 hover:opacity-80 font-medium">
              Calibrate
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Hidden data points for schema and accessibility -->
    <div class="sr-only">
      <span data-readout data-cal-status>{DEFAULT_PPM.toFixed(2)}</span>
      <span data-readout data-out-dia-mm>{`${d.diameterMm.toFixed(2)} mm`}</span>
      <span data-readout data-out-dia-in>{`${d.diameterIn.toFixed(3)} in`}</span>
      <span data-readout data-out-circ-mm>{`${d.circumferenceMm.toFixed(2)} mm`}</span>
      <span data-readout data-out-circ-in>{`${d.circumferenceIn.toFixed(3)} in`}</span>
      <p data-live aria-live="polite"></p>
    </div>
  </div>
</section>

<style>
  /* --mm is the calibrated CSS pixels per millimetre. The default matches the
   * script's uncalibrated 96 DPI assumption; the calibration control overwrites
   * it on the stage element so the grid, the ring and the readout can never
   * disagree about what a millimetre is. */
  .ring-stage {
    --mm: 3.78px;
  }

  .ring-grid {
    background-image:
      linear-gradient(to right,  var(--border-strong) 0 1px, transparent 1px),
      linear-gradient(to bottom, var(--border-strong) 0 1px, transparent 1px),
      linear-gradient(to right,  var(--border) 0 1px, transparent 1px),
      linear-gradient(to bottom, var(--border) 0 1px, transparent 1px);
    background-size:
      calc(var(--mm) * 5) 100%,
      100% calc(var(--mm) * 5),
      var(--mm) 100%,
      100% var(--mm);
    /* 50% 50% puts a major line exactly on the centre, aligning the grid with
     * the crosshair ticks and the ring circle. */
    background-position: 50% 50%;
    /* 1 mm lines are dense enough that full-strength borders read as a solid
     * wash, especially in light mode. Fade the whole layer instead of picking
     * new colours so the grid stays behind the ring, not next to it. */
    opacity: 0.5;
  }

  .ring-scale-bar {
    width: calc(var(--mm) * 10);
  }

  .ring-circle {
    border-width: 3px;
  }

  /* Custom stylish slider thumb */
  input[type="range"]::-webkit-slider-thumb {
    appearance: none;
    height: 22px;
    width: 22px;
    border-radius: 50%;
    background: #D4AF37;
    cursor: grab;
    box-shadow: 0 1px 5px rgba(0,0,0,0.3);
    transition: transform 0.1s ease, box-shadow 0.1s ease;
  }
  input[type="range"]:active::-webkit-slider-thumb {
    cursor: grabbing;
    transform: scale(1.15);
  }
  input[type="range"]::-webkit-slider-thumb:hover {
    transform: scale(1.1);
    box-shadow: 0 2px 8px rgba(212,175,55,0.45);
  }
  input[type="range"]::-moz-range-thumb {
    height: 22px;
    width: 22px;
    border-radius: 50%;
    background: #D4AF37;
    cursor: pointer;
    border: none;
    box-shadow: 0 1px 5px rgba(0,0,0,0.3);
  }
</style>

<script>
  import { fromDiameter, diameterFromUs } from '../data/ringSizes';
  import {
    modeSpec, toMode, toDia, ceilTo, floorTo, modeFromParams,
    DIA_MIN_MM, DIA_MAX_MM,
    type Measure, type Unit,
  } from '../data/ringModes';
  import { PILL_ON, PILL_OFF } from './pillClasses';

  const root = document.querySelector<HTMLElement>('.ring-sizer');
  if (root) {
    const $ = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel)!;

    const CARD_SHORT_MM = 53.98;   // ISO/IEC 7810 ID-1, held upright
    const STORE = 'rst.pxPerMm';
    const PPM_MIN = 2.5;
    const PPM_MAX = 7;
    const stepCal = $('[data-step="calibrate"]');
    const card = $<HTMLElement>('[data-card]');
    const calRange = $<HTMLInputElement>('[data-cal-range]');
    const calVal = $('[data-cal-val]');
    const calNum = $<HTMLInputElement>('[data-cal-num]');
    const ringRange = $<HTMLInputElement>('[data-ring-range]');
    const ringNum = $<HTMLInputElement>('[data-ring-num]');
    const live = $('[data-live]');
    const ringCircle = $<HTMLElement>('[data-ring-circle]');
    const ringStage = $<HTMLElement>('[data-ring-stage]');
    const mainVal = $('[data-main-val]');
    const mainUnit = $('[data-main-unit]');
    const mainLabel = $('[data-main-label]');
    const minLabel = $('[data-min-label]');
    const maxLabel = $('[data-max-label]');
    
    const measureButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-measure-btn]')];
    const unitButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-unit-btn]')];



    const btnMinus = $<HTMLButtonElement>('[data-step-btn="minus"]');
    const btnPlus = $<HTMLButtonElement>('[data-step-btn="plus"]');

    /* The diameter range no longer comes off the range input: that input now
     * carries whatever unit the visitor is looking at, so in inches its `min`
     * is 0.433, not 11. Both bounds come from the same module the markup used. */
    const DIA_MIN = DIA_MIN_MM;
    const DIA_MAX = DIA_MAX_MM;

    /* Both defaults are read from the DOM / data module rather than retyped, so
     * the server-rendered markup and the hydrated state cannot disagree. The
     * URL wins over the page's own default, so /ring-size-in-inches?unit=mm
     * shows millimetres and a shared link reopens the view it was copied from. */
    let pxPerMm = parseFloat($('[data-cal-status]').textContent ?? '3.78');
    const fallbackMode = {
      measure: (root.dataset.initMeasure ?? 'dia') as Measure,
      unit: (root.dataset.initUnit ?? 'mm') as Unit,
    };
    let { measure: activeMeasure, unit: activeUnit } =
      modeFromParams(new URLSearchParams(location.search), fallbackMode);
    let currentDia = diameterFromUs(6);       // US 6 - the women's average

    /** The spec for whatever the tool is currently showing. */
    const bounds = () => modeSpec(activeMeasure, activeUnit);

    /* The typed field is allowed to be one decimal finer than the slider: a
     * person reading "16.51" off a caliper should be able to type it even
     * where the slider snaps to 0.05. */
    const numStep = (dp: number) => (10 ** -dp).toFixed(dp);

    const store = {
      get(): number | null {
        try {
          const v = parseFloat(localStorage.getItem(STORE) ?? '');
          return Number.isFinite(v) && v >= PPM_MIN && v <= PPM_MAX ? v : null;
        } catch { return null; }
      },
      set(v: number) { try { localStorage.setItem(STORE, String(v)); } catch { /* blocked */ } },
    };

    /* ── calibration controls ── */
    function setPxPerMm(v: number, syncNum = true) {
      pxPerMm = Math.min(PPM_MAX, Math.max(PPM_MIN, v));
      card.style.width = `${CARD_SHORT_MM * pxPerMm}px`;
      /* The graph paper and its 10 mm legend are sized off this one variable,
       * so a recalibration moves them with the ring instead of leaving a grid
       * that looks precise while measuring nothing. */
      ringStage.style.setProperty('--mm', `${pxPerMm}px`);
      const s = pxPerMm.toFixed(2);
      if (calRange.value !== s) calRange.value = s;
      /* Not while the visitor is typing into this very field: clamping writes
       * the bound back on every keystroke, so someone reaching for 2.9 saw
       * their "2" become "2.50" under the cursor. The ring field already
       * follows this rule; this one did not. It is resynced on commit. */
      if (syncNum && calNum.value !== s) calNum.value = s;
      if (calVal) calVal.textContent = s;
      $('[data-cal-status]').textContent = s;
      updateDisplay();
    }

    calRange.addEventListener('input', () => setPxPerMm(parseFloat(calRange.value)));
    calNum.addEventListener('input', () => {
      const v = parseFloat(calNum.value);
      if (Number.isFinite(v)) setPxPerMm(v, false);
    });
    /* Commit (blur or Enter): the field can never be left showing a number the
     * tool is not actually using, including an empty or junk entry. */
    calNum.addEventListener('change', () => {
      const v = parseFloat(calNum.value);
      setPxPerMm(Number.isFinite(v) ? v : pxPerMm);
    });

    $('[data-cal-save]').addEventListener('click', () => {
      store.set(pxPerMm);
      stepCal.hidden = true;
    });

    $('[data-cal-close]').addEventListener('click', () => {
      stepCal.hidden = true;
    });

    $('[data-cal-reset]').addEventListener('click', () => {
      setPxPerMm(3.78);
      store.set(3.78);
    });

    $('[data-recal]').addEventListener('click', () => {
      stepCal.hidden = !stepCal.hidden;
      if (!stepCal.hidden) {
        stepCal.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    });

    /* ── Switch modes: (diameter | circumference) × (mm | cm | in) ── */
    function setMode(m: Measure, u: Unit, pushUrl = true) {
      activeMeasure = m;
      activeUnit = u;

      const paint = (btns: HTMLButtonElement[], attr: string, active: string) => {
        btns.forEach((btn) => {
          const on = btn.dataset[attr] === active;
          btn.className = on ? PILL_ON : PILL_OFF;
          btn.setAttribute('aria-checked', String(on));
        });
      };
      paint(measureButtons, 'measureBtn', m);
      paint(unitButtons, 'unitBtn', u);

      /* The view lives in the URL so it can be shared, bookmarked and linked
       * to from the pages that exist to answer one of these questions.
       * replaceState, not pushState: flipping a unit is not a navigation, and
       * filling the back button with unit changes would trap the visitor. */
      if (pushUrl) {
        const url = new URL(location.href);
        url.searchParams.set('measure', m === 'circ' ? 'circumference' : 'diameter');
        url.searchParams.set('unit', u === 'in' ? 'inches' : u);
        history.replaceState(null, '', url);
      }

      const b = bounds();
      mainLabel.textContent = b.label;
      mainUnit.textContent = b.unitLabel;
      minLabel.textContent = `${ceilTo(b.min, b.dp)} ${b.unitLabel}`;
      maxLabel.textContent = `${floorTo(b.max, b.dp)} ${b.unitLabel}`;
      /* Bounds are rounded INWARD to the mode's own decimal grid. Using the
       * exact converted bound instead (DIA_MIN in inches is 0.4330708...)
       * offsets the whole step grid by an irrational amount, and the slider
       * starts reporting values like "0.648070866141732". A clean grid costs
       * at most one step of reach at each end, which is 0.005 in - far less
       * than the precision anyone can achieve holding a ring against glass. */
      ringRange.min = ceilTo(b.min, b.dp);
      ringRange.max = floorTo(b.max, b.dp);
      ringRange.step = b.step;
      /* The exact value, to this mode's precision. The browser will snap the
       * slider's own `value` to the nearest step - in circumference mode a
       * 0.05 mm step turns 51.87 into 51.86 - so the THUMB can sit up to half
       * a step off. That is deliberate and invisible: the slider carries no
       * number of its own, while the field and the big readout below both show
       * the exact figure.
       *
       * The alternative - adopting whatever the slider snapped to as the new
       * truth - keeps the thumb honest but makes switching units MUTATE the
       * measurement. Cycling mm -> cm -> in -> circ -> mm drifted 16.51 to
       * 16.49, enough to flip the Japanese size from 12 to 11 without the
       * visitor touching the slider. Losing the measurement is worse than a
       * thumb that is a fraction of a step out. */
      const exact = toMode(currentDia, m, u).toFixed(b.dp);
      ringRange.value = exact;

      ringNum.min = ringRange.min;
      ringNum.max = ringRange.max;
      ringNum.step = numStep(b.dp);
      ringNum.value = exact;          // exact, NOT ringRange.value post-snap

      updateDisplay();
    }

    measureButtons.forEach((btn) => {
      btn.addEventListener('click', () => setMode(btn.dataset.measureBtn as Measure, activeUnit));
    });
    unitButtons.forEach((btn) => {
      btn.addEventListener('click', () => setMode(activeMeasure, btn.dataset.unitBtn as Unit));
    });

    /* ── slider & step buttons handlers ── */
    function handleValueChange(val: number) {
      currentDia = Math.min(DIA_MAX, Math.max(DIA_MIN, toDia(val, activeMeasure, activeUnit)));

      /* If the request was out of range we just clamped it, so the number field
       * and the slider are now showing something that is not what the tool is
       * actually using. Type "5" in mm mode and the field kept saying 5 while
       * the readout said 11.00. Write the clamped value back to both.
       *
       * Only on a genuine clamp: rewriting mid-drag or mid-keystroke would
       * fight the user's cursor. */
      const b = bounds();
      const clamped = toMode(currentDia, activeMeasure, activeUnit);
      if (Math.abs(clamped - val) > 10 ** -(b.dp + 1)) {
        const s = clamped.toFixed(b.dp);
        ringRange.value = s;
        ringNum.value = s;
      }

      updateDisplay();
    }

    ringRange.addEventListener('input', () => {
      // toFixed, not the raw string: the slider hands back "22.2" where the
      // readout beside it says "22.20".
      const v = parseFloat(ringRange.value);
      ringNum.value = Number.isFinite(v) ? v.toFixed(bounds().dp) : ringRange.value;
      handleValueChange(v);
    });
    ringNum.addEventListener('input', () => {
      const v = parseFloat(ringNum.value);
      if (!Number.isFinite(v)) return;
      ringRange.value = ringNum.value;
      handleValueChange(v);
    });

    /* The value a ± click starts from is derived from `currentDia`, NOT read
     * back off ringRange.value. The slider snaps to its own step grid, so
     * reading it back quantises the measurement on every click — exactly the
     * mutation setMode() goes out of its way to avoid. In inches the grid is
     * 0.434 + 0.005k, so one + followed by one − moved 16.51 mm to 16.48 and
     * flipped the Japanese size from 12 to 11 without the visitor changing
     * anything. Both ends are clamped to the mode's own rounded-inward bounds. */
    function nudge(dir: 1 | -1) {
      const b = bounds();
      const current = toMode(currentDia, activeMeasure, activeUnit);
      const next = Math.min(
        parseFloat(ringRange.max),
        Math.max(parseFloat(ringRange.min), current + dir * b.nudge),
      );
      const s = next.toFixed(b.dp);
      ringRange.value = s;
      ringNum.value = s;
      /* parseFloat(s), not `next`: the field and the state must agree on the
       * same rounded figure, or the next click starts from a value nothing
       * on screen is showing. */
      handleValueChange(parseFloat(s));
    }

    btnMinus.addEventListener('click', () => nudge(-1));
    btnPlus.addEventListener('click', () => nudge(1));

    const dash = (v: string | number | null) => (v === null ? '—' : String(v));

    /* ── update all visuals & country size cards ── */
    function updateDisplay() {
      const d = Math.min(DIA_MAX, Math.max(DIA_MIN, currentDia));
      
      // Update dynamic golden ring scale
      const px = d * pxPerMm;
      ringCircle.style.width = `${px}px`;
      ringCircle.style.height = `${px}px`;

      /* Readout precision matches the mode's step. Inches used to render at
       * 2 dp against a 0.001 in step, so 0.01 in = 0.254 mm was the smallest
       * visible change - coarser than a US quarter size (0.2032 mm), and two
       * clicks of the step button appeared to do nothing. */
      const bd = bounds();
      mainVal.textContent = toMode(d, activeMeasure, activeUnit).toFixed(bd.dp);

      // Convert diameter to official standards
      const r = fromDiameter(d);
      const set = (sel: string, v: string) => { 
        const el = root.querySelector(sel);
        if (el) el.textContent = v;
      };

      set('[data-out-us]', dash(r.us));
      set('[data-out-uk]', dash(r.uk));
      set('[data-out-eu]', dash(r.eu));
      set('[data-out-jp]', dash(r.jp));
      set('[data-out-in]', dash(r.in));
      set('[data-out-fr]', dash(r.fr));
      set('[data-out-dia-mm]', `${r.diameterMm.toFixed(2)} mm`);
      set('[data-out-dia-in]', `${r.diameterIn.toFixed(3)} in`);
      set('[data-out-circ-mm]', `${r.circumferenceMm.toFixed(2)} mm`);
      set('[data-out-circ-in]', `${r.circumferenceIn.toFixed(3)} in`);

      // aria-live was present in markup but never written to — a screen reader
      // user got zero feedback as the slider moved. Throttled so dragging
      // doesn't spam an announcement on every pixel of travel.
      if (live) {
        window.clearTimeout(liveTimer);
        liveTimer = window.setTimeout(() => {
          live.textContent = `US size ${dash(r.us)}, ${r.diameterMm.toFixed(2)} millimetres`;
        }, 400);
      }
    }
    let liveTimer = 0;

    /* ── boot initialization ──
     * A first-time visitor (no saved calibration) MUST see the calibrate
     * card — the entire "accurate because you calibrate your own screen"
     * claim is silently false otherwise. Only collapse it when we actually
     * have a valid saved value, mirroring what [data-cal-save] does. */
    const saved = store.get();
    if (saved) {
      setPxPerMm(saved);
      stepCal.hidden = true;
    } else {
      setPxPerMm(pxPerMm);                   // the value read out of the DOM
      stepCal.hidden = false;
    }

    /* setMode() is what fills the paired number input and derives the slider's
     * bounds and end labels. Boot used to call only updateDisplay(), so the
     * number field sat EMPTY until the visitor touched something, and the
     * bounds were whatever the markup happened to say. Run it once for the
     * starting mode so every one of those comes from the mode table.
     *
     * pushUrl is false here: boot must not stamp ?measure=&unit= onto a clean
     * URL the visitor never chose, which would turn every shared link into a
     * parameterised one and give the canonical page a second address. */
    setMode(activeMeasure, activeUnit, false);
  }
</script>
