<script>
  import { fromDiameter, diameterFromUs } from '../data/ringSizes';
  import {
    modeSpec, toMode, toDia, ceilTo, floorTo, modeFromParams,
    sourceSpec, sourceFromMeasure,
    DIA_MIN_MM, DIA_MAX_MM,
    type Measure, type Unit, type Source,
  } from '../data/ringModes';
  import {
    PPM_MIN, PPM_MAX, DEFAULT_PX_PER_MM, PHONE_PX_PER_MM, PHONE_VIEWPORT_MAX_PX,
