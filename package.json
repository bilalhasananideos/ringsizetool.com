{
  "name": "ringsizetool",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "verify": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/verify-sizes.ts",
    "deploy": "astro build && wrangler pages deploy dist --project-name=ringsizetool",
    "sweep": "python3 scripts/sweep-astro-newline.py dist"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.7",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "esbuild": true
  }
}
